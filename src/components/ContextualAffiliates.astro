---
// src/components/ContextualAffiliates.astro
import { affiliateProducts } from '../data/affiliateData';

interface Props {
  currentWeek: number;
}

const { currentWeek } = Astro.props;
const product = affiliateProducts[currentWeek];
---

{product && (
  <div class="bg-canvas border border-hairline rounded-apple-lg p-5 md:p-6 shadow-[0px_4px_16px_rgba(0,0,0,0.03)] transition-all duration-300 hover:shadow-[0px_6px_24px_rgba(0,0,0,0.06)] flex flex-col md:flex-row gap-5 items-center w-full mt-8 select-none">
    
    <!-- Product Thumbnail -->
    <div class="w-full md:w-32 h-32 flex items-center justify-center bg-canvas-parchment rounded-apple-md border border-hairline overflow-hidden p-2 shrink-0">
      <!-- Simulated product image rendering (or fallback placeholders if asset links fail) -->
      <div class="text-4xl text-center select-none" aria-hidden="true">
        {currentWeek === 15 ? "🛌" : currentWeek === 20 ? "🧴" : currentWeek === 32 ? "🎒" : "👶"}
      </div>
    </div>

    <!-- Product Details -->
    <div class="flex-1 text-left flex flex-col gap-1 w-full">
      <div class="flex justify-between items-start flex-wrap gap-2">
        <span class="text-[10px] uppercase tracking-wider font-semibold text-primary/80 bg-primary/5 px-2 py-0.5 rounded border border-primary/10">
          Partner Recommendation
        </span>
        <span class="text-xs text-ink-muted-48 font-bold">{product.priceEstimate}</span>
      </div>
      <h3 class="font-display font-bold text-base md:text-lg text-ink mt-1 tracking-apple-tight">
        {product.productName}
      </h3>
      <p class="text-xs md:text-sm text-ink-muted-80 leading-relaxed tracking-apple-caption mt-1">
        {product.description}
      </p>
      
      <!-- Disclosure Legal footer -->
      <span class="text-[9px] text-ink-muted-48 italic leading-none mt-2 block">
        FTC Disclosure: As an Amazon Associate, we earn from qualifying purchases at no extra cost to you.
      </span>
    </div>

    <!-- CTA view button -->
    <a 
      href={product.amazonLink} 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-primary hover:bg-primary-focus text-white font-semibold text-xs md:text-sm px-5 py-3 rounded-apple-pill transition-all active:scale-95 text-center min-h-[44px] flex items-center justify-center shrink-0 w-full md:w-auto"
    >
      View on Amazon
    </a>
  </div>
)}
