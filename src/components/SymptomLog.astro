---
// SymptomLog.astro
---

<div class="symptom-log-card animate-fade-in">
  <div class="card-header">
    <h2>Weekly Symptom & Mood Journal</h2>
    <span class="week-pill" id="log-week-title">Week 1</span>
  </div>

  <!-- Form to log entry -->
  <form id="symptom-form" class="log-form">
    <!-- Mood Selector -->
    <div class="form-section">
      <label>How are you feeling?</label>
      <div class="mood-selector">
        <button type="button" class="mood-btn" data-mood="Grateful" title="Grateful" aria-label="Grateful">
          <span class="emoji">😊</span>
          <span class="mood-lbl">Grateful</span>
        </button>
        <button type="button" class="mood-btn" data-mood="Tired" title="Tired" aria-label="Tired">
          <span class="emoji">😴</span>
          <span class="mood-lbl">Tired</span>
        </button>
        <button type="button" class="mood-btn" data-mood="Nauseous" title="Nauseous" aria-label="Nauseous">
          <span class="emoji">🤢</span>
          <span class="mood-lbl">Nauseous</span>
        </button>
        <button type="button" class="mood-btn" data-mood="Excited" title="Excited" aria-label="Excited">
          <span class="emoji">🎉</span>
          <span class="mood-lbl">Excited</span>
        </button>
        <button type="button" class="mood-btn" data-mood="Anxious" title="Anxious" aria-label="Anxious">
          <span class="emoji">😟</span>
          <span class="mood-lbl">Anxious</span>
        </button>
        <button type="button" class="mood-btn" data-mood="Sore" title="Sore" aria-label="Sore">
          <span class="emoji">😣</span>
          <span class="mood-lbl">Sore</span>
        </button>
      </div>
    </div>

    <!-- Symptoms Checklist -->
    <div class="form-section">
      <label>Any symptoms today?</label>
      <div class="symptoms-grid">
        <button type="button" class="symptom-pill" data-symptom="Fatigue">Fatigue</button>
        <button type="button" class="symptom-pill" data-symptom="Nausea">Nausea</button>
        <button type="button" class="symptom-pill" data-symptom="Backache">Backache</button>
        <button type="button" class="symptom-pill" data-symptom="Cravings">Cravings</button>
        <button type="button" class="symptom-pill" data-symptom="Mood Swings">Mood Swings</button>
        <button type="button" class="symptom-pill" data-symptom="Swelling">Swelling</button>
        <button type="button" class="symptom-pill" data-symptom="Round Ligament Pain">Pelvic Pain</button>
        <button type="button" class="symptom-pill" data-symptom="Heartburn">Heartburn</button>
        <button type="button" class="symptom-pill" data-symptom="Insomnia">Insomnia</button>
        <button type="button" class="symptom-pill" data-symptom="Headache">Headache</button>
      </div>
    </div>

    <!-- Journal Note -->
    <div class="form-section">
      <label for="log-note">Journal Note / Doctor Questions</label>
      <textarea id="log-note" rows="3" placeholder="Write down milestones, baby kicks, doctor questions, or general thoughts..."></textarea>
    </div>

    <button type="submit" class="save-log-btn">Save Journal Entry</button>
  </form>

  <!-- History Timeline -->
  <div class="history-section">
    <h3>Journal History for this Week</h3>
    <div id="logs-timeline" class="logs-timeline">
      <!-- Logs inserted dynamically -->
      <div class="empty-timeline-state">
        <p>No entries logged for this week yet. Keep track of your pregnancy journey by adding your first entry above!</p>
      </div>
    </div>
  </div>
</div>

<style>
  .symptom-log-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: var(--glass-shadow);
    max-width: 960px;
    margin: 2rem auto;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .card-header h2 {
    font-size: 1.75rem;
    color: var(--color-text);
  }

  .week-pill {
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.4rem 1.25rem;
    border-radius: 99px;
  }

  .log-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-section label {
    font-weight: 600;
    color: var(--color-text);
    font-size: 1rem;
  }

  /* Moods */
  .mood-selector {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .mood-selector {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }
  }

  .mood-btn {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 0.75rem 0.5rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    transition: transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mood-btn:hover {
    transform: translateY(-2px);
    background: var(--bg-surface);
    border-color: var(--color-primary);
  }

  .mood-btn.selected {
    background: var(--bg-surface);
    border-color: var(--color-primary);
    box-shadow: 0 0 10px rgba(224, 122, 95, 0.15);
  }

  .mood-btn .emoji {
    font-size: 1.75rem;
  }

  .mood-lbl {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .mood-btn.selected .mood-lbl {
    color: var(--color-primary);
  }

  /* Symptoms Checklist */
  .symptoms-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .symptom-pill {
    background: var(--bg-surface-elevated);
    border: 1.5px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem 1.15rem;
    border-radius: 99px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .symptom-pill:hover {
    border-color: var(--color-primary);
    background: var(--bg-surface);
  }

  .symptom-pill.selected {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    box-shadow: 0 4px 10px rgba(224, 122, 95, 0.2);
  }

  /* Note Text Area */
  textarea {
    width: 100%;
    padding: 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background: var(--bg-surface);
    color: var(--color-text);
    outline: none;
    resize: vertical;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(224, 122, 95, 0.15);
  }

  .save-log-btn {
    background: var(--color-tertiary);
    color: white;
    border: none;
    padding: 1rem;
    border-radius: 12px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    box-shadow: 0 4px 14px rgba(129, 178, 154, 0.25);
  }

  .save-log-btn:hover {
    background: #6e9d85; /* Slightly darkened sage */
    transform: translateY(-1px);
  }

  .save-log-btn:active {
    transform: translateY(1px);
  }

  /* Timeline */
  .history-section {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .history-section h3 {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .logs-timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-timeline-state {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding: 2rem;
    background: var(--bg-surface-elevated);
    border-radius: 16px;
    border: 1px dashed var(--color-border);
  }

  .log-item {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    gap: 1.25rem;
    position: relative;
    animation: fadeIn var(--transition-fast) forwards;
  }

  .log-item-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    width: 60px;
    height: 60px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  .log-item-left .item-emoji {
    font-size: 1.75rem;
  }

  .log-item-left .item-mood-text {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .log-item-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .log-item-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .log-item-date {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .log-item-symptoms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .item-symptom-tag {
    background: rgba(224, 122, 95, 0.1);
    color: var(--color-primary);
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .log-item-note {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .delete-log-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .delete-log-btn:hover {
    color: #e07a5f;
    background: rgba(224, 122, 95, 0.1);
  }
</style>

<script>
  interface JournalEntry {
    id: string;
    week: number;
    date: string;
    mood: string;
    symptoms: string[];
    note: string;
  }

  let currentWeek = 1;
  let selectedMood = '';
  const selectedSymptoms: string[] = [];

  const logWeekTitle = document.getElementById('log-week-title');
  const moodButtons = document.querySelectorAll('.mood-btn');
  const symptomPills = document.querySelectorAll('.symptom-pill');
  const logNoteInput = document.getElementById('log-note') as HTMLTextAreaElement;
  const symptomForm = document.getElementById('symptom-form') as HTMLFormElement;
  const logsTimeline = document.getElementById('logs-timeline');

  // Initial load
  document.addEventListener('DOMContentLoaded', () => {
    // Load stored week
    const savedCalculation = localStorage.getItem('pregnancy_calc_v1');
    let startingWeek = 1;

    if (savedCalculation) {
      const data = JSON.parse(savedCalculation);
      const date = new Date(data.date);
      date.setHours(12, 0, 0, 0);
      const now = new Date();
      now.setHours(12, 0, 0, 0);
      
      let ageDays = 0;
      if (data.mode === 'lmp') {
        ageDays = Math.floor((now.getTime() - date.getTime()) / (24 * 60 * 60 * 1000));
      } else {
        ageDays = Math.floor((now.getTime() - date.getTime()) / (24 * 60 * 60 * 1000)) + 14;
      }
      
      if (ageDays < 0) ageDays = 0;
      const weeks = Math.floor(ageDays / 7);
      startingWeek = Math.max(1, Math.min(40, weeks + 1));
    } else {
      const savedBrowsedWeek = localStorage.getItem('browsed_week_v1');
      if (savedBrowsedWeek) {
        startingWeek = parseInt(savedBrowsedWeek, 10);
      }
    }

    setWeek(startingWeek);
  });

  // Listen for week selector changes
  document.addEventListener('week-selected', (e: any) => {
    if (e.detail && e.detail.week) {
      setWeek(e.detail.week);
    }
  });

  document.addEventListener('pregnancy-updated', (e: any) => {
    if (e.detail && e.detail.week) {
      setWeek(e.detail.week);
    }
  });

  document.addEventListener('pregnancy-reset', () => {
    setWeek(1);
  });

  function setWeek(week: number) {
    currentWeek = week;
    if (logWeekTitle) {
      logWeekTitle.textContent = `Week ${currentWeek}`;
    }
    
    // Clear selections on week switch
    resetFormSelections();
    
    // Render logs for this week
    renderLogs();
  }

  // Mood selector click handlers
  moodButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      moodButtons.forEach(b => b.classList.remove('selected'));
      
      const mood = btn.getAttribute('data-mood') || '';
      if (selectedMood === mood) {
        // Toggle off
        selectedMood = '';
      } else {
        selectedMood = mood;
        btn.classList.add('selected');
      }
    });
  });

  // Symptom pills click handlers
  symptomPills.forEach(pill => {
    pill.addEventListener('click', () => {
      const symptom = pill.getAttribute('data-symptom') || '';
      
      if (selectedSymptoms.includes(symptom)) {
        // Remove
        const idx = selectedSymptoms.indexOf(symptom);
        selectedSymptoms.splice(idx, 1);
        pill.classList.remove('selected');
      } else {
        // Add
        selectedSymptoms.push(symptom);
        pill.classList.add('selected');
      }
    });
  });

  function resetFormSelections() {
    selectedMood = '';
    selectedSymptoms.length = 0;
    moodButtons.forEach(btn => btn.classList.remove('selected'));
    symptomPills.forEach(pill => pill.classList.remove('selected'));
    if (logNoteInput) logNoteInput.value = '';
  }

  // Handle Form Submit
  symptomForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (!selectedMood && selectedSymptoms.length === 0 && !logNoteInput.value.trim()) {
      alert("Please select a mood, check a symptom, or write a note before saving.");
      return;
    }

    const newEntry: JournalEntry = {
      id: 'entry_' + Date.now(),
      week: currentWeek,
      date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
      mood: selectedMood,
      symptoms: [...selectedSymptoms],
      note: logNoteInput.value.trim()
    };

    // Load existing logs
    const existingLogs = getStoredLogs();
    existingLogs.unshift(newEntry); // Newest first
    saveStoredLogs(existingLogs);

    // Reset Form & Rerender
    resetFormSelections();
    renderLogs();
  });

  function getStoredLogs(): JournalEntry[] {
    const raw = localStorage.getItem('pregnancy_symptom_logs_v1');
    return raw ? JSON.parse(raw) : [];
  }

  function saveStoredLogs(logs: JournalEntry[]) {
    localStorage.setItem('pregnancy_symptom_logs_v1', JSON.stringify(logs));
  }

  // Mood Emoji Map
  const moodEmojiMap: Record<string, string> = {
    'Grateful': '😊',
    'Tired': '😴',
    'Nauseous': '🤢',
    'Excited': '🎉',
    'Anxious': '😟',
    'Sore': '😣'
  };

  function renderLogs() {
    if (!logsTimeline) return;
    
    const logs = getStoredLogs().filter(entry => entry.week === currentWeek);

    if (logs.length === 0) {
      logsTimeline.innerHTML = `
        <div class="empty-timeline-state">
          <p>No entries logged for Week ${currentWeek} yet. Keep track of your pregnancy journey by adding your first entry above!</p>
        </div>
      `;
      return;
    }

    logsTimeline.innerHTML = '';
    logs.forEach(log => {
      const moodEmoji = log.mood ? moodEmojiMap[log.mood] || '✨' : '📝';
      const moodText = log.mood || 'Journal';
      
      const logDiv = document.createElement('div');
      logDiv.className = 'log-item';
      
      let symptomsHTML = '';
      if (log.symptoms && log.symptoms.length > 0) {
        symptomsHTML = `
          <div class="log-item-symptoms">
            ${log.symptoms.map(s => `<span class="item-symptom-tag">${s}</span>`).join('')}
          </div>
        `;
      }

      let noteHTML = '';
      if (log.note) {
        noteHTML = `<p class="log-item-note">${log.note}</p>`;
      }

      logDiv.innerHTML = `
        <div class="log-item-left">
          <span class="item-emoji">${moodEmoji}</span>
          <span class="item-mood-text">${moodText}</span>
        </div>
        <div class="log-item-right">
          <div class="log-item-meta">
            <span class="log-item-date">${log.date}</span>
            <button class="delete-log-btn" data-id="${log.id}" aria-label="Delete entry">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            </button>
          </div>
          ${symptomsHTML}
          ${noteHTML}
        </div>
      `;

      // Set delete listener
      const delBtn = logDiv.querySelector('.delete-log-btn');
      delBtn?.addEventListener('click', () => {
        const entryId = delBtn.getAttribute('data-id');
        deleteLog(entryId);
      });

      logsTimeline.appendChild(logDiv);
    });
  }

  function deleteLog(id: string | null) {
    if (!id) return;
    if (confirm("Are you sure you want to delete this journal entry?")) {
      const logs = getStoredLogs();
      const updated = logs.filter(log => log.id !== id);
      saveStoredLogs(updated);
      renderLogs();
    }
  }
</script>
