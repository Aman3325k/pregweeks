---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Page Not Found | 404 Error | PregWeeks"
  description="The page you are looking for does not exist on PregWeeks.com."
>
  <main class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-16 text-center">
    <div class="space-y-6 max-w-md">
      <!-- 404 Header -->
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3.5 py-1 rounded-full">Error 404</span>
      
      <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
        Page Not Found
      </h1>
      
      <p class="text-sm text-neutral-500 leading-relaxed">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. 
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-3 pt-4">
        <a 
          href="/" 
          class="bg-[#0066cc] hover:bg-[#0055b3] text-white py-3 px-6 rounded-xl text-xs font-semibold tracking-wider uppercase transition-all active:scale-95 shadow-none"
        >
          Go Back Home
        </a>
        <a 
          href="/tools/due-date-calculator" 
          class="bg-neutral-100 hover:bg-neutral-200 text-neutral-800 py-3 px-6 rounded-xl text-xs font-semibold tracking-wider uppercase border border-neutral-200 transition-all active:scale-95"
        >
          Tools & Calculators
        </a>
      </div>
    </div>
  </main>
</Layout>
