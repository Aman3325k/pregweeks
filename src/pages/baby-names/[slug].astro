---
import Layout from '../../layouts/Layout.astro';
import { babyNames, type BabyName } from '../../data/namesData';
import enrichedNames from '../../data/namesEnrichedData.json';

export async function getStaticPaths() {
  return babyNames.map((name) => ({
    params: { slug: name.slug },
    props: { nameObj: name },
  }));
}

export interface Props {
  nameObj: BabyName;
}

const { nameObj } = Astro.props;
const { name, meaning, origin, gender, popularity, slug } = nameObj;

const enriched = (enrichedNames as Record<string, any>)[slug] || {};
const {
  etymology = '',
  pronunciation = '',
  popularityTrend = null,
  nicknames = [],
  relatedNames = [],
  siblingSuggestions = [],
  faqs = [],
  significance = ''
} = enriched;

interface FAQItem {
  q: string;
  a: string;
}

// Dynamic FAQs (use enriched FAQs if present)
const activeFaqs: FAQItem[] = faqs.length > 0 ? (faqs as FAQItem[]) : [
  {
    q: `What does the baby name ${name} mean?`,
    a: `The baby name ${name} primarily means "${meaning}". It carries a positive, deep significance that reflects these attributes.`
  },
  {
    q: `What is the origin of the name ${name}?`,
    a: `The name ${name} has its roots in ${origin} history and culture. Over time, it has evolved into a beloved name used globally.`
  },
  {
    q: `Is ${name} a boy name, girl name, or gender-neutral?`,
    a: `${name} is categorized as a ${gender} name. It is traditionally chosen for ${gender === 'neutral' ? 'both boys and girls' : gender + 's'} by parents worldwide.`
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://pregweeks.com/baby-names/${slug}/#webpage`,
      "url": `https://pregweeks.com/baby-names/${slug}/`,
      "name": `${name} Name Meaning, Origin, Pronunciation & Nicknames | PregWeeks`,
      "description": `Discover the meaning, origin, pronunciation guide, nicknames, related names, and sibling pairing suggestions for the baby name ${name} on PregWeeks.`
    },
    {
      "@type": "FAQPage",
      "@id": `https://pregweeks.com/baby-names/${slug}/#faq`,
      "mainEntity": activeFaqs.map((faq: FAQItem) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://pregweeks.com/baby-names/${slug}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://pregweeks.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Baby Names",
          "item": "https://pregweeks.com/baby-names/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": name,
          "item": `https://pregweeks.com/baby-names/${slug}/`
        }
      ]
    }
  ]
};

let genderColor = 'bg-neutral-100 text-neutral-600 border-neutral-200';
if (gender === 'boy') {
  genderColor = 'bg-blue-50 text-blue-700 border-blue-100';
} else if (gender === 'girl') {
  genderColor = 'bg-pink-50 text-pink-700 border-pink-100';
} else if (gender === 'neutral') {
  genderColor = 'bg-purple-50 text-purple-700 border-purple-100';
}
---

<Layout 
  title={`${name} Name Meaning, Origin, Pronunciation & Nicknames | PregWeeks`}
  description={`Discover the meaning, origin, pronunciation, nicknames, related names, and sibling pairing suggestions for the baby name ${name} on PregWeeks.`}
  canonicalUrl={`https://pregweeks.com/baby-names/${slug}/`}
>
  <!-- Inject Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <a href="/baby-names/" class="hover:text-[#0066cc] transition-colors">Baby Names</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">{name}</span>
    </nav>

    <!-- Main Card Container -->
    <article class="bg-white border border-neutral-200 rounded-2xl p-6 sm:p-10 mb-8 shadow-sm">
      <!-- Title & Badges -->
      <div class="border-b border-neutral-100 pb-6 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-neutral-900 mb-2">
              {name}
            </h1>
            <p class="text-sm font-medium text-neutral-500 uppercase tracking-widest">
              {origin} Origin Name
            </p>
          </div>
          <div class="flex items-center space-x-3">
            <span class={`text-xs font-semibold uppercase tracking-wider px-3.5 py-1 rounded-full border ${genderColor}`}>
              {gender}
            </span>
            {popularity > 0 && (
              <span class="text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-100 px-3.5 py-1 rounded-full">
                Popularity #{popularity}
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="space-y-8">
        <!-- Pronunciation Section (phonetic spelling) -->
        {pronunciation && (
          <section class="bg-neutral-50 border border-neutral-100 rounded-xl p-5">
            <h2 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Pronunciation Guide</h2>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-lg font-bold text-neutral-900">{name}</span>
              <span class="text-neutral-500 text-sm">is phonetically pronounced as:</span>
              <span class="inline-block bg-white border border-neutral-200 text-neutral-800 text-sm font-mono px-3 py-1 rounded-lg">
                {pronunciation}
              </span>
            </div>
          </section>
        )}

        <!-- Meaning & Etymology -->
        <section>
          <h2 class="text-lg font-semibold text-neutral-900 mb-2">Name Meaning & Etymology</h2>
          <p class="text-base text-neutral-700 leading-relaxed">
            {etymology}
          </p>
        </section>

        <!-- Popularity Trend (Omitted if no real popularity data) -->
        {popularityTrend && (
          <section>
            <h2 class="text-lg font-semibold text-neutral-900 mb-2">Popularity Trend</h2>
            <p class="text-base text-neutral-700 leading-relaxed">
              {popularityTrend}
            </p>
          </section>
        )}

        <!-- Linguistic & Cultural Significance -->
        {significance && (
          <section>
            <h2 class="text-lg font-semibold text-neutral-900 mb-2">Linguistic & Cultural Significance</h2>
            <p class="text-base text-neutral-700 leading-relaxed">
              {significance}
            </p>
          </section>
        )}

        <!-- Common Nicknames & Variants -->
        {nicknames.length > 0 && (
          <section>
            <h2 class="text-lg font-semibold text-neutral-900 mb-3">Common Nicknames & Variations</h2>
            <div class="flex flex-wrap gap-2">
              {nicknames.map((nickname: string) => (
                <span class="inline-block bg-neutral-100 text-neutral-800 text-xs font-medium px-3.5 py-1.5 rounded-full border border-neutral-200">
                  {nickname}
                </span>
              ))}
            </div>
          </section>
        )}

        <!-- Sibling Name Pairing Suggestions -->
        {siblingSuggestions.length > 0 && (
          <section>
            <h2 class="text-lg font-semibold text-neutral-900 mb-2">Sibling Name Pairing Suggestions</h2>
            <p class="text-base text-neutral-700 leading-relaxed mb-4">
              If you are pairing a name with {name} for a future brother or sister, these options share compatible stylistic rhythms and cultural origins:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {siblingSuggestions.map((sib: string) => {
                // Find matching baby name slug if available to link internally
                const matched = babyNames.find(n => n.name.toLowerCase() === sib.toLowerCase());
                return (
                  <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 flex justify-between items-center">
                    <div>
                      <span class="block text-sm font-semibold text-neutral-900">{sib}</span>
                      <span class="block text-[10px] text-neutral-500 uppercase font-medium">{origin} Sibling</span>
                    </div>
                    {matched ? (
                      <a 
                        href={`/baby-names/${matched.slug}/`} 
                        class="text-[#0066cc] text-xs font-semibold hover:underline"
                      >
                        View Name →
                      </a>
                    ) : (
                      <span class="text-neutral-400 text-xs font-medium">Compatible Style</span>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        )}
      </div>
    </article>

    <!-- Side-by-Side FAQs and Similar Names -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- FAQs -->
      <section class="md:col-span-2 space-y-6">
        <h2 class="text-xl font-semibold text-neutral-900">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {activeFaqs.map((faq: FAQItem) => (
            <div class="bg-neutral-50 rounded-xl p-5 border border-neutral-200">
              <h3 class="text-sm font-semibold text-neutral-900 mb-1.5">{faq.q}</h3>
              <p class="text-xs text-neutral-600 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related Names -->
      <section class="md:col-span-1 space-y-4">
        <h2 class="text-xl font-semibold text-neutral-900">Related Names</h2>
        <div class="space-y-3">
          {relatedNames.length > 0 ? (
            relatedNames.map((similar: any) => (
              <a 
                href={`/baby-names/${similar.slug}/`}
                class="block bg-white hover:bg-neutral-50 border border-neutral-200 rounded-xl p-4 transition-all active:scale-[0.98] shadow-sm animate-press"
              >
                <div class="flex justify-between items-center mb-1">
                  <span class="text-sm font-semibold text-neutral-900">{similar.name}</span>
                  <span class="text-[10px] text-neutral-500 uppercase font-medium">{origin}</span>
                </div>
                <p class="text-xs text-[#0066cc] font-medium">View details and meanings →</p>
              </a>
            ))
          ) : (
            <div class="text-xs text-neutral-500 italic py-4">
              No similar names found in this category.
            </div>
          )}
        </div>
      </section>
    </div>

    <!-- Back to directory button -->
    <div class="text-center">
      <a 
        href="/baby-names/" 
        class="inline-block bg-neutral-100 hover:bg-neutral-200 text-neutral-800 text-xs font-semibold py-3 px-6 rounded-xl border border-neutral-200 transition-all active:scale-95"
      >
        ← Back to Baby Names Directory
      </a>
    </div>
  </main>
</Layout>
