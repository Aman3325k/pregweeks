---
import Layout from '../../layouts/Layout.astro';
import { pregnancyConditions } from '../../data/conditionsData';
---

<Layout 
  title="Pregnancy Conditions & Complications Directory | PregWeeks"
  description="Learn about common pregnancy conditions, symptoms, and treatments. In-depth clinical guides on gestational diabetes, preeclampsia, placenta previa, and more."
>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Conditions</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Clinical Library</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-4 sm:text-4xl">
        Pregnancy Conditions Guides
      </h1>
      <p class="text-base text-neutral-500 leading-relaxed">
        Understand common medical complications and conditions that can arise during pregnancy. Learn about clinical symptoms, management procedures, and when to contact your obstetrician.
      </p>
    </header>

    <!-- Grid List of Conditions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      {pregnancyConditions.map(cond => (
        <a 
          href={`/conditions/${cond.slug}`}
          class="bg-white border border-neutral-200 rounded-2xl p-6 hover:border-neutral-300 transition-all active:scale-[0.99] flex flex-col justify-between"
        >
          <div>
            <span class="text-[9px] uppercase font-bold tracking-wider text-neutral-400">Pregnancy Condition</span>
            <h2 class="text-lg font-bold text-neutral-900 mt-1 mb-3">{cond.name}</h2>
            <p class="text-xs text-neutral-600 leading-relaxed line-clamp-3 mb-6">
              {cond.definition}
            </p>
          </div>
          <span class="text-xs font-semibold text-[#0066cc] hover:underline flex items-center space-x-1">
            <span>Read Clinical Guide</span>
            <span>→</span>
          </span>
        </a>
      ))}
    </div>

    <!-- General Medical Disclaimer -->
    <div class="bg-amber-50/50 border border-amber-200 rounded-xl p-5 text-xs text-amber-800 leading-relaxed">
      <strong>Important Medical Notice:</strong> The information in this directory is for educational and general tracking purposes only and is not a substitute for clinical diagnostics or professional medical assessments. Always consult your obstetrician or midwifery team if you experience unexpected or severe symptoms.
    </div>
  </main>
</Layout>
