---
import Layout from '../../layouts/Layout.astro';
import { pregnancyConditions, type Condition } from '../../data/conditionsData';

export async function getStaticPaths() {
  return pregnancyConditions.map((cond) => ({
    params: { condition: cond.slug },
    props: { conditionObj: cond },
  }));
}

interface Props {
  conditionObj: Condition;
}

const { conditionObj } = Astro.props;
const { name, slug, definition, symptoms, risks, treatment, whenToCall, faqs } = conditionObj;

// TOC links
const tocLinks = [
  { id: "overview", name: "Overview" },
  { id: "symptoms", name: "Symptoms" },
  { id: "risks", name: "Maternal & Fetal Risks" },
  { id: "treatment", name: "Treatment & Management" },
  { id: "when-to-call", name: "When to Call Doctor" },
  { id: "faqs", name: "FAQs" }
];

// JSON-LD Schemas
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": `https://pregweeks.com/conditions/${slug}/#webpage`,
      "url": `https://pregweeks.com/conditions/${slug}`,
      "name": `${name} in Pregnancy: Symptoms, Risks & Treatment | PregWeeks`,
      "description": `${definition.slice(0, 150)}... Learn symptoms, maternal/fetal risks, treatments, and doctor indicators.`,
      "aspect": ["symptoms", "risks", "treatment", "prognosis"]
    },
    {
      "@type": "FAQPage",
      "@id": `https://pregweeks.com/conditions/${slug}/#faq`,
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://pregweeks.com/conditions/${slug}/#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://pregweeks.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Conditions",
          "item": "https://pregweeks.com/conditions"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": name,
          "item": `https://pregweeks.com/conditions/${slug}`
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${name} in Pregnancy: Symptoms, Risks & Management | PregWeeks`}
  description={`What is ${name}? Learn the symptoms, risks to mother and baby, clinical treatment options, and when to seek immediate medical support.`}
>
  <!-- Inject Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- Reading Progress Bar -->
  <div class="fixed top-[52px] left-0 w-full h-[3px] bg-neutral-100 z-50 print:hidden">
    <div id="scroll-indicator" class="h-full bg-[#0066cc] w-0 transition-all duration-75"></div>
  </div>

  <!-- Medical Review Banner (EEAT Signal) -->
  <div class="bg-blue-50 border-b border-blue-150 py-2.5 px-4 text-center text-xs text-neutral-600 print:hidden">
    <span class="font-medium text-neutral-800">Medical Notice:</span> This educational content is compiled from peer-reviewed obstetrical standards. Always consult your obstetrician for clinical decisions. Read our <a href="/disclaimer" class="text-[#0066cc] hover:underline font-semibold">Medical Disclaimer</a>.
  </div>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-8 print:hidden" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <a href="/conditions" class="hover:text-[#0066cc] transition-colors">Conditions</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">{name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Sticky Table of Contents (Desktop Only) -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-20 border border-neutral-200 rounded-xl p-5 bg-white space-y-4">
          <h2 class="text-xs font-bold text-neutral-900 uppercase tracking-wider">On This Page</h2>
          <nav class="space-y-2.5">
            {tocLinks.map(link => (
              <a 
                href={`#${link.id}`} 
                class="toc-link block text-xs text-neutral-500 hover:text-[#0066cc] font-medium transition-colors border-l-2 border-transparent pl-3"
              >
                {link.name}
              </a>
            ))}
          </nav>
          
          <!-- Monetization Placeholder: Sidebar Ad Slot -->
          <div class="ad-slot bg-neutral-50 border border-dashed border-neutral-200/50 rounded-lg text-center py-6 text-[10px] text-neutral-400 uppercase tracking-widest w-full mt-4 hidden print:hidden" style="display: none;">
            ADVERTISEMENT
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <article class="lg:col-span-3 space-y-10">
        
        <!-- Header -->
        <header class="space-y-3 pb-6 border-b border-neutral-100">
          <div class="flex justify-between items-center text-xs text-neutral-400">
            <span>Last updated: June 2026</span>
            <span class="font-medium">Clinical Reference: ACOG / WHO</span>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">{name}</h1>
          <p class="text-xs text-neutral-500">A detailed guide on symptoms, mother & baby complications, treatments, and medical triggers.</p>
        </header>

        <!-- Overview -->
        <section id="overview" class="space-y-3 scroll-mt-20">
          <h2 class="text-xl font-bold text-neutral-900">What is {name}?</h2>
          <p class="text-sm text-neutral-700 leading-relaxed">
            {definition}
          </p>
          
          <!-- Monetization Placeholder: After First Paragraph Ad Slot -->
          <div class="ad-slot bg-neutral-50 border border-dashed border-neutral-200/50 rounded-lg text-center py-4 text-[10px] text-neutral-400 uppercase tracking-widest w-full my-4 hidden print:hidden" style="display: none;">
            ADVERTISEMENT
          </div>
        </section>

        <!-- Symptoms -->
        <section id="symptoms" class="space-y-4 scroll-mt-20">
          <h2 class="text-xl font-bold text-neutral-900">Key Symptoms & Warning Signs</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Knowing what warning signs to identify can help catch and manage this condition early. Keep in mind that some conditions are entirely asymptomatic and only detected during routine clinical screenings.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {symptoms.map(sym => (
              <li class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 text-xs text-neutral-700 font-medium flex items-center space-x-2.5">
                <span class="text-amber-500 text-sm">⚠️</span>
                <span>{sym}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Maternal & Fetal Risks -->
        <section id="risks" class="space-y-4 scroll-mt-20">
          <h2 class="text-xl font-bold text-neutral-900">Maternal & Fetal Risks</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Unmanaged conditions can introduce health complications for both the expectant mother and the developing fetus. Proper diagnosis and clinical compliance mitigate these risks.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Mother Risks -->
            <div class="bg-white border border-neutral-200 rounded-xl p-5 space-y-2.5">
              <h3 class="text-xs font-bold text-neutral-800 uppercase tracking-wider border-b border-neutral-100 pb-2 flex justify-between">
                <span>Risks to the Mother</span>
                <span class="text-rose-500">👩‍⚕️</span>
              </h3>
              <p class="text-xs text-neutral-600 leading-relaxed">
                {risks.mother}
              </p>
            </div>
            <!-- Baby Risks -->
            <div class="bg-white border border-neutral-200 rounded-xl p-5 space-y-2.5">
              <h3 class="text-xs font-bold text-neutral-800 uppercase tracking-wider border-b border-neutral-100 pb-2 flex justify-between">
                <span>Risks to the Baby</span>
                <span class="text-blue-500">👶</span>
              </h3>
              <p class="text-xs text-neutral-600 leading-relaxed">
                {risks.baby}
              </p>
            </div>
          </div>
        </section>

        <!-- Treatment & Management -->
        <section id="treatment" class="space-y-4 scroll-mt-20">
          <h2 class="text-xl font-bold text-neutral-900">Treatment & Clinical Management</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Treatment protocols are tailored to the severity of the condition, your gestational age, and general fetal parameters. Common management strategies include:
          </p>
          <div class="space-y-3">
            {treatment.map((treat, idx) => (
              <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-4 flex items-start space-x-3">
                <span class="w-5 h-5 rounded-full bg-[#0066cc] text-white flex items-center justify-center text-[10px] font-bold mt-0.5 flex-shrink-0">
                  {idx + 1}
                </span>
                <p class="text-xs text-neutral-700 leading-relaxed">
                  {treat}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- When to Call Doctor -->
        <section id="when-to-call" class="bg-red-50/50 border border-red-200 rounded-xl p-5 space-y-3 scroll-mt-20">
          <h2 class="text-base font-bold text-red-950 flex items-center space-x-2">
            <span class="text-lg">🚨</span>
            <span>When to Call Your Healthcare Provider</span>
          </h2>
          <p class="text-xs text-red-900 leading-relaxed">
            {whenToCall}
          </p>
        </section>

        <!-- FAQs -->
        <section id="faqs" class="space-y-6 scroll-mt-20">
          <h2 class="text-xl font-bold text-neutral-900">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <div class="bg-white border border-neutral-200 rounded-xl p-5">
                <h3 class="text-xs font-semibold text-neutral-900 mb-1.5">{faq.q}</h3>
                <p class="text-xs text-neutral-600 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Share Buttons (Engagement Feature) -->
        <footer class="border-t border-neutral-100 pt-6 flex flex-wrap justify-between items-center gap-4 print:hidden">
          <div class="text-xs text-neutral-400">Share this clinical reference guide:</div>
          <div class="flex items-center space-x-2">
            <button 
              id="share-btn" 
              class="bg-neutral-50 hover:bg-neutral-100 text-neutral-700 text-xs font-semibold py-2 px-4 rounded-lg border border-neutral-200 flex items-center space-x-1.5 transition-all active:scale-95"
            >
              <span>🔗</span>
              <span>Copy Link</span>
            </button>
            <a 
              href={`https://api.whatsapp.com/send?text=Learn about ${name} in pregnancy: https://pregweeks.com/conditions/${slug}`}
              target="_blank" 
              rel="noopener"
              class="bg-green-500 hover:bg-green-600 text-white text-xs font-semibold py-2 px-4 rounded-lg flex items-center space-x-1.5 transition-all active:scale-95"
            >
              <span>💬</span>
              <span>WhatsApp</span>
            </a>
          </div>
        </footer>

      </article>
    </div>

    <!-- Back to top button -->
    <button 
      id="back-to-top" 
      class="fixed bottom-8 right-8 bg-[#0066cc] text-white p-3 rounded-full shadow-lg border border-blue-600 transition-all active:scale-90 scale-0 opacity-0 z-50 print:hidden cursor-pointer"
      aria-label="Back to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
      </svg>
    </button>
  </main>
</Layout>

<script>
  // Scroll indicator logic
  const indicator = document.getElementById('scroll-indicator');
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = totalHeight > 0 ? (window.pageYOffset / totalHeight) * 100 : 0;
    if (indicator) indicator.style.width = `${progress}%`;
  });

  // Back to top button logic
  const bttBtn = document.getElementById('back-to-top');
  window.addEventListener('scroll', () => {
    if (window.pageYOffset > 300) {
      bttBtn?.classList.remove('scale-0', 'opacity-0');
      bttBtn?.classList.add('scale-100', 'opacity-100');
    } else {
      bttBtn?.classList.remove('scale-100', 'opacity-100');
      bttBtn?.classList.add('scale-0', 'opacity-0');
    }
  });

  bttBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Copy URL Share Button logic
  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({
          title: document.title,
          url: window.location.href
        });
      } else {
        await navigator.clipboard.writeText(window.location.href);
        const label = shareBtn.querySelector('span:last-child');
        if (label) {
          label.textContent = "Copied!";
          setTimeout(() => { label.textContent = "Copy Link"; }, 2000);
        }
      }
    } catch (err) {
      console.error("Error sharing page", err);
    }
  });

  // Highlight active link in TOC
  const sections = document.querySelectorAll('section[id]');
  const tocLinks = document.querySelectorAll('.toc-link');

  window.addEventListener('scroll', () => {
    let currentId = '';
    sections.forEach(sec => {
      const top = (sec as HTMLElement).offsetTop - 120;
      if (window.pageYOffset >= top) {
        currentId = sec.getAttribute('id') || '';
      }
    });

    tocLinks.forEach(link => {
      link.classList.remove('border-[#0066cc]', 'text-[#0066cc]');
      link.classList.add('border-transparent', 'text-neutral-500');
      if (link.getAttribute('href') === `#${currentId}`) {
        link.classList.remove('border-transparent', 'text-neutral-500');
        link.classList.add('border-[#0066cc]', 'text-[#0066cc]');
      }
    });
  });
</script>
