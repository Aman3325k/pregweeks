---
// src/pages/symptoms/[symptom].astro
import Layout from '../../layouts/Layout.astro';
import { symptomItems } from '../../data/symptomData';
import { pregnancyConditions } from '../../data/conditionsData';
import { pregnancyData } from '../../data/pregnancyData';
import { getBreadcrumbSchema, getFAQSchema, getMedicalPageSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return symptomItems.map((symptom) => ({
    params: { symptom: symptom.slug },
    props: { symptom }
  }));
}

const { symptom } = Astro.props;

const title = `${symptom.name} During Pregnancy: Causes & Relief | PregWeeks`;
const description = `Is ${symptom.name} normal during pregnancy? Learn when it occurs, home remedies to relieve it, and when to call your doctor.`;
const canonicalUrl = `https://pregweeks.com/symptoms/${symptom.slug}`;

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Symptoms", url: "https://pregweeks.com/symptoms" },
  { name: symptom.name, url: canonicalUrl }
]);

const medicalSchema = getMedicalPageSchema(title, description, canonicalUrl);
const faqSchema = getFAQSchema(symptom.faqs);

// Helper to check if symptom is active in a week
function isSymptomActiveInWeek(symptomWeeks: string, week: number): boolean {
  const parts = symptomWeeks.split(',');
  for (const part of parts) {
    const clean = part.replace(/weeks?/i, '').trim();
    if (clean.includes('-')) {
      const [start, end] = clean.split('-').map(Number);
      if (week >= start && week <= end) return true;
    } else {
      const single = Number(clean);
      if (!isNaN(single) && single === week) return true;
    }
  }
  return false;
}

// Find all weeks where the symptom is active
const activeWeeks = Array.from({ length: 40 }, (_, i) => i + 1)
  .filter(w => isSymptomActiveInWeek(symptom.weeks, w));

// Take a subset of up to 6 sample weeks
const sampleWeeks = activeWeeks.filter((_, idx) => idx % Math.ceil(activeWeeks.length / 6) === 0).slice(0, 6);

// Find related conditions mapping
const symptomToConditionsMap: Record<string, string[]> = {
  'cramping': ['placenta-previa'],
  'spotting': ['placenta-previa', 'pregnancy-after-35'],
  'nausea': ['morning-sickness-severe'],
  'headache': ['preeclampsia'],
  'swelling': ['preeclampsia'],
  'frequent-urination': ['gestational-diabetes'],
  'fatigue': ['gestational-diabetes'],
  'dizziness': ['preeclampsia', 'gestational-diabetes'],
  'itchiness': ['gestational-diabetes']
};

const conditionSlugs = symptomToConditionsMap[symptom.slug] || ['preeclampsia', 'gestational-diabetes'];
const relatedConditions = pregnancyConditions.filter(c => conditionSlugs.includes(c.slug));
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schemas={[breadcrumbs, medicalSchema, faqSchema]}>
  <div class="max-w-[760px] mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="text-[12px] text-ink-muted-48 mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/symptoms" class="hover:text-primary transition-colors">Symptoms</a>
      <span>&rsaquo;</span>
      <span class="text-ink font-medium truncate max-w-[200px]">{symptom.name}</span>
    </nav>

    <!-- Symptom Main Card -->
    <article class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors flex flex-col gap-6">
      <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-hairline pb-5">
        <div>
          <span class="text-[10px] md:text-xs font-semibold text-ink-muted-48 uppercase tracking-wider">{symptom.weeks}</span>
          <h1 class="text-2xl md:text-4xl font-display font-semibold tracking-apple-tight mt-1">{symptom.name}</h1>
          <span class="text-[10px] text-ink-muted-48 block mt-1">Last reviewed by medical team: June 2026</span>
        </div>

        <div class={`self-start sm:self-center px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider ${
          symptom.normalcy === 'normal' ? 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300' :
          symptom.normalcy === 'common' ? 'bg-blue-100 text-blue-800 dark:bg-blue-950/40 dark:text-blue-300' :
          'bg-orange-100 text-orange-800 dark:bg-orange-950/40 dark:text-orange-300'
        }`}>
          {symptom.normalcy === 'normal' ? '🟢 Normal Pregnancy Marker' :
           symptom.normalcy === 'common' ? '🔵 Common Pregnancy Symptom' :
           '🟠 Seek Medical Advice'}
        </div>
      </div>

      <!-- Description -->
      <div class="flex flex-col gap-2.5">
        <h2 class="text-lg md:text-xl font-display font-semibold text-ink tracking-apple-tight">Why It Happens</h2>
        <p class="text-ink-muted-80 text-sm md:text-base leading-relaxed">
          {symptom.description}
        </p>
      </div>

      <!-- Relief and Remedies -->
      <div class="flex flex-col gap-3">
        <h2 class="text-lg md:text-xl font-display font-semibold text-ink tracking-apple-tight">Safe Home Remedies</h2>
        <ul class="list-disc list-inside space-y-2 text-sm text-ink-muted-80 pl-1">
          {symptom.remedies.map((remedy) => (
            <li class="leading-relaxed">{remedy}</li>
          ))}
        </ul>
      </div>

      <!-- Red Flag Warning Callout -->
      <div class="bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-900/50 rounded-apple-sm p-5 text-sm leading-relaxed flex flex-col gap-2">
        <h3 class="font-semibold text-red-800 dark:text-red-300 flex items-center gap-1.5">
          <span>⚠️</span>
          <span>When to Contact a Doctor</span>
        </h3>
        <p class="text-ink-muted-80 text-xs md:text-sm">
          {symptom.whenToCallDoctor}
        </p>
      <!-- Related Weeks & Conditions Section (Internal Linking Matrix) -->
      <div class="border-t border-hairline pt-5 flex flex-col gap-4">
        <h3 class="font-display font-semibold text-base text-ink tracking-apple-tight">Related Guides &amp; Resources</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-canvas-parchment p-4 rounded-apple-sm border border-hairline">
            <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Typical Week Ranges</span>
            <p class="text-xs text-ink-muted-80 mt-1 mb-2">This symptom commonly occurs during these weeks of pregnancy:</p>
            <div class="flex flex-wrap gap-1.5">
              {sampleWeeks.map(w => (
                <a href={`/week/${w}`} class="bg-canvas border border-hairline hover:border-primary text-primary px-2 py-0.5 rounded text-[11px] font-semibold">
                  Week {w}
                </a>
              ))}
            </div>
          </div>
          
          <div class="bg-canvas-parchment p-4 rounded-apple-sm border border-hairline">
            <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Related Conditions</span>
            <p class="text-xs text-ink-muted-80 mt-1 mb-2">Symptom matches for these prenatal conditions:</p>
            <div class="flex flex-col gap-1.5">
              {relatedConditions.map(c => (
                <a href={`/conditions/${c.slug}`} class="text-primary hover:underline text-[11px] font-semibold">
                  ✦ {c.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- FAQs section -->
    <section class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors">
      <h2 class="text-xl md:text-2xl font-display font-semibold mb-6 text-ink tracking-apple-tight">Clinical Questions & Answers</h2>
      <div class="flex flex-col gap-6">
        {symptom.faqs.map((faq, index) => (
          <div class="flex flex-col gap-1.5 border-b border-hairline/60 pb-4 last:border-0 last:pb-0">
            <h3 class="font-semibold text-sm md:text-base text-ink flex items-start gap-2">
              <span class="text-primary font-bold">Q{index + 1}:</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-ink-muted-80 text-xs md:text-sm pl-7 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer Action -->
    <div class="flex justify-between items-center text-sm md:text-base">
      <a href="/symptoms" class="text-primary font-semibold hover:underline flex items-center gap-1.5">
        <span>&larr;</span> View All Pregnancy Symptoms
      </a>
      <a href="/tools/due-date-calculator" class="text-ink hover:text-primary transition-colors font-medium">
        LMP Due Date Calculator
      </a>
    </div>
  </div>
</Layout>
