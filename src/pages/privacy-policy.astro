---
import Layout from '../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Privacy Policy", url: "https://pregweeks.com/privacy-policy" }
]);
---

<Layout 
  title="Privacy Policy | PregWeeks"
  description="Read the PregWeeks Privacy Policy. Learn how we prioritize your privacy by keeping your health calculations and tracking data 100% client-side."
  canonicalUrl="https://pregweeks.com/privacy-policy"
  schemas={[breadcrumbs]}
>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Privacy Policy</span>
    </nav>

    <article class="space-y-8 prose prose-neutral max-w-none text-sm text-neutral-700 leading-relaxed">
      <header class="border-b border-neutral-200 pb-6">
        <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Privacy Policy</h1>
        <p class="text-xs text-neutral-500 mt-2">Last Updated: June 7, 2026</p>
      </header>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900">1. Introduction</h2>
        <p>
          At <strong class="text-neutral-900">PregWeeks.com</strong>, we are committed to protecting the privacy of our visitors. This Privacy Policy details our approach to privacy, data security, and tracking.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900">2. Client-Side Data Storage (Local Storage)</h2>
        <p>
          Unlike traditional websites that store your personal health data on remote cloud databases, PregWeeks.com is built as an offline-capable, static utility. 
        </p>
        <p class="bg-neutral-50 border border-neutral-200 p-4 rounded-xl text-xs text-neutral-600 leading-relaxed">
          <strong>How your data is stored:</strong> All logs, trackers, checklists, and inputs you enter into our interactive tools (such as the Contraction Timer, Fetal Kick Counter, Pregnancy Weight Tracker, Hospital Bag Checklist, and Baby Shower Checklist) are saved directly in your browser's <code class="bg-neutral-200/60 px-1 py-0.5 rounded text-[10px]">localStorage</code>.
        </p>
        <p>
          This data remains strictly on your device and is never transmitted to our servers, sold, or shared with third parties. Clearing your browser's history or local storage will delete your logs permanently.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900">3. Cookies & Tracking Technologies</h2>
        <p>
          We do not use cookies to track your personal health history or serve targeted ads. Our platform runs independently of marketing trackers to ensure a clean, speed-optimized experience for all users.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900">4. Third-Party Links</h2>
        <p>
          Our platform may link to third-party medical resources (such as CDC, ACOG, or FDA websites). We are not responsible for the privacy practices or contents of external platforms.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-neutral-900">5. Contact Information</h2>
        <p>
          If you have any questions about this policy or our data practices, contact us at: <a href="mailto:privacy@pregweeks.com" class="text-[#0066cc] hover:underline">privacy@pregweeks.com</a>.
        </p>
      </section>
    </article>
  </main>
</Layout>
