---
// src/pages/partner/[week].astro
import Layout from '../../layouts/Layout.astro';
import { partnerWeeks } from '../../data/partnerData';
import { getBreadcrumbSchema, getFAQSchema, getMedicalPageSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return partnerWeeks.map((item) => ({
    params: { week: item.week.toString() },
    props: { item }
  }));
}

const { item } = Astro.props;
const { week, momFeeling, howToHelp, whatToPrepare } = item;

const title = `Week ${week} Pregnancy Partner & Dad Guide | PregWeeks`;
const description = `Find out how to support your pregnant partner during Week ${week}. Learn about her symptoms, how to help, and what to prepare this week.`;
const canonicalUrl = `https://pregweeks.com/partner/${week}`;

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Partner Guide", url: "https://pregweeks.com/partner" },
  { name: `Week ${week}`, url: canonicalUrl }
]);

const faqs = [
  {
    q: `What is my pregnant partner feeling during Week ${week}?`,
    a: momFeeling
  },
  {
    q: `How can I help my partner during Week ${week} of pregnancy?`,
    a: howToHelp
  },
  {
    q: `What logistics should I prepare during pregnancy Week ${week}?`,
    a: whatToPrepare
  }
];

const medicalSchema = getMedicalPageSchema(title, description, canonicalUrl);
const faqSchema = getFAQSchema(faqs);

const prevWeek = week > 1 ? week - 1 : null;
const nextWeek = week < 40 ? week + 1 : null;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schemas={[breadcrumbs, medicalSchema, faqSchema]}>
  <div class="max-w-[760px] mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="text-[12px] text-ink-muted-48 mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/partner" class="hover:text-primary transition-colors">Partner Guide</a>
      <span>&rsaquo;</span>
      <span class="text-ink font-medium">Week {week}</span>
    </nav>

    <!-- Partner Guide Card -->
    <article class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors flex flex-col gap-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-hairline pb-5">
        <div>
          <span class="text-[10px] md:text-xs font-semibold text-ink-muted-48 uppercase tracking-wider">Gestational Week {week}</span>
          <h1 class="text-2xl md:text-4xl font-display font-semibold tracking-apple-tight mt-1">Partner & Dad Support Guide</h1>
        </div>

        <a href={`/week/${week}`} class="self-start sm:self-center bg-primary/10 text-primary hover:bg-primary/20 transition-all font-semibold text-xs px-4 py-2 rounded-full cursor-pointer">
          View Mom's Week {week} Page
        </a>
      </div>

      <!-- Section 1: Mom's State -->
      <div class="flex gap-4 items-start">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">🌸</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink">What She Is Feeling</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {momFeeling}
          </p>
        </div>
      </div>

      <!-- Section 2: How to Help -->
      <div class="flex gap-4 items-start border-t border-hairline/60 pt-5">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">🧹</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink">How You Can Help</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {howToHelp}
          </p>
        </div>
      </div>

      <!-- Section 3: What to Prepare -->
      <div class="flex gap-4 items-start border-t border-hairline/60 pt-5">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">📋</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink font-display">What to Prepare & Plan</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {whatToPrepare}
          </p>
        </div>
      </div>

    </article>

    <!-- FAQs section -->
    <section class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors">
      <h2 class="text-xl md:text-2xl font-display font-semibold mb-6 text-ink tracking-apple-tight">Week {week} Partner FAQs</h2>
      <div class="flex flex-col gap-5">
        {faqs.map((faq, index) => (
          <div class="flex flex-col gap-1.5 border-b border-hairline/60 pb-4 last:border-0 last:pb-0">
            <h3 class="font-semibold text-sm md:text-base text-ink flex items-start gap-2">
              <span class="text-primary font-bold">Q{index + 1}:</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-ink-muted-80 text-xs md:text-sm pl-7 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Navigation Footer -->
    <div class="flex justify-between items-center text-sm md:text-base">
      {prevWeek ? (
        <a href={`/partner/${prevWeek}`} class="text-primary font-semibold hover:underline flex items-center gap-1">
          <span>&larr;</span> Week {prevWeek}
        </a>
      ) : (
        <a href="/partner" class="text-ink-muted-48 hover:text-primary transition-colors font-medium">Dashboard</a>
      )}

      <a href="/partner" class="hidden sm:inline-block text-ink-muted-80 hover:text-primary transition-colors font-medium">
        All Weeks Index
      </a>

      {nextWeek ? (
        <a href={`/partner/${nextWeek}`} class="text-primary font-semibold hover:underline flex items-center gap-1">
          Week {nextWeek} <span>&rarr;</span>
        </a>
      ) : (
        <span class="text-ink-muted-48 font-medium">Delivery Day! 🎉</span>
      )}
    </div>
  </div>
</Layout>
