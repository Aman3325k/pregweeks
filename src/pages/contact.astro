---
import Layout from '../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Contact", url: "https://pregweeks.com/contact" }
]);
---

<Layout 
  title="Contact Us | PregWeeks"
  description="Have questions or suggestions? Contact the PregWeeks team directly."
  canonicalUrl="https://pregweeks.com/contact"
  schemas={[breadcrumbs]}
>
  <main class="max-w-2xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Contact</span>
    </nav>

    <div class="bg-white border border-neutral-200 rounded-2xl p-6 sm:p-8 space-y-6">
      <header class="border-b border-neutral-100 pb-4">
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900">Contact PregWeeks</h1>
        <p class="text-xs text-neutral-500 mt-1">Send us your thoughts, suggestions, or editorial feedback.</p>
      </header>

      <!-- Success message container (hidden initially) -->
      <div id="contact-success" class="hidden text-center py-8 space-y-4">
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-neutral-900">Message Sent!</h2>
        <p class="text-xs text-neutral-500 max-w-sm mx-auto leading-relaxed">
          Thank you for reaching out. We have received your message and will review it shortly.
        </p>
        <button 
          id="send-another-btn"
          class="bg-neutral-100 hover:bg-neutral-200 text-neutral-800 text-xs font-semibold py-2 px-4 rounded-lg border border-neutral-200 transition-all active:scale-95"
        >
          Send Another Message
        </button>
      </div>

      <!-- Contact Form -->
      <form id="contact-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Your Name</label>
            <input 
              type="text" 
              id="contact-name" 
              required
              class="w-full px-3.5 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Email Address</label>
            <input 
              type="email" 
              id="contact-email" 
              required
              class="w-full px-3.5 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
            />
          </div>
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Subject</label>
          <input 
            type="text" 
            id="contact-subject" 
            required
            class="w-full px-3.5 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Message</label>
          <textarea 
            id="contact-message" 
            rows="5"
            required
            class="w-full px-3.5 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full bg-[#0066cc] hover:bg-[#0055b3] text-white py-3 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all active:scale-[0.98]"
        >
          Send Message
        </button>
      </form>

      <!-- Email Fallback -->
      <div class="text-center pt-4 border-t border-neutral-100 text-xs text-neutral-500">
        Or email us directly at: <a href="mailto:support@pregweeks.com" class="text-[#0066cc] hover:underline">support@pregweeks.com</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successContainer = document.getElementById('contact-success');
  const sendAnotherBtn = document.getElementById('send-another-btn');

  if (form && successContainer) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Simulate submission success
      form.classList.add('hidden');
      successContainer.classList.remove('hidden');
      
      form.reset();
    });
  }

  if (sendAnotherBtn && form && successContainer) {
    sendAnotherBtn.addEventListener('click', () => {
      successContainer.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }
</script>
