---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import { getMedicalPageSchema, getBreadcrumbSchema } from '../utils/seo';

const title = "PregWeeks.com | Interactive Pregnancy Week-by-Week Guide & Due Date Tracker";
const description = "Track your baby's growth and maternal milestones with our beautifully designed week-by-week pregnancy calculator, tools, and local symptom journal.";
const url = "https://pregweeks.com";

// Setup page schemas
const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Home", url: url }
  ])
];

// Array 1-40 for the weeks grid
const weeks = Array.from({ length: 40 }, (_, i) => i + 1);
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Section 1: Hero Tile (Light Canvas) -->
  <section class="bg-canvas py-16 md:py-24 px-4 transition-colors">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 items-center gap-12">
      <div class="flex flex-col items-start max-w-xl">
        <span class="inline-block bg-primary/10 text-primary font-bold text-xs uppercase tracking-widest px-3 py-1 rounded-full mb-6">
          Pregnancy Guide & Tools
        </span>
        <h2 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl text-ink leading-tight tracking-apple-tight mb-6">
          Celebrate every step of your pregnancy.
        </h2>
        <p class="text-[17px] md:text-lg text-ink-muted-80 leading-relaxed tracking-apple-dense mb-8">
          Detailed week-by-week guides about your baby's development, maternal body changes, and symptoms. Keep track of your pregnancy offline with our private due date calculator, kick counter, and contraction timer.
        </p>
        <a href="#calculator-widget" class="bg-primary hover:bg-primary-focus text-white font-semibold py-3 px-6 rounded-apple-pill transition-all active:scale-95 text-center cursor-pointer text-sm md:text-base shadow-none">
          Calculate Due Date
        </a>
      </div>
      
      <div class="flex justify-center items-center">
        <!-- Hero Illustration with the ONLY drop-shadow in the system -->
        <img 
          src="/pregnancy-hero.png" 
          alt="Artistic abstract pregnancy line-art illustration" 
          class="w-full max-w-[420px] h-auto rounded-apple-lg border border-hairline shadow-[3px_5px_30px_0px_rgba(0,0,0,0.22)] object-cover bg-canvas transition-colors duration-300" 
          width="420"
          height="420"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Section 2: Calculator Widget (Parchment Surface) -->
  <section class="bg-canvas-parchment py-16 md:py-24 px-4 border-t border-b border-hairline transition-colors" id="calculator-widget">
    <div class="max-w-[1200px] mx-auto text-center mb-10">
      <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink mb-3 tracking-apple-tight">Due Date Tracker</h2>
      <p class="text-ink-muted-80 max-w-lg mx-auto text-sm md:text-base">Input your dates below to instantly determine your gestational age and target due date.</p>
    </div>
    
    <!-- Homepage Pregnancy Tracker Widget (Engagement Feature) -->
    <div id="homepage-tracker-widget" class="max-w-2xl mx-auto mb-8 bg-canvas border border-hairline rounded-apple-lg p-6 text-left transition-all duration-300" style="display: none;">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-hairline pb-4 mb-4">
        <div>
          <span class="text-[10px] md:text-xs text-ink-muted-48 uppercase tracking-wider font-semibold block">Your Pregnancy Status</span>
          <h3 class="text-xl md:text-2xl font-bold text-primary mt-1" id="widget-weeks-title">You are -- weeks pregnant</h3>
        </div>
        <a id="widget-guide-link" href="#" class="bg-primary hover:bg-primary-focus text-white text-xs font-semibold py-2 px-4 rounded-apple-pill transition-all active:scale-95 text-center">
          View Week -- Guide &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Trimester</span>
          <span class="text-sm font-bold text-ink mt-0.5 block" id="widget-trimester">--</span>
        </div>
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Days Until Due Date</span>
          <span class="text-sm font-bold text-ink mt-0.5 block" id="widget-countdown">-- days</span>
        </div>
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Next Milestone</span>
          <span class="text-sm font-bold text-ink mt-0.5 block line-clamp-1" id="widget-milestone">--</span>
        </div>
      </div>
    </div>

    <div class="max-w-2xl mx-auto">
      <Calculator />
    </div>
  </section>

  <!-- Section 3: Week-by-Week Directory Grid (Light Canvas) -->
  <section class="bg-canvas py-16 md:py-24 px-4 transition-colors" id="weeks-directory">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink mb-3 tracking-apple-tight">Week-by-Week Directory</h2>
        <p class="text-ink-muted-80 max-w-lg mx-auto text-sm md:text-base">Click a week to view size comparisons, length and weight progress, baby milestones, and doctor tips.</p>
      </div>

      <!-- Trimester Sections -->
      <div class="flex flex-col gap-12">
        <!-- 1st Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-primary"></span>
            <h3 class="font-display font-semibold text-xl text-ink">First Trimester (Weeks 1 - 13)</h3>
          </div>
          <div class="grid grid-cols-4 sm:grid-cols-7 md:grid-cols-10 gap-3">
            {weeks.slice(0, 13).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-primary hover:bg-canvas transition-all active:scale-95"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Wk</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 2nd Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-[#f2cc8f]"></span>
            <h3 class="font-display font-semibold text-xl text-ink">Second Trimester (Weeks 14 - 27)</h3>
          </div>
          <div class="grid grid-cols-4 sm:grid-cols-7 md:grid-cols-10 gap-3">
            {weeks.slice(13, 27).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-[#f2cc8f] hover:bg-canvas transition-all active:scale-95"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Wk</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 3rd Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-[#81b29a]"></span>
            <h3 class="font-display font-semibold text-xl text-ink">Third Trimester (Weeks 28 - 40)</h3>
          </div>
          <div class="grid grid-cols-4 sm:grid-cols-7 md:grid-cols-10 gap-3">
            {weeks.slice(27, 40).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-[#81b29a] hover:bg-canvas transition-all active:scale-95"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Wk</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Trimester Guide Tiles (Alternating Dark surface) -->
  <section class="bg-surface-tile-1 text-white py-16 md:py-24 px-4 transition-colors">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-semibold text-3xl md:text-4xl text-white mb-3 tracking-apple-tight">Trimester Overviews</h2>
        <p class="text-body-muted max-w-lg mx-auto text-sm md:text-base">A pregnancy is divided into three distinct phases. Explore our custom guides to prepare yourself.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- T1 -->
        <div class="bg-[#1e1a2d] border border-white/10 rounded-apple-lg p-6 md:p-8 flex flex-col justify-between items-start min-h-[280px]">
          <div>
            <span class="text-xs text-primary-on-dark uppercase tracking-wider font-semibold mb-2 block">Months 1 - 3</span>
            <h3 class="font-display font-semibold text-2xl text-white mb-4 tracking-apple-tight">First Trimester</h3>
            <p class="text-body-muted text-sm leading-relaxed mb-6">Embryonic cell development, early organ creation, positive tests, and adjusting to hormonal surges (nausea & fatigue).</p>
          </div>
          <a href="/trimester/first" class="text-primary-on-dark hover:underline font-semibold text-sm flex items-center gap-1.5 cursor-pointer">
            Explore Trimester 1 &rarr;
          </a>
        </div>

        <!-- T2 -->
        <div class="bg-[#1e1a2d] border border-white/10 rounded-apple-lg p-6 md:p-8 flex flex-col justify-between items-start min-h-[280px]">
          <div>
            <span class="text-xs text-[#f6d8a7] uppercase tracking-wider font-semibold mb-2 block">Months 4 - 6</span>
            <h3 class="font-display font-semibold text-2xl text-white mb-4 tracking-apple-tight">Second Trimester</h3>
            <p class="text-body-muted text-sm leading-relaxed mb-6">The 'honeymoon' phase. Baby kicks start (quickening), energy returns, and the crucial mid-pregnancy anatomy scan takes place.</p>
          </div>
          <a href="/trimester/second" class="text-primary-on-dark hover:underline font-semibold text-sm flex items-center gap-1.5 cursor-pointer">
            Explore Trimester 2 &rarr;
          </a>
        </div>

        <!-- T3 -->
        <div class="bg-[#1e1a2d] border border-white/10 rounded-apple-lg p-6 md:p-8 flex flex-col justify-between items-start min-h-[280px]">
          <div>
            <span class="text-xs text-[#9ac2af] uppercase tracking-wider font-semibold mb-2 block">Months 7 - 9</span>
            <h3 class="font-display font-semibold text-2xl text-white mb-4 tracking-apple-tight">Third Trimester</h3>
            <p class="text-body-muted text-sm leading-relaxed mb-6">Rapid fetal growth, lung maturation, structural body strain, nesting instinct spikes, and active labor preparation.</p>
          </div>
          <a href="/trimester/third" class="text-primary-on-dark hover:underline font-semibold text-sm flex items-center gap-1.5 cursor-pointer">
            Explore Trimester 3 &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Trust and Review Panel (Parchment Surface) -->
  <section class="bg-canvas-parchment py-16 px-4 border-t border-hairline transition-colors">
    <div class="max-w-[800px] mx-auto text-center flex flex-col items-center gap-6">
      <span class="text-3xl">🛡️</span>
      <h2 class="font-display font-semibold text-2xl md:text-3xl text-ink tracking-apple-tight">Trusted, Medically Reviewed Information</h2>
      <p class="text-ink-muted-80 text-sm md:text-base leading-relaxed">
        PregWeeks provides science-backed content reviewed by pregnancy experts and certified OB-GYNs. We are committed to providing you with clear, accurate, and non-judgmental facts during this key milestone in your family life.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-xs font-semibold text-ink-muted-80 pt-2">
        <span class="bg-canvas px-3 py-1.5 rounded-full border border-hairline">✓ Clinically Reviewed</span>
        <span class="bg-canvas px-3 py-1.5 rounded-full border border-hairline">✓ 100% Secure Browser Storage</span>
        <span class="bg-canvas px-3 py-1.5 rounded-full border border-hairline">✓ Mobile & Offline First</span>
      </div>
    </div>
  </section>
</Layout>

<script>
  const widget = document.getElementById('homepage-tracker-widget');
  const widgetWeeksTitle = document.getElementById('widget-weeks-title');
  const widgetGuideLink = document.getElementById('widget-guide-link') as HTMLAnchorElement;
  const widgetTrimester = document.getElementById('widget-trimester');
  const widgetCountdown = document.getElementById('widget-countdown');
  const widgetMilestone = document.getElementById('widget-milestone');

  function getNextMilestone(weeksNum: number) {
    if (weeksNum < 12) return { text: "1st Trimester Scan (Wk 12)", week: 12 };
    if (weeksNum < 20) return { text: "Anatomy Scan (Wk 20)", week: 20 };
    if (weeksNum < 24) return { text: "Glucose Screen (Wk 24)", week: 24 };
    if (weeksNum < 28) return { text: "3rd Trimester (Wk 28)", week: 28 };
    if (weeksNum < 36) return { text: "GBS Test (Wk 36)", week: 36 };
    return { text: "Due Date / Delivery!", week: 40 };
  }

  function updateWidget() {
    const savedCalculation = localStorage.getItem('pregnancy_calc_v2');
    if (!savedCalculation) {
      if (widget) widget.style.display = 'none';
      return;
    }

    try {
      const data = JSON.parse(savedCalculation);
      const date = new Date(data.date);
      const mode = data.mode;
      const now = new Date();
      
      date.setHours(12, 0, 0, 0);
      now.setHours(12, 0, 0, 0);

      let edd: Date;
      let GA_days = 0;
      if (mode === 'lmp') {
        edd = new Date(date.getTime() + 280 * 24 * 60 * 60 * 1000);
        GA_days = Math.floor((now.getTime() - date.getTime()) / (24 * 60 * 60 * 1000));
      } else {
        edd = new Date(date.getTime() + 266 * 24 * 60 * 60 * 1000);
        GA_days = Math.floor((now.getTime() - date.getTime()) / (24 * 60 * 60 * 1000)) + 14;
      }

      if (GA_days < 0) GA_days = 0;
      const daysRemaining = Math.max(0, Math.floor((edd.getTime() - now.getTime()) / (24 * 60 * 60 * 1000)));
      const weeks = Math.floor(GA_days / 7);
      const remainingDays = GA_days % 7;

      if (widgetWeeksTitle) {
        if (weeks === 0 && remainingDays === 0) {
          widgetWeeksTitle.textContent = "Pregnancy not yet started";
        } else {
          widgetWeeksTitle.textContent = `You are ${weeks} weeks, ${remainingDays} day${remainingDays !== 1 ? 's' : ''} pregnant`;
        }
      }

      const currentWeek = Math.max(1, Math.min(40, weeks + 1));
      if (widgetGuideLink) {
        widgetGuideLink.href = `/week/${currentWeek}`;
        widgetGuideLink.textContent = `View Week ${currentWeek} Guide →`;
      }

      let trimesterVal = "First Trimester";
      if (weeks >= 28) trimesterVal = "Third Trimester";
      else if (weeks >= 13) trimesterVal = "Second Trimester";
      
      if (widgetTrimester) widgetTrimester.textContent = trimesterVal;
      if (widgetCountdown) widgetCountdown.textContent = `${daysRemaining} Day${daysRemaining !== 1 ? 's' : ''}`;
      
      const milestone = getNextMilestone(weeks);
      if (widgetMilestone) widgetMilestone.textContent = milestone.text;

      if (widget) widget.style.display = 'block';
    } catch (e) {
      console.error(e);
      if (widget) widget.style.display = 'none';
    }
  }

  // Listen for updates from the calculator component
  document.addEventListener('pregnancy-updated', () => {
    updateWidget();
  });

  document.addEventListener('pregnancy-reset', () => {
    if (widget) widget.style.display = 'none';
  });

  // Run immediately on load
  updateWidget();
  document.addEventListener('DOMContentLoaded', () => {
    updateWidget();
  });
</script>

