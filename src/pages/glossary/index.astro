---
import Layout from '../../layouts/Layout.astro';
import { glossaryTerms } from '../../data/glossaryData';

// Sort alphabetically
const sortedTerms = [...glossaryTerms].sort((a, b) => a.term.localeCompare(b.term));
const categories = Array.from(new Set(glossaryTerms.map(t => t.category))).sort();
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<Layout 
  title="Pregnancy & Obstetrical Glossary | A-Z Pregnancy Terms | PregWeeks"
  description="Browse our comprehensive A-Z pregnancy and medical glossary. Search over 100 terms, meanings, and explanations in plain English."
>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Glossary</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Medical Dictionary</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-4 sm:text-4xl">
        Pregnancy Glossary
      </h1>
      <p class="text-base text-neutral-500 leading-relaxed">
        Understand the medical terminology used by your obstetrician, midwife, and healthcare team. Find clear, plain-English definitions for 100+ clinical terms.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Sidebar Filters -->
      <aside class="lg:col-span-1 space-y-6">
        <div class="bg-neutral-50 rounded-xl p-5 border border-neutral-200">
          <h2 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider mb-4 border-b border-neutral-200 pb-2">Categories</h2>
          
          <div class="space-y-2 max-h-64 overflow-y-auto pr-2">
            <label class="flex items-center space-x-2 text-xs text-neutral-700 cursor-pointer py-1 hover:text-neutral-900">
              <input 
                type="radio" 
                name="category-filter" 
                value="all" 
                checked
                class="category-radio rounded-full border-neutral-300 text-[#0066cc] focus:ring-[#0066cc] w-4 h-4"
              />
              <span>All Categories</span>
            </label>
            {categories.map(cat => (
              <label class="flex items-center space-x-2 text-xs text-neutral-700 cursor-pointer py-1 hover:text-neutral-900">
                <input 
                  type="radio" 
                  name="category-filter" 
                  value={cat.toLowerCase()} 
                  class="category-radio rounded-full border-neutral-300 text-[#0066cc] focus:ring-[#0066cc] w-4 h-4"
                />
                <span>{cat}</span>
              </label>
            ))}
          </div>
        </div>
      </aside>

      <!-- Right Search & Results Grid -->
      <section class="lg:col-span-3 space-y-6">
        <div class="space-y-4">
          <!-- Search input -->
          <div class="relative">
            <input 
              type="text" 
              id="glossary-search" 
              placeholder="Search medical terms or definitions (e.g. 'fluid', 'cervix', 'effacement')..." 
              class="w-full pl-4 pr-10 py-3 rounded-xl border border-neutral-300 text-sm text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
            />
            <span class="absolute right-3 top-3.5 text-neutral-400">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21-21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
              </svg>
            </span>
          </div>

          <!-- A-Z Alphabet bar -->
          <div class="flex flex-wrap gap-1 p-1.5 bg-neutral-100 rounded-lg overflow-x-auto">
            <button 
              type="button" 
              class="letter-btn active-letter bg-[#0066cc] text-white w-7 h-7 flex items-center justify-center rounded text-xs font-semibold hover:bg-[#0055b3] transition-colors"
              data-letter="all"
            >
              All
            </button>
            {alphabet.map(letter => (
              <button 
                type="button" 
                class="letter-btn bg-white hover:bg-neutral-50 text-neutral-700 w-7 h-7 flex items-center justify-center rounded text-xs font-semibold border border-neutral-200/50 transition-colors"
                data-letter={letter.toLowerCase()}
              >
                {letter}
              </button>
            ))}
          </div>
        </div>

        <!-- Meta status line -->
        <div class="flex justify-between items-center text-xs text-neutral-500 px-1 border-b border-neutral-200 pb-2">
          <div>Showing <span id="visible-count" class="font-semibold text-neutral-900">{sortedTerms.length}</span> terms</div>
          <button id="reset-filters" class="text-[#0066cc] hover:underline font-medium">Clear Search</button>
        </div>

        <!-- Terms grid list -->
        <div id="glossary-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {sortedTerms.map(t => (
            <a 
              href={`/glossary/${t.slug}`}
              class="term-card block bg-white border border-neutral-200 rounded-xl p-5 hover:border-neutral-300 transition-all active:scale-[0.98]"
              data-term={t.term.toLowerCase()}
              data-definition={t.definition.toLowerCase()}
              data-category={t.category.toLowerCase()}
              data-letter={t.term.charAt(0).toLowerCase()}
            >
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-base font-semibold text-neutral-900">{t.term}</h3>
                <span class="text-[9px] uppercase font-bold tracking-wider text-[#0066cc] bg-blue-50 px-2 py-0.5 rounded border border-blue-100">
                  {t.category}
                </span>
              </div>
              <p class="text-xs text-neutral-600 line-clamp-2 leading-relaxed">
                {t.definition}
              </p>
            </a>
          ))}
        </div>

        <!-- No Results -->
        <div id="no-results" class="hidden text-center py-16 bg-neutral-50 rounded-xl border border-dashed border-neutral-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 mx-auto text-neutral-300 mb-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <h3 class="text-sm font-semibold text-neutral-900 mb-1">No Terms Found</h3>
          <p class="text-xs text-neutral-500">Try adjusting your search criteria or category filter.</p>
        </div>
      </section>
    </div>
  </main>

  <script>
    const searchInput = document.getElementById('glossary-search') as HTMLInputElement;
    const categoryRadios = document.querySelectorAll('.category-radio') as NodeListOf<HTMLInputElement>;
    const letterBtns = document.querySelectorAll('.letter-btn');
    const resetBtn = document.getElementById('reset-filters');
    const termCards = document.querySelectorAll('.term-card') as NodeListOf<HTMLElement>;
    const visibleCountSpan = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');

    let currentCategory = 'all';
    let currentLetter = 'all';
    let searchQuery = '';

    function filterGlossary() {
      let visibleCount = 0;

      termCards.forEach(card => {
        const term = card.dataset.term || '';
        const definition = card.dataset.definition || '';
        const category = card.dataset.category || '';
        const letter = card.dataset.letter || '';

        const matchesSearch = searchQuery === '' || 
          term.includes(searchQuery) || 
          definition.includes(searchQuery);

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesLetter = currentLetter === 'all' || letter === currentLetter;

        if (matchesSearch && matchesCategory && matchesLetter) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountSpan) visibleCountSpan.textContent = visibleCount.toString();

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterGlossary();
      });
    }

    categoryRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          currentCategory = radio.value;
          filterGlossary();
        }
      });
    });

    letterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        letterBtns.forEach(b => {
          b.classList.remove('active-letter', 'bg-[#0066cc]', 'text-white');
          b.classList.add('bg-white', 'text-neutral-700');
        });
        btn.classList.add('active-letter', 'bg-[#0066cc]', 'text-white');
        btn.classList.remove('bg-white', 'text-neutral-700');

        currentLetter = btn.getAttribute('data-letter') || 'all';
        filterGlossary();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';

        categoryRadios.forEach(r => {
          r.checked = r.value === 'all';
        });
        currentCategory = 'all';

        letterBtns.forEach(b => {
          b.classList.remove('active-letter', 'bg-[#0066cc]', 'text-white');
          b.classList.add('bg-white', 'text-neutral-700');
        });
        const allLetterBtn = document.querySelector('[data-letter="all"]');
        if (allLetterBtn) {
          allLetterBtn.classList.add('active-letter', 'bg-[#0066cc]', 'text-white');
        }
        currentLetter = 'all';

        filterGlossary();
      });
    }
  </script>
</Layout>
