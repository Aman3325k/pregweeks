---
// src/pages/week/[week].astro
import Layout from '../../layouts/Layout.astro';
import { pregnancyData } from '../../data/pregnancyData';
import ContextualAffiliates from '../../components/ContextualAffiliates.astro';
import DigitalProductCheckout from '../../components/DigitalProductCheckout.astro';
import { symptomItems } from '../../data/symptomData';
import { foodItems } from '../../data/foodData';
import { getMedicalPageSchema, getBreadcrumbSchema, getFAQSchema } from '../../utils/seo';

// 1. Generate paths for all 40 weeks at compile time
export async function getStaticPaths() {
  return Array.from({ length: 40 }, (_, i) => {
    const week = String(i + 1);
    return {
      params: { week },
      props: { weekNum: i + 1 }
    };
  });
}

const { weekNum } = Astro.props;

// 2. Load the corresponding week data
const data = pregnancyData.find((d) => d.week === weekNum);
if (!data) {
  throw new Error(`Data not found for week ${weekNum}`);
}

// Imperial conversions
const cmToInches = (cm: number) => (cm * 0.393701).toFixed(1);
const gToOunces = (g: number) => {
  if (g < 1) return "< 0.1";
  return (g * 0.035274).toFixed(1);
};

const title = `Week ${weekNum} of Pregnancy: Fetal Size, Symptoms & Milestones | PregWeeks`;
const description = `Track Week ${weekNum} of pregnancy. Your baby is the size of a ${data.babySize.name} (${data.babySize.lengthCm} cm, ${data.babySize.weightG} g). Learn body changes, common symptoms, and key milestones.`;
const pageUrl = `https://pregweeks.com/week/${weekNum}`;

// 3. Construct 3 custom medical FAQs for this week dynamically
const faqItems = [
  {
    q: `How big is the baby in week ${weekNum} of pregnancy?`,
    a: weekNum <= 3
      ? `In week ${weekNum}, the baby is still in the microscopic stage (from zygote to blastocyst) and has not yet reached measurable size. Measurements begin in week 4.`
      : `In week ${weekNum}, your baby is approximately the size of a ${data.babySize.name}. The average length is ${data.babySize.lengthCm} cm (about ${cmToInches(data.babySize.lengthCm)} inches) from crown to rump (or head to heel starting in week 20), and the weight is roughly ${data.babySize.weightG} grams (${gToOunces(data.babySize.weightG)} ounces).`
  },
  {
    q: `What are the most common maternal symptoms in week ${weekNum}?`,
    a: data.symptoms.length > 0 
      ? `Typical symptoms during pregnancy week ${weekNum} include: ${data.symptoms.join(', ')}. These symptoms are caused by hormonal changes (such as progesterone and estrogen rises) preparing your body to nurture the growing fetus.`
      : `Common symptoms early on include mild abdominal changes and fatigue. At this stage, your body is quietly undergoing significant internal adjustments to prepare the uterine lining for embryonic implantation.`
  },
  {
    q: `What is the most important milestone or tip for week ${weekNum}?`,
    a: data.tips.length > 0 
      ? `The primary recommendation for week ${weekNum} is: ${data.tips[0]} Key milestones: ${data.milestones.join(' and ')}.`
      : `Keep taking your prenatal vitamins with folic acid, stay hydrated, and arrange your regular clinical prenatal checks.`
  }
];

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": `Week ${weekNum} of Pregnancy Guide`,
  "description": `An educational video guide detailing fetal development and maternal changes for pregnancy week ${weekNum}.`,
  "thumbnailUrl": `https://pregweeks.com/og-image/week-${weekNum}.svg`,
  "uploadDate": "2026-06-08T00:00:00Z",
  "contentUrl": `https://pregweeks.com/videos/week-${weekNum}.mp4`,
  "embedUrl": `https://pregweeks.com/videos/week-${weekNum}/embed`
};

// Combine SEO schemas
const pageSchemas = [
  getMedicalPageSchema(title, description, pageUrl),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: `Week ${weekNum}`, url: pageUrl }
  ]),
  getFAQSchema(faqItems),
  videoSchema
];

// Helper to determine Trimester Label and Slug
const getTrimesterLabel = (tri: number) => {
  if (tri === 1) return "First Trimester (Weeks 1 - 13)";
  if (tri === 2) return "Second Trimester (Weeks 14 - 27)";
  return "Third Trimester (Weeks 28 - 40)";
};

const trimesterSlug = data.trimester === 1 ? 'first' : data.trimester === 2 ? 'second' : 'third';
const trimesterGuideUrl = `/trimester/${trimesterSlug}`;
const trimesterGuideName = data.trimester === 1 ? 'First Trimester Guide' : data.trimester === 2 ? 'Second Trimester Guide' : 'Third Trimester Guide';

// Helper to verify if symptom matches the week
function isSymptomRelevant(symptomWeeks: string, week: number): boolean {
  const parts = symptomWeeks.split(',');
  for (const part of parts) {
    const clean = part.replace(/weeks?/i, '').trim();
    if (clean.includes('-')) {
      const [start, end] = clean.split('-').map(Number);
      if (week >= start && week <= end) return true;
    } else {
      const single = Number(clean);
      if (!isNaN(single) && single === week) return true;
    }
  }
  return false;
}

// 3 Related Symptoms
let relatedSymptoms = symptomItems.filter(s => isSymptomRelevant(s.weeks, weekNum)).slice(0, 3);
if (relatedSymptoms.length < 3) {
  const fallbackSlugs = ['cramping', 'fatigue', 'nausea'];
  const fallbacks = symptomItems.filter(s => fallbackSlugs.includes(s.slug) && !relatedSymptoms.some(rs => rs.slug === s.slug));
  relatedSymptoms = [...relatedSymptoms, ...fallbacks].slice(0, 3);
}

// 2 Related Food Safety Pages (rotating selection)
const safeFoods = foodItems.filter(f => f.status === 'safe');
const avoidFoods = foodItems.filter(f => f.status === 'avoid');
const relatedFoods = [
  safeFoods[weekNum % safeFoods.length],
  avoidFoods[weekNum % avoidFoods.length]
];

// Calculate visual SVG parameters (Max length: 51.2cm)
const svgSize = 140; // SVG ViewBox width/height
const maxCm = 52;
// Base radius: minimum 3px, max 60px
const baseRadius = data.babySize.lengthCm > 0
  ? Math.max(3, Math.min(60, (data.babySize.lengthCm / maxCm) * 60))
  : 0;

// Setup navigation links
const prevWeek = weekNum > 1 ? weekNum - 1 : null;
const nextWeek = weekNum < 40 ? weekNum + 1 : null;
---

<Layout 
  title={title} 
  description={description} 
  canonicalUrl={pageUrl} 
  ogImage={`https://pregweeks.com/og-image/week-${weekNum}.svg`}
  schemas={pageSchemas}
>
  {nextWeek && (
    <link rel="prefetch" href={`/week/${nextWeek}`} slot="head" />
  )}

  <!-- Sticky Table of Contents (Floating Desktop Only) -->
  <aside class="hidden xl:block fixed top-44 left-6 w-48 space-y-3 z-30 print:hidden">
    <div class="border border-hairline rounded-apple-lg p-4 bg-canvas-parchment/80 backdrop-blur-md">
      <h4 class="text-[10px] font-bold text-ink uppercase tracking-wider mb-3">On This Page</h4>
      <nav class="space-y-2">
        <a href="#size" class="toc-link block text-[11px] text-ink-muted-80 hover:text-primary font-medium transition-all border-l-2 border-transparent pl-2.5">Fetal Size</a>
        <a href="#development" class="toc-link block text-[11px] text-ink-muted-80 hover:text-primary font-medium transition-all border-l-2 border-transparent pl-2.5">Development</a>
        <a href="#symptoms" class="toc-link block text-[11px] text-ink-muted-80 hover:text-primary font-medium transition-all border-l-2 border-transparent pl-2.5">Body &amp; Symptoms</a>
        <a href="#resources" class="toc-link block text-[11px] text-ink-muted-80 hover:text-primary font-medium transition-all border-l-2 border-transparent pl-2.5">Health Guides</a>
        <a href="#faqs" class="toc-link block text-[11px] text-ink-muted-80 hover:text-primary font-medium transition-all border-l-2 border-transparent pl-2.5">FAQs</a>
      </nav>
    </div>
  </aside>

  <!-- Top Navigation Progress bar & Breadcrumbs -->
  <div class="bg-canvas border-b border-hairline py-3.5 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs md:text-sm text-ink-muted-80 font-medium">
      <!-- Visual Breadcrumbs -->
      <nav class="flex items-center space-x-1.5 text-xs text-ink-muted-80 print:hidden" aria-label="Breadcrumb">
         <a href="/" class="hover:text-primary transition-colors">Home</a>
         <span class="text-ink-muted-48">&gt;</span>
         <a href="/#weeks-directory" class="hover:text-primary transition-colors">Week Guides</a>
         <span class="text-ink-muted-48">&gt;</span>
         <span class="text-ink font-semibold">Week {weekNum}</span>
      </nav>
      
      <div class="flex items-center gap-4">
        <span class="font-semibold text-ink">{getTrimesterLabel(data.trimester)}</span>
        <span class="text-primary font-bold">Week {weekNum} of 40</span>
      </div>
    </div>
    <div class="max-w-[960px] mx-auto flex justify-between items-center text-[10px] text-ink-muted-48 mt-2.5">
      <span>Last reviewed by medical team: June 2026</span>
      <span>Evidence-Based Care Check</span>
    </div>
    <div class="max-w-[960px] mx-auto h-1 bg-canvas-parchment rounded-full mt-2.5 overflow-hidden">
      <div class="h-full bg-primary" style={`width: ${(weekNum / 40) * 100}%;`}></div>
    </div>
  </div>

  <!-- Tile 1: Size Hero Tile (Light Canvas) -->
  <section id="size" class="bg-canvas py-16 px-4 transition-colors scroll-mt-20">
    <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-2 items-center gap-12">
      <div class="flex flex-col items-start w-full">
        <span class="inline-block bg-primary/10 text-primary font-bold text-xs uppercase tracking-widest px-3 py-1 rounded-full mb-4">
          Fetal Size Comparison
        </span>
        <h1 class="font-display font-semibold text-4xl md:text-5xl text-ink leading-tight tracking-apple-tight mb-4">
          Week {weekNum} Size: {data.babySize.name}
        </h1>
        <p class="text-lg text-ink-muted-80 mb-6 leading-relaxed tracking-apple-dense">
          {data.babySize.visualDescription}
        </p>

        <!-- Monetization Placeholder: After First Paragraph Ad Slot -->
        <div class="ad-slot bg-neutral-50 border border-dashed border-neutral-200/50 rounded-lg text-center py-4 text-[10px] text-neutral-400 uppercase tracking-widest w-full my-4 hidden print:hidden" style="display: none;">
          ADVERTISEMENT
        </div>

        {data.babySize.lengthCm > 0 ? (
          <div class="grid grid-cols-2 gap-4 w-full mt-2">
            <div class="bg-canvas-parchment border border-hairline p-4 rounded-apple-lg">
              <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Length</span>
              <span class="text-xl font-bold text-primary">{data.babySize.lengthCm} cm</span>
              <span class="text-xs text-ink-muted-80 block">{cmToInches(data.babySize.lengthCm)} inches</span>
            </div>
            <div class="bg-canvas-parchment border border-hairline p-4 rounded-apple-lg">
              <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Weight</span>
              <span class="text-xl font-bold text-primary">{data.babySize.weightG} g</span>
              <span class="text-xs text-ink-muted-80 block">{gToOunces(data.babySize.weightG)} oz</span>
            </div>
          </div>
        ) : (
          <div class="bg-canvas-parchment border border-hairline p-4 rounded-apple-lg w-full text-center mt-2">
            <span class="text-sm text-ink-muted-80 font-medium">Fetal measurements will begin at Week 4 once organogenesis is underway.</span>
          </div>
        )}
      </div>

      <!-- Simple, Lightweight SVG Size Visualizer - Centered and full width on mobile -->
      <div class="flex flex-col items-center justify-center bg-canvas-parchment border border-hairline p-8 rounded-apple-lg shadow-none w-full">
        <h3 class="text-xs font-semibold uppercase text-ink-muted-48 tracking-wider mb-4">Relative Visual Scale</h3>
        <div class="w-[200px] h-[200px] rounded-full border border-dashed border-primary/20 flex items-center justify-center bg-canvas relative">
          {baseRadius > 0 ? (
            <svg class="w-full h-full max-w-[140px] max-h-[140px]" viewBox={`0 0 ${svgSize} ${svgSize}`}>
              <!-- Background comparison circle (Full pregnancy scale: Week 40 Pumpkin reference) -->
              <circle cx={svgSize / 2} cy={svgSize / 2} r="60" fill="none" stroke="#e0e0e0" stroke-width="1.5" stroke-dasharray="3,3" />
              <!-- Current baby size circle with signature single drop-shadow -->
              <circle 
                cx={svgSize / 2} 
                cy={svgSize / 2} 
                r={baseRadius} 
                fill="url(#primaryGrad)" 
                class="filter drop-shadow-[0px_4px_12px_rgba(0,102,204,0.3)]" 
              />
              <defs>
                <radialGradient id="primaryGrad" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ff7eb9" />
                  <stop offset="100%" stop-color="#e91e8c" />
                </radialGradient>
              </defs>
            </svg>
          ) : (
            <span class="text-3xl">✨</span>
          )}
        </div>
        <p class="text-[11px] text-ink-muted-48 mt-4 text-center leading-normal">
          Solid circle represents your baby's size. Dotted circle shows the full-term week 40 size threshold.
        </p>
      </div>
    </div>
    
    <!-- Contextual Commerce Affiliate Placement (Pillar 5) -->
    <div class="max-w-[960px] mx-auto mt-6">
      <ContextualAffiliates currentWeek={weekNum} />
    </div>
  </section>

  <!-- Tile 2: Baby's Development (Dark surface) -->
  <section id="development" class="bg-surface-tile-1 text-white py-16 px-4 transition-colors scroll-mt-20">
    <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
      <div class="md:col-span-3">
        <span class="text-xs uppercase tracking-widest font-bold text-primary-on-dark mb-2 block">Inside The Womb</span>
        <h2 class="font-display font-semibold text-3xl text-white mb-4 tracking-apple-tight">Baby's Development</h2>
        <p class="text-body-muted leading-relaxed text-[17px] mb-6">
          {data.babyDevelopment}
        </p>
      </div>
      
      <div class="md:col-span-2 bg-white/5 border border-white/10 rounded-apple-lg p-6">
        <h3 class="font-display font-semibold text-lg text-white mb-4 tracking-apple-tight">Weekly Milestones</h3>
        <ul class="space-y-3 text-sm text-body-muted">
          {data.milestones.map((milestone) => (
            <li class="flex gap-2 items-start">
              <span class="text-primary-on-dark font-bold">✦</span>
              <span>{milestone}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Tile 3: Mom's Body & Symptoms (Parchment Surface) -->
  <section id="symptoms" class="bg-canvas-parchment py-16 px-4 border-t border-b border-hairline transition-colors scroll-mt-20">
    <div class="max-w-[960px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div>
        <span class="text-xs uppercase tracking-widest font-bold text-primary mb-2 block">Maternal Health</span>
        <h2 class="font-display font-semibold text-3xl text-ink mb-4 tracking-apple-tight">Your Body & Symptoms</h2>
        <p class="text-ink-muted-80 leading-relaxed text-[17px] mb-6">
          {data.motherChanges}
        </p>
        
        <h3 class="font-display font-semibold text-base text-ink mb-3 tracking-apple-tight">Common Symptoms this Week</h3>
        <div class="flex flex-wrap gap-2">
          {data.symptoms.map((symptom) => (
            <span class="bg-canvas border border-hairline text-ink-muted-80 px-3 py-1.5 rounded-full text-xs font-semibold transition-colors hover:border-primary">
              {symptom}
            </span>
          ))}
        </div>
      </div>

      <div class="bg-canvas border border-hairline p-6 rounded-apple-lg flex flex-col gap-4">
        <h3 class="font-display font-semibold text-lg text-ink tracking-apple-tight border-b border-hairline pb-3">
          Doctor & Care Recommendations
        </h3>
        <ul class="space-y-3.5 text-sm text-ink-muted-80">
          {data.tips.map((tip) => (
            <li class="flex gap-3.5 items-start">
              <span class="text-[#81b29a] font-bold text-base">✓</span>
              <span class="leading-relaxed">{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Premium Digital Checklist Upsell (Pillar 5) -->
    <div class="max-w-[960px] mx-auto mt-10">
      <DigitalProductCheckout />
    </div>
  </section>

  <!-- Tile 3.5: Health Guides & Resources (Internal Linking) - stacked on mobile -->
  <section id="resources" class="bg-canvas py-16 px-4 border-t border-b border-hairline transition-colors scroll-mt-20">
    <div class="max-w-[960px] mx-auto">
      <h2 class="font-display font-semibold text-2xl md:text-3xl text-ink mb-6 tracking-apple-tight">Weekly Health Guides &amp; Resources</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Trimester Link -->
        <div class="bg-canvas-parchment border border-hairline p-5 rounded-apple-lg hover:border-primary/20 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Trimester Guide</span>
            <h3 class="font-semibold text-sm text-ink mt-1.5 mb-2">{trimesterGuideName}</h3>
            <p class="text-xs text-ink-muted-80 leading-relaxed">Read comprehensive clinical milestones, screening checklists, and developmental guidelines for this phase.</p>
          </div>
          <a href={trimesterGuideUrl} class="text-primary font-semibold text-xs mt-4 hover:underline block min-h-[44px] flex items-center">Explore Trimester &rarr;</a>
        </div>

        <!-- Symptoms Links -->
        <div class="bg-canvas-parchment border border-hairline p-5 rounded-apple-lg hover:border-primary/20 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Common Symptoms</span>
            <h3 class="font-semibold text-sm text-ink mt-1.5 mb-2">Track &amp; Relieve Symptoms</h3>
            <p class="text-xs text-ink-muted-80 leading-relaxed mb-3">Learn why symptoms occur, home remedies, and clinical indicators for this week:</p>
            <ul class="list-none text-xs text-primary font-medium space-y-1">
              {relatedSymptoms.map(s => (
                <li class="min-h-[44px] flex items-center border-b border-hairline/20 last:border-0"><a href={`/symptoms/${s.slug}`} class="hover:underline flex items-center w-full py-1">✦ {s.name} during Pregnancy</a></li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Food Safety Links -->
        <div class="bg-canvas-parchment border border-hairline p-5 rounded-apple-lg hover:border-primary/20 transition-all flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider font-semibold text-ink-muted-48 block">Pregnancy Nutrition</span>
            <h3 class="font-semibold text-sm text-ink mt-1.5 mb-2">Food Safety Checklists</h3>
            <p class="text-xs text-ink-muted-80 leading-relaxed mb-3">Verify safety statuses, listeria and mercury risks, and safe alternatives for:</p>
            <ul class="list-none text-xs text-primary font-medium space-y-1">
              {relatedFoods.map(f => (
                <li class="min-h-[44px] flex items-center border-b border-hairline/20 last:border-0"><a href={`/food/${f.slug}`} class="hover:underline flex items-center w-full py-1">✦ {f.name} (Safety status: {f.status})</a></li>
              ))}
            </ul>
          </div>
          <a href="/nutrition" class="text-primary font-semibold text-xs mt-4 hover:underline block min-h-[44px] flex items-center">Full Nutrition Guide &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tile 4: FAQ Accordion Section (Light Canvas) -->
  <section id="faqs" class="bg-canvas py-16 px-4 transition-colors scroll-mt-20">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-display font-semibold text-2xl md:text-3xl text-center text-ink mb-8 tracking-apple-tight">
        Frequently Asked Questions: Week {weekNum}
      </h2>
      
      <div class="space-y-4 w-full">
        {faqItems.map((faq, index) => (
          <div class="faq-item border border-hairline rounded-apple-lg bg-canvas-parchment overflow-hidden transition-colors">
            <button 
              class="faq-trigger w-full min-h-[48px] px-5 py-3.5 flex justify-between items-center text-left font-semibold text-sm md:text-base text-ink hover:text-primary transition-colors cursor-pointer focus:outline-none"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
            >
              <span class="flex gap-2">
                <span class="text-primary">Q:</span>
                <span>{faq.q}</span>
              </span>
              <svg class="faq-chevron w-4 h-4 text-ink-muted-80 transform transition-transform duration-200 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div 
              id={`faq-answer-${index}`} 
              class="faq-content hidden px-5 pb-5 pt-1 border-t border-hairline"
            >
              <p class="text-xs md:text-sm text-ink-muted-80 leading-relaxed pl-5 border-l border-primary/20">
                {faq.a}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Email Capture Banner (Engagement Feature) -->
  <section class="bg-canvas py-12 px-4 border-t border-hairline transition-colors print:hidden">
    <div class="max-w-[600px] mx-auto bg-canvas-parchment border border-hairline rounded-apple-lg p-6 md:p-8 text-center flex flex-col items-center gap-4">
      <span class="text-2xl">💌</span>
      <h3 class="font-display font-semibold text-xl text-ink tracking-apple-tight">Get weekly pregnancy updates</h3>
      <p class="text-xs text-ink-muted-80 leading-relaxed max-w-sm">
        Sign up to receive developmental milestones, medical symptoms, and expert tips tailored to your specific week of pregnancy.
      </p>
      <form action="mailto:updates@pregweeks.com" method="GET" class="w-full flex flex-col sm:flex-row gap-2 mt-2">
        <input 
          type="email" 
          name="body" 
          placeholder="Enter your email address" 
          required 
          class="flex-1 p-2.5 border border-hairline rounded-apple-sm bg-canvas text-ink text-xs outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 min-h-[44px]"
        />
        <input type="hidden" name="subject" value={`PregWeeks Subscription - Week ${weekNum}`} />
        <button type="submit" class="bg-primary hover:bg-primary-focus text-white font-semibold py-2.5 px-5 rounded-apple-pill text-xs transition-all active:scale-95 cursor-pointer min-h-[44px]">
          Subscribe
        </button>
      </form>
    </div>
  </section>

  <!-- Pagination Bottom Navigation (Light Canvas) - side-by-side buttons row on mobile -->
  <section class="bg-canvas-parchment border-t border-hairline py-8 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto flex flex-col gap-4">
      <div class="flex items-center justify-between gap-4 w-full">
        {prevWeek ? (
          <a href={`/week/${prevWeek}`} class="flex-1 bg-canvas hover:bg-canvas-parchment text-primary border border-hairline font-semibold py-3 px-4 rounded-apple-pill text-center text-sm min-h-[44px] flex items-center justify-center transition-all active:scale-95">
            &larr; Week {prevWeek}
          </a>
        ) : (
          <span class="flex-1 bg-canvas opacity-40 text-ink-muted-48 border border-hairline font-semibold py-3 px-4 rounded-apple-pill text-center text-sm min-h-[44px] flex items-center justify-center select-none">&larr; Week 1</span>
        )}

        {nextWeek ? (
          <a href={`/week/${nextWeek}`} class="flex-1 bg-primary hover:bg-primary-focus text-white font-semibold py-3 px-4 rounded-apple-pill text-center text-sm min-h-[44px] flex items-center justify-center transition-all active:scale-95">
            Week {nextWeek} &rarr;
          </a>
        ) : (
          <span class="flex-1 bg-canvas opacity-40 text-ink-muted-48 border border-hairline font-semibold py-3 px-4 rounded-apple-pill text-center text-sm min-h-[44px] flex items-center justify-center select-none">Week 40 &rarr;</span>
        )}
      </div>
      <div class="text-center">
        <a href="/#weeks-directory" class="inline-block text-ink-muted-80 hover:text-ink text-sm py-2 min-h-[44px] flex items-center justify-center">
          All Weeks Grid
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Highlight active link in TOC
  const sections = document.querySelectorAll('section[id]');
  const tocLinks = document.querySelectorAll('.toc-link');

  window.addEventListener('scroll', () => {
    let currentId = '';
    sections.forEach(sec => {
      const top = (sec as HTMLElement).offsetTop - 150;
      if (window.pageYOffset >= top) {
        currentId = sec.getAttribute('id') || '';
      }
    });

    tocLinks.forEach(link => {
      link.classList.remove('border-primary', 'text-primary', 'font-semibold');
      link.classList.add('border-transparent', 'text-ink-muted-80');
      if (link.getAttribute('href') === `#${currentId}`) {
        link.classList.remove('border-transparent', 'text-ink-muted-80');
        link.classList.add('border-primary', 'text-primary', 'font-semibold');
      }
    });
  });

  // FAQ Accordion Toggle
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const trigger = item.querySelector('.faq-trigger');
    const content = item.querySelector('.faq-content');
    const chevron = item.querySelector('.faq-chevron');
    
    trigger?.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      if (isExpanded) {
        content?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      } else {
        content?.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>
