---
// src/pages/es/index.astro
import Layout from '../../layouts/Layout.astro';
import Calculator from '../../components/Calculator.astro';
import InstagramMilestone from '../../components/InstagramMilestone.astro';
import { getMedicalPageSchema, getBreadcrumbSchema } from '../../utils/seo';

const title = "PregWeeks.com | Guía de Embarazo Semana a Semana y Calculadora";
const description = "Sigue el crecimiento de tu bebé y tus hitos maternos con nuestra hermosa calculadora de embarazo semana a semana, herramientas y diario de síntomas.";
const url = "https://pregweeks.com/es";

// Setup page schemas
const siteSearchSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://pregweeks.com/es",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://pregweeks.com/es/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const topWeeks = [4, 5, 8, 12, 20, 24, 28, 36, 39, 40];
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Guías Principales de Semanas de Embarazo",
  "numberOfItems": topWeeks.length,
  "itemListElement": topWeeks.map((weekNum, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://pregweeks.com/week/${weekNum}` // Keep guides in English for now or point to es/week/ if built
  }))
};

const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Inicio", url: url }
  ]),
  siteSearchSchema,
  itemListSchema
];

const weeks = Array.from({ length: 40 }, (_, i) => i + 1);
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Anti-flicker style and state restoration inline head script -->
  <style slot="head" is:inline>
    #personalized-dashboard {
      display: none;
    }
    html.has-pregnancy-data #personalized-dashboard {
      display: block !important;
    }
    html.has-pregnancy-data #generic-welcome {
      display: none !important;
    }
  </style>

  <script slot="head" is:inline>
    (function() {
      try {
        // 1. Intercept URL share states
        const params = new URLSearchParams(window.location.search);
        const share = params.get('share');
        if (share) {
          let base64 = share.replace(/-/g, '+').replace(/_/g, '/');
          while (base64.length % 4) {
            base64 += '=';
          }
          const decoded = atob(base64);
          if (/^\d{4}-\d{2}-\d{2}$/.test(decoded)) {
            const time = Date.parse(decoded);
            if (!isNaN(time)) {
              localStorage.setItem('pregnancy_calc_v2', JSON.stringify({
                mode: 'edd',
                date: decoded
              }));
              // Clean URL
              const url = new URL(window.location.href);
              url.searchParams.delete('share');
              window.history.replaceState({}, '', url.pathname + url.search);
            }
          }
        }

        // 2. Class toggles
        const saved = localStorage.getItem('pregnancy_calc_v2');
        if (saved) {
          const data = JSON.parse(saved);
          if (data && data.date) {
            document.documentElement.classList.add('has-pregnancy-data');
            
            // Do calculations to store current week in window
            const inputDate = new Date(data.date);
            inputDate.setHours(12, 0, 0, 0);
            const now = new Date();
            now.setHours(12, 0, 0, 0);
            
            let gestationalDays = 0;
            if (data.mode === 'lmp') {
              gestationalDays = Math.round((now.getTime() - inputDate.getTime()) / (24 * 60 * 60 * 1000));
            } else if (data.mode === 'conception') {
              gestationalDays = Math.round((now.getTime() - inputDate.getTime()) / (24 * 60 * 60 * 1000)) + 14;
            } else {
              const daysUntilDue = Math.round((inputDate.getTime() - now.getTime()) / (24 * 60 * 60 * 1000));
              gestationalDays = 280 - daysUntilDue;
            }
            if (gestationalDays < 0) gestationalDays = 0;
            const weeks = Math.floor(gestationalDays / 7);
            const currentWeek = Math.max(1, Math.min(42, weeks + 1));
            
            window.__pregnancyWeek = currentWeek;
          }
        }
      } catch (e) {
        console.error('Zero-CLS Head Blocker failed:', e);
      }
    })();
  </script>

  <div id="generic-welcome">
    <!-- Section 1: Hero Tile (Light Canvas) -->
    <section class="bg-canvas py-16 md:py-24 px-4 transition-colors">
      <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 items-center gap-12">
        <div class="flex flex-col items-start max-w-xl">
          <span class="inline-block bg-primary/10 text-primary font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-full mb-6">
            Guía y Herramientas de Embarazo
          </span>
          <h1 class="font-display font-semibold text-[28px] md:text-5xl lg:text-6xl text-ink leading-tight tracking-apple-tight mb-6">
            Celebra cada paso de tu embarazo.
          </h1>
          <p class="text-[17px] md:text-lg text-ink-muted-80 leading-relaxed tracking-apple-dense mb-8">
            Guías detalladas semana a semana sobre el desarrollo de tu bebé, cambios en tu cuerpo y síntomas maternos. Sigue tu embarazo sin conexión con nuestra calculadora de fecha de parto, contador de patadas y temporizador de contracciones.
          </p>
          <a href="#calculator-widget" class="bg-primary hover:bg-primary-focus text-white font-semibold px-6 rounded-apple-pill transition-all active:scale-95 text-center cursor-pointer text-sm md:text-base shadow-none min-h-[44px] flex items-center justify-center w-full sm:w-auto">
            Calcular Fecha de Parto
          </a>
        </div>
        
        <div class="flex justify-center items-center">
          <img 
            src="/pregnancy-hero.webp" 
            alt="Ilustración artística abstracta de embarazo" 
            class="w-full max-w-[420px] h-auto rounded-apple-lg border border-hairline shadow-[3px_5px_30px_0px_rgba(0,0,0,0.22)] object-cover bg-canvas transition-colors duration-300" 
            width="420"
            height="420"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>
  </div>

  <!-- Section 2: Calculator Widget (Parchment Surface) -->
  <section class="bg-canvas-parchment py-16 md:py-24 px-4 border-t border-b border-hairline transition-colors" id="calculator-widget">
    <div class="max-w-[1200px] mx-auto text-center mb-10">
      <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink mb-3 tracking-apple-tight">Seguimiento de Fecha de Parto</h2>
      <p class="text-ink-muted-80 max-w-lg mx-auto text-sm md:text-base">Ingresa tus fechas a continuación para calcular tu edad gestacional y fecha de parto.</p>
    </div>
    
    <!-- Homepage Pregnancy Tracker Widget (Engagement Feature) -->
    <div id="personalized-dashboard" class="max-w-2xl mx-auto mb-8 bg-canvas border border-hairline rounded-apple-lg p-6 text-left transition-all duration-300" style="display: none;">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-hairline pb-4 mb-4">
        <div>
          <span class="text-[10px] md:text-xs text-ink-muted-48 uppercase tracking-wider font-semibold block" id="widget-greeting">Estado de tu Embarazo</span>
          <h3 class="text-xl md:text-2xl font-bold text-primary mt-1" id="widget-weeks-title">Tienes -- semanas de embarazo</h3>
        </div>
        <a id="widget-guide-link" href="#" class="bg-primary hover:bg-primary-focus text-white text-xs font-semibold px-4 rounded-apple-pill transition-all active:scale-95 text-center min-h-[44px] flex items-center justify-center w-full sm:w-auto">
          Ver Guía de la Semana -- &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Trimestre</span>
          <span class="text-sm font-bold text-ink mt-0.5 block" id="widget-trimester">--</span>
        </div>
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Días para la Fecha de Parto</span>
          <span class="text-sm font-bold text-ink mt-0.5 block" id="widget-countdown">-- días</span>
        </div>
        <div class="bg-canvas-parchment p-3 rounded-apple-sm border border-hairline">
          <span class="text-[10px] text-ink-muted-48 uppercase tracking-wider font-semibold block">Próximo Hito</span>
          <span class="text-sm font-bold text-ink mt-0.5 block line-clamp-1" id="widget-milestone">--</span>
        </div>
      </div>
      
      <!-- Social Utilities Panel -->
      <div class="mt-4 pt-4 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
        <button 
          type="button" 
          id="btn-copy-share-url" 
          class="text-xs text-primary hover:text-primary-focus hover:underline font-semibold flex items-center gap-1.5 min-h-[44px] cursor-pointer"
        >
          🔗 Copiar Enlace de Progreso
        </button>
        <div class="w-full sm:w-auto">
          <InstagramMilestone />
        </div>
      </div>
    </div>

    <!-- Anti-flicker body script to populate content in Spanish before paint -->
    <script is:inline>
      (function() {
        if (window.__pregnancyWeek) {
          const cw = window.__pregnancyWeek;
          const greeting = document.getElementById('widget-greeting');
          if (greeting) {
            greeting.textContent = '¡Bienvenida a la Semana ' + cw + '! 🎉';
          }
          const guideLink = document.getElementById('widget-guide-link');
          if (guideLink) {
            guideLink.setAttribute('href', '/week/' + Math.min(40, cw));
            guideLink.textContent = 'Ver Guía de la Semana ' + Math.min(40, cw) + ' →';
          }
        }
      })();
    </script>

    <div class="max-w-2xl mx-auto">
      <Calculator />
    </div>
  </section>

  <!-- Section 3: Week-by-Week Directory Grid (Light Canvas) -->
  <section class="bg-canvas py-16 md:py-24 px-4 transition-colors" id="weeks-directory">
    <div class="max-w-[1200px] mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-display font-semibold text-3xl md:text-4xl text-ink mb-3 tracking-apple-tight">Directorio Semana a Semana</h2>
        <p class="text-ink-muted-80 max-w-lg mx-auto text-sm md:text-base">Haz clic en una semana para ver comparaciones de tamaño de tu bebé, desarrollo y consejos del médico.</p>
      </div>

      <!-- Trimester Sections -->
      <div class="flex flex-col gap-12">
        <!-- 1st Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-primary"></span>
            <h3 class="font-display font-semibold text-xl text-ink">Primer Trimestre (Semanas 1 - 13)</h3>
          </div>
          <div class="grid grid-cols-4 md:grid-cols-10 gap-3">
            {weeks.slice(0, 13).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-primary hover:bg-canvas transition-all active:scale-95 min-h-[44px]"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Sem</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 2nd Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-[#f2cc8f]"></span>
            <h3 class="font-display font-semibold text-xl text-ink">Segundo Trimestre (Semanas 14 - 27)</h3>
          </div>
          <div class="grid grid-cols-4 md:grid-cols-10 gap-3">
            {weeks.slice(13, 27).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-[#f2cc8f] hover:bg-canvas transition-all active:scale-95 min-h-[44px]"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Sem</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 3rd Trimester Grid -->
        <div class="border border-hairline p-6 md:p-8 rounded-apple-lg bg-canvas transition-colors">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-[#81b29a]"></span>
            <h3 class="font-display font-semibold text-xl text-ink">Tercer Trimestre (Semanas 28 - 40)</h3>
          </div>
          <div class="grid grid-cols-4 md:grid-cols-10 gap-3">
            {weeks.slice(27, 40).map((w) => (
              <a 
                href={`/week/${w}`} 
                class="aspect-square flex flex-col items-center justify-center border border-hairline rounded-apple-sm text-sm font-bold text-ink bg-canvas-parchment hover:border-[#81b29a] hover:bg-canvas transition-all active:scale-95 min-h-[44px]"
              >
                <span class="text-xs text-ink-muted-48 font-medium">Sem</span>
                <span class="text-base font-semibold">{w}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular links section -->
  <div id="popular-links-section" class="max-w-2xl mx-auto mb-8 bg-canvas border border-hairline rounded-apple-lg p-6 text-left transition-all duration-300 min-h-[140px] hidden">
    <h3 class="font-display font-semibold text-xs text-ink-muted-48 uppercase tracking-wider mb-3">Popular esta Semana</h3>
    <div id="popular-links-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href="/week/4" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 4</a>
      <a href="/week/8" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 8</a>
      <a href="/week/12" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 12</a>
      <a href="/week/20" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 20</a>
      <a href="/week/28" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 28</a>
      <a href="/week/36" class="popular-link bg-canvas-parchment p-3 rounded-apple-sm border border-hairline hover:border-primary transition-all text-xs font-semibold text-ink leading-tight block min-h-[44px] flex items-center">Guía de la Semana 36</a>
    </div>
  </div>

  <!-- Trust Banner -->
  <section class="bg-canvas-parchment py-16 px-4 border-t border-hairline transition-colors">
    <div class="max-w-[800px] mx-auto text-center flex flex-col items-center gap-6">
      <span class="text-3xl">🛡️</span>
      <h2 class="font-display font-semibold text-2xl md:text-3xl text-ink tracking-apple-tight">Información de Confianza, Revisada Médicamente</h2>
      <p class="text-ink-muted-80 text-sm md:text-base leading-relaxed">
        PregWeeks proporciona contenido científico revisado por expertos en embarazo y ginecólogos certificados. Estamos comprometidos con brindarte hechos claros, precisos y sin prejuicios durante esta etapa fundamental de tu familia.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { getPregnancyState, calculatePregnancyData } from '../../utils/pregnancyState';
  import { checkAndTriggerWeeklyNotification } from '../../utils/notifications';
  import { encodeState } from '../../utils/shareState';

  const widget = document.getElementById('personalized-dashboard');
  const widgetGreeting = document.getElementById('widget-greeting');
  const widgetWeeksTitle = document.getElementById('widget-weeks-title');
  const widgetGuideLink = document.getElementById('widget-guide-link') as HTMLAnchorElement;
  const widgetTrimester = document.getElementById('widget-trimester');
  const widgetCountdown = document.getElementById('widget-countdown');
  const widgetMilestone = document.getElementById('widget-milestone');
  const copyShareBtn = document.getElementById('btn-copy-share-url');

  if (copyShareBtn) {
    copyShareBtn.addEventListener('click', async () => {
      const state = getPregnancyState();
      if (!state) return;

      try {
        const { edd } = calculatePregnancyData(state.date, state.mode);
        const yyyy = edd.getFullYear();
        const mm = String(edd.getMonth() + 1).padStart(2, '0');
        const dd = String(edd.getDate()).padStart(2, '0');
        const eddStr = `${yyyy}-${mm}-${dd}`;

        const shareHash = encodeState(eddStr);
        const shareUrl = `${window.location.origin}/es/?share=${shareHash}`;

        await navigator.clipboard.writeText(shareUrl);

        const originalText = copyShareBtn.innerHTML;
        copyShareBtn.innerHTML = '✓ ¡Enlace Copiado!';
        copyShareBtn.classList.add('text-green-600', 'dark:text-green-400');

        setTimeout(() => {
          copyShareBtn.innerHTML = originalText;
          copyShareBtn.classList.remove('text-green-600', 'dark:text-green-400');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy share link:', e);
      }
    });
  }

  function getNextMilestoneES(weeksNum: number) {
    if (weeksNum < 12) return { text: "Ecografía T1 (Sem 12)", week: 12 };
    if (weeksNum < 20) return { text: "Ecografía de Anatomía (Sem 20)", week: 20 };
    if (weeksNum < 24) return { text: "Prueba de Glucosa (Sem 24)", week: 24 };
    if (weeksNum < 28) return { text: "Tercer Trimestre (Sem 28)", week: 28 };
    if (weeksNum < 36) return { text: "Prueba de EGB (Sem 36)", week: 36 };
    return { text: "¡Fecha de Parto / Nacimiento!", week: 40 };
  }

  function updateWidget() {
    const state = getPregnancyState();
    if (!state) {
      if (widget) {
        widget.style.display = 'none';
        document.documentElement.classList.remove('has-pregnancy-data');
      }
      return;
    }

    try {
      const { edd, weeks, days, daysRemaining, trimester, progressPercent } = calculatePregnancyData(state.date, state.mode);
      const currentWeek = Math.max(1, Math.min(40, weeks + 1));

      if (widgetGreeting) {
        widgetGreeting.textContent = `¡Bienvenida a la Semana ${currentWeek}! 🎉`;
      }

      if (widgetWeeksTitle) {
        if (weeks === 0 && days === 0) {
          widgetWeeksTitle.textContent = "El embarazo aún no ha comenzado";
        } else {
          widgetWeeksTitle.textContent = `Tienes ${weeks} semanas y ${days} día${days !== 1 ? 's' : ''} de embarazo`;
        }
      }

      if (widgetGuideLink) {
        widgetGuideLink.href = `/week/${currentWeek}`;
        widgetGuideLink.textContent = `Ver Guía de la Semana ${currentWeek} →`;
      }

      let trimesterLabelES = 'Primer Trimestre';
      if (weeks >= 28) trimesterLabelES = 'Tercer Trimestre';
      else if (weeks >= 13) trimesterLabelES = 'Segundo Trimestre';

      if (widgetTrimester) widgetTrimester.textContent = trimesterLabelES;
      
      if (widgetCountdown) {
        const unitText = daysRemaining === 1 ? 'día' : 'días';
        widgetCountdown.textContent = `${daysRemaining} ${unitText}`;
      }

      const milestone = getNextMilestoneES(weeks);
      if (widgetMilestone) widgetMilestone.textContent = milestone.text;

      // Update state class to display widget layout stably
      document.documentElement.classList.add('has-pregnancy-data');
      if (widget) widget.style.display = 'block';

      // Update Popular Links Section in Spanish dynamically
      const popularSection = document.getElementById('popular-links-section');
      const popularGrid = document.getElementById('popular-links-grid');
      
      if (popularSection) popularSection.classList.remove('hidden');

      if (popularGrid && currentWeek >= 1 && currentWeek <= 40) {
        let trimesterSlug = 'first';
        let trimesterNameES = 'Primer Trimestre';
        let symptomNameES = 'Náuseas Matutinas';
        let symptomSlug = 'nausea';
        
        if (currentWeek >= 28) {
          trimesterSlug = 'third';
          trimesterNameES = 'Tercer Trimestre';
          symptomNameES = 'Braxton Hicks';
          symptomSlug = 'braxton-hicks';
        } else if (currentWeek >= 14) {
          trimesterSlug = 'second';
          trimesterNameES = 'Segundo Trimestre';
          symptomNameES = 'Dolor de Ligamento Redondo';
          symptomSlug = 'round-ligament-pain';
        }

        const nextWeekLink = currentWeek < 40 ? `/week/${currentWeek + 1}` : `/postpartum/1`;
        const nextWeekText = currentWeek < 40 ? `Guía de la Semana ${currentWeek + 1}` : `Guía del Posparto Semana 1`;

        const newLinks = [
          { href: `/week/${currentWeek}`, text: `Guía del Desarrollo Semana ${currentWeek}` },
          { href: `/partner/${currentWeek}`, text: `Guía de la Pareja Semana ${currentWeek}` },
          { href: `/trimester/${trimesterSlug}`, text: `Guía del ${trimesterNameES}` },
          { href: `/symptoms/${symptomSlug}`, text: `Alivio de ${symptomNameES}` },
          { href: `/tools/weight-tracker`, text: `Gráfico de Control de Peso` },
          { href: nextWeekLink, text: nextWeekText }
        ];

        const linkEls = popularGrid.querySelectorAll('.popular-link');
        newLinks.forEach((linkData, idx) => {
          if (linkEls[idx]) {
            linkEls[idx].setAttribute('href', linkData.href);
            linkEls[idx].textContent = linkData.text;
          }
        });
      }

      // Check and trigger local weekly notification
      checkAndTriggerWeeklyNotification();

    } catch (e) {
      console.error('Error updating Spanish dashboard:', e);
      if (widget) {
        widget.style.display = 'none';
        document.documentElement.classList.remove('has-pregnancy-data');
      }
    }
  }

  document.addEventListener('pregnancy-updated', () => {
    updateWidget();
  });

  document.addEventListener('pregnancy-reset', () => {
    if (widget) {
      widget.style.display = 'none';
      document.documentElement.classList.remove('has-pregnancy-data');
    }
    const popularSection = document.getElementById('popular-links-section');
    if (popularSection) popularSection.classList.add('hidden');
  });

  // Run immediately on load
  updateWidget();
  document.addEventListener('DOMContentLoaded', () => {
    updateWidget();
  });
</script>
