---
// src/pages/checklist/hospital-bag.astro
import Layout from '../../layouts/Layout.astro';
import { getMedicalPageSchema, getBreadcrumbSchema } from '../../utils/seo';

const title = "Ultimate Pregnancy Hospital Bag Checklist: What to Pack | PregWeeks";
const description = "Pack your hospital bag with confidence. Use our interactive, printable checklist to track essentials for mom, baby, and partner. Persists offline.";
const url = "https://pregweeks.com/checklist/hospital-bag";

const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: "Checklists", url: "https://pregweeks.com/checklist/hospital-bag" },
    { name: "Hospital Bag Checklist", url: url }
  ])
];

// Define checklist sections and items
const checklistData = [
  {
    category: "For Mom",
    icon: "👩",
    items: [
      { id: "mom_docs", label: "Photo ID, insurance card, medical records, and birth plan copies" },
      { id: "mom_robes", label: "2-3 comfortable, loose nightgowns or robes (button-down for breastfeeding)" },
      { id: "mom_toiletries", label: "Toiletries (toothbrush, toothpaste, lip balm, hair ties, body wash)" },
      { id: "mom_socks", label: "Non-skid socks or slippers (for walking the labor halls)" },
      { id: "mom_underwear", label: "Comfortable postpartum underwear (mesh or high-waisted cotton)" },
      { id: "mom_pads", label: "Maternity pads (heavy-duty pads or postpartum diapers)" },
      { id: "mom_bras", label: "2 nursing bras (comfortable, no underwires) and nursing pads" },
      { id: "mom_outfit", label: "Going-home outfit (loose, soft, comfortable clothing)" }
    ]
  },
  {
    category: "For Baby",
    icon: "👶",
    items: [
      { id: "baby_carseat", label: "Infant car seat (installed in the vehicle beforehand)" },
      { id: "baby_outfits", label: "2 going-home outfits (newborn size and 0-3 month size)" },
      { id: "baby_blanket", label: "Receiving blanket or warm swaddle wrap" },
      { id: "baby_hat", label: "Newborn hat, socks, and scratch mittens" },
      { id: "baby_wipes", label: "Gentle baby wipes and a few diapers (if preferring organic brands)" },
      { id: "baby_pediatrician", label: "Pediatrician contact card and details" }
    ]
  },
  {
    category: "For Partner & Support",
    icon: "🧑‍🤝‍🧑",
    items: [
      { id: "partner_chargers", label: "Phone chargers with extra-long cords (plugs can be far)" },
      { id: "partner_clothes", label: "2-3 changes of clothes, sleepwear, and basic toiletries" },
      { id: "partner_pillow", label: "Pillow and comfortable blanket (hospital sleeping cot can be thin)" },
      { id: "partner_snacks", label: "Snacks, energy bars, and refillable water bottles" },
      { id: "partner_camera", label: "Camera or video equipment (and chargers/batteries)" }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Header Breadcrumb -->
  <div class="bg-canvas border-b border-hairline py-3 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto text-xs md:text-sm text-ink-muted-80 font-medium">
      <a href="/" class="text-primary hover:underline">Home</a>
      <span class="mx-2 text-hairline">/</span>
      <span class="text-ink-muted-48">Checklists</span>
      <span class="mx-2 text-hairline">/</span>
      <span class="text-ink">Hospital Bag Checklist</span>
    </div>
  </div>

  <!-- Hero Title (Light Canvas) -->
  <section class="bg-canvas py-12 px-4 transition-colors print:py-4">
    <div class="max-w-[720px] mx-auto text-center mb-8 print:mb-4">
      <span class="text-3xl mb-3 block print:hidden">🎒</span>
      <h1 class="font-display font-semibold text-3xl md:text-4xl text-ink tracking-apple-tight mb-4">
        Hospital Bag Checklist
      </h1>
      <p class="text-base md:text-lg text-ink-muted-80 leading-relaxed tracking-apple-dense print:hidden">
        We recommend packing your bags by Week 36 or 37 so you are completely prepared for labor. Print or track items interactively.
      </p>
    </div>
  </section>

  <!-- Sticky Progress Bar Tile (Parchment Surface) -->
  <section class="bg-canvas-parchment py-6 px-4 border-t border-b border-hairline sticky top-[52px] z-30 transition-colors print:hidden">
    <div class="max-w-[720px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold uppercase text-ink-muted-48 tracking-wider">Bags Packed:</span>
        <span class="text-base font-bold text-primary" id="progress-text">0 / 19 Items (0%)</span>
      </div>
      <div class="w-full sm:max-w-[300px] h-2 bg-canvas border border-hairline rounded-full overflow-hidden">
        <div id="progress-fill" class="h-full bg-primary rounded-full transition-all duration-300" style="width: 0%;"></div>
      </div>
      <button onclick="window.print()" class="text-xs border border-hairline text-ink-muted-80 hover:text-ink hover:border-ink font-semibold py-1.5 px-4 rounded-apple-pill cursor-pointer transition-colors">
        Print Checklist
      </button>
    </div>
  </section>

  <!-- Checklist Lists (Light Canvas) -->
  <section class="bg-canvas py-12 px-4 transition-colors print:py-4">
    <div class="max-w-[720px] mx-auto flex flex-col gap-12 print:gap-6">
      {checklistData.map((section) => (
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2.5 border-b border-hairline pb-2">
            <span class="text-xl">{section.icon}</span>
            <h2 class="font-display font-semibold text-xl md:text-2xl text-ink tracking-apple-tight">{section.category}</h2>
          </div>
          
          <div class="flex flex-col gap-3">
            {section.items.map((item) => (
              <label 
                for={item.id} 
                class="flex items-start gap-4 p-4 border border-hairline rounded-apple-sm bg-canvas-parchment/30 hover:bg-canvas-parchment/60 transition-colors cursor-pointer select-none"
              >
                <!-- Custom styling for checkboxes -->
                <input 
                  type="checkbox" 
                  id={item.id} 
                  class="hospital-checkbox mt-1 w-4 h-4 rounded border-hairline text-primary focus:ring-primary cursor-pointer accent-primary" 
                />
                <span class="text-sm md:text-base text-ink leading-relaxed" id={`lbl-${item.id}`}>{item.label}</span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Printable Footer info -->
  <section class="hidden print:block max-w-[720px] mx-auto py-8 border-t border-hairline text-xs text-ink-muted-80 text-center">
    PregWeeks.com &copy; {new Date().getFullYear()} | Safe & Trusted Pregnancy Guides
  </section>
</Layout>

<script>
  const checkboxes = document.querySelectorAll('.hospital-checkbox') as NodeListOf<HTMLInputElement>;
  const progressText = document.getElementById('progress-text');
  const progressFill = document.getElementById('progress-fill');

  document.addEventListener('DOMContentLoaded', () => {
    loadChecklistState();
    updateProgress();

    // Listen to changes
    checkboxes.forEach(box => {
      box.addEventListener('change', () => {
        saveChecklistState();
        updateProgress();
      });
    });
  });

  function getStoredState(): string[] {
    const raw = localStorage.getItem('pregnancy_hospital_bag_v1');
    return raw ? JSON.parse(raw) : [];
  }

  function saveStoredState(checkedIds: string[]) {
    localStorage.setItem('pregnancy_hospital_bag_v1', JSON.stringify(checkedIds));
  }

  function loadChecklistState() {
    const checkedIds = getStoredState();
    checkboxes.forEach(box => {
      if (checkedIds.includes(box.id)) {
        box.checked = true;
        document.getElementById(`lbl-${box.id}`)?.classList.add('line-through', 'text-ink-muted-48');
      } else {
        box.checked = false;
        document.getElementById(`lbl-${box.id}`)?.classList.remove('line-through', 'text-ink-muted-48');
      }
    });
  }

  function saveChecklistState() {
    const checkedIds: string[] = [];
    checkboxes.forEach(box => {
      if (box.checked) {
        checkedIds.push(box.id);
        document.getElementById(`lbl-${box.id}`)?.classList.add('line-through', 'text-ink-muted-48');
      } else {
        document.getElementById(`lbl-${box.id}`)?.classList.remove('line-through', 'text-ink-muted-48');
      }
    });
    saveStoredState(checkedIds);
  }

  function updateProgress() {
    if (!progressText || !progressFill) return;
    
    const total = checkboxes.length;
    let checked = 0;
    checkboxes.forEach(box => {
      if (box.checked) checked++;
    });

    const percent = total > 0 ? Math.round((checked / total) * 100) : 0;
    progressText.textContent = `${checked} / ${total} Items (${percent}%)`;
    progressFill.style.width = `${percent}%`;
  }
</script>
