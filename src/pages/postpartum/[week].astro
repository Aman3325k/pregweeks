---
// src/pages/postpartum/[week].astro
import Layout from '../../layouts/Layout.astro';
import { postpartumWeeks } from '../../data/postpartumData';
import { getBreadcrumbSchema, getFAQSchema, getMedicalPageSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return postpartumWeeks.map((item) => ({
    params: { week: item.week.toString() },
    props: { item }
  }));
}

const { item } = Astro.props;
const { week, physical, emotional, baby } = item;

const title = `Week ${week} Postpartum Recovery Guide | Fourth Trimester | PregWeeks`;
const description = `Read the week ${week} postpartum guide covering perineal care, C-section recovery, sleep deprivation, baby feeding cycles, and emotional health.`;
const canonicalUrl = `https://pregweeks.com/postpartum/${week}`;

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Postpartum Guide", url: "https://pregweeks.com/postpartum" },
  { name: `Week ${week}`, url: canonicalUrl }
]);

const faqs = [
  {
    q: `What physical healing happens in postpartum Week ${week}?`,
    a: physical
  },
  {
    q: `How can I manage my mental health during postpartum Week ${week}?`,
    a: emotional
  },
  {
    q: `What is standard newborn behavior in Week ${week} postpartum?`,
    a: baby
  }
];

const medicalSchema = getMedicalPageSchema(title, description, canonicalUrl);
const faqSchema = getFAQSchema(faqs);

const prevWeek = week > 1 ? week - 1 : null;
const nextWeek = week < 12 ? week + 1 : null;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schemas={[breadcrumbs, medicalSchema, faqSchema]}>
  <div class="max-w-[760px] mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="text-[12px] text-ink-muted-48 mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/postpartum" class="hover:text-primary transition-colors">Postpartum Guide</a>
      <span>&rsaquo;</span>
      <span class="text-ink font-medium">Week {week}</span>
    </nav>

    <!-- Content Card -->
    <article class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors flex flex-col gap-6">
      
      <!-- Header -->
      <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-hairline pb-5">
        <div>
          <span class="text-[10px] md:text-xs font-semibold text-ink-muted-48 uppercase tracking-wider">Postpartum Week {week}</span>
          <h1 class="text-2xl md:text-4xl font-display font-semibold tracking-apple-tight mt-1">Maternal & Infant Recovery</h1>
        </div>

        <span class="self-start sm:self-center bg-primary/10 text-primary font-semibold text-xs px-4 py-2 rounded-full">
          4th Trimester
        </span>
      </div>

      <!-- Column: Physical Healing -->
      <div class="flex gap-4 items-start">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">🩺</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink">Physical Healing</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {physical}
          </p>
        </div>
      </div>

      <!-- Column: Emotional Health -->
      <div class="flex gap-4 items-start border-t border-hairline/60 pt-5">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">🤍</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink font-display">Emotional Wellness</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {emotional}
          </p>
        </div>
      </div>

      <!-- Column: Baby Development -->
      <div class="flex gap-4 items-start border-t border-hairline/60 pt-5">
        <span class="text-2xl p-2 bg-canvas-parchment rounded-apple-sm shrink-0">🍼</span>
        <div class="flex flex-col gap-1">
          <h2 class="font-semibold text-sm md:text-base text-ink font-display">Your Baby This Week</h2>
          <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed">
            {baby}
          </p>
        </div>
      </div>

    </article>

    <!-- FAQs section -->
    <section class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors">
      <h2 class="text-xl md:text-2xl font-display font-semibold mb-6 text-ink tracking-apple-tight">Week {week} Recovery FAQs</h2>
      <div class="flex flex-col gap-5">
        {faqs.map((faq, index) => (
          <div class="flex flex-col gap-1.5 border-b border-hairline/60 pb-4 last:border-0 last:pb-0">
            <h3 class="font-semibold text-sm md:text-base text-ink flex items-start gap-2">
              <span class="text-primary font-bold">Q{index + 1}:</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-ink-muted-80 text-xs md:text-sm pl-7 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Medical Review Banner -->
    <div class="border-t border-hairline pt-6 mt-8 mb-8 text-center text-xs text-ink-muted-48">
      <span>Sourced from ACOG/WHO/CDC guidelines â€¢ Updated June 2026</span>
    </div>

    <!-- Navigation Footer -->
    <div class="flex justify-between items-center text-sm md:text-base">
      {prevWeek ? (
        <a href={`/postpartum/${prevWeek}`} class="text-primary font-semibold hover:underline flex items-center gap-1">
          <span>&larr;</span> Week {prevWeek}
        </a>
      ) : (
        <a href="/postpartum" class="text-ink-muted-48 hover:text-primary transition-colors font-medium">Dashboard</a>
      )}

      <a href="/postpartum" class="hidden sm:inline-block text-ink-muted-80 hover:text-primary transition-colors font-medium">
        All Recovery Weeks
      </a>

      {nextWeek ? (
        <a href={`/postpartum/${nextWeek}`} class="text-primary font-semibold hover:underline flex items-center gap-1">
          Week {nextWeek} <span>&rarr;</span>
        </a>
      ) : (
        <span class="text-ink-muted-48 font-medium">12 Weeks Complete! 🎉</span>
      )}
    </div>
  </div>
</Layout>
