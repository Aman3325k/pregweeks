---
// src/pages/faq.astro
import Layout from '../layouts/Layout.astro';
import { getMedicalPageSchema, getBreadcrumbSchema, getFAQSchema } from '../utils/seo';

const title = "Pregnancy FAQ: Expert Answers to 20+ Questions | PregWeeks";
const description = "Find trusted answers to 20+ common pregnancy questions about safety, exercise, caffeine, morning sickness, contractions, and labor signs.";
const url = "https://pregweeks.com/faq";

// Define 21 FAQ questions grouped by categories
const categories = [
  {
    name: "Safety & Lifestyle",
    icon: "🧘",
    faqs: [
      { q: "Is it safe to drink coffee or caffeine during pregnancy?", a: "Yes, in moderation. Medically, it is recommended to limit caffeine intake to less than 200 mg per day (roughly one 12-ounce cup of brewed coffee). High caffeine intake is linked to increased risks of low birth weight." },
      { q: "Can I exercise while pregnant?", a: "Yes, moderate exercise is highly beneficial. Activities like walking, swimming, and prenatal yoga are safe and recommended. Avoid contact sports, high-impact activities, or lying flat on your back after the first trimester. Always consult your doctor before beginning an exercise regimen." },
      { q: "Is it safe to dye my hair?", a: "Most research indicates that hair treatments are safe during pregnancy as very little chemical is absorbed by the scalp. Many OB-GYNs recommend waiting until the second trimester as a precaution." },
      { q: "Can I travel by airplane while pregnant?", a: "For uncomplicated pregnancies, flying is generally safe up to 36 weeks of gestation. Make sure to walk in the aisles every 1-2 hours to prevent deep vein thrombosis (DVT) and stay hydrated." },
      { q: "Should I sleep on my back during pregnancy?", a: "After Week 20, it is recommended to sleep on your side (preferably left side) instead of your back. Lying on your back compresses the vena cava (a major blood vessel), reducing blood flow to the uterus and baby." },
      { q: "Is it safe to take hot baths or use hot tubs?", a: "Avoid hot tubs, saunas, or extremely hot baths that raise your core body temperature above 101&deg;F (38.3&deg;C). High body temperature, especially in the first trimester, is linked to neural tube defects." },
      { q: "Can I eat sushi or seafood during pregnancy?", a: "Raw fish (sushi, sashimi) carries risks of parasitic infections. Avoid raw fish, raw oysters, and high-mercury fish (shark, swordfish, king mackerel). However, fully cooked low-mercury fish (salmon, cod, shrimp) is highly recommended for Omega-3s." }
    ]
  },
  {
    name: "Symptoms & Body Changes",
    icon: "⚡",
    faqs: [
      { q: "What causes morning sickness and when does it end?", a: "Morning sickness is triggered by surging pregnancy hormones (hCG and progesterone). It typically peaks between Weeks 8 and 10 and resolves for most women around Weeks 12 to 14 (start of the second trimester)." },
      { q: "Is mild cramping normal in early pregnancy?", a: "Yes, mild cramping similar to menstrual cramps is common as your uterus begins to stretch and grow. However, severe, sharp pain, or cramping accompanied by vaginal bleeding requires immediate clinical evaluation." },
      { q: "When will I feel my baby move?", a: "First-time mothers typically feel movements (quickening) between Weeks 18 and 22. If you have been pregnant before, you may notice movements as early as Week 16. The early sensations often feel like bubbles or butterflies." },
      { q: "What is round ligament pain?", a: "It is a sharp, sudden cramp on one or both sides of the lower abdomen or groin. It is caused by the stretching of ligaments that support the growing uterus and is common during the second trimester." },
      { q: "Why am I experiencing shortness of breath?", a: "In early pregnancy, progesterone increases respiration rate. In late pregnancy (third trimester), your growing uterus pushes up against your diaphragm, compressing your lungs. It is normal and resolves when the baby drops." },
      { q: "Is light spotting normal during pregnancy?", a: "Light spotting (implantation bleeding) can occur in very early pregnancy (Week 3-4). However, any spotting or bleeding, particularly if bright red or accompanied by cramping, should be reported to your doctor immediately." },
      { q: "Why are my feet and ankles swelling?", a: "Known as edema, swelling in late pregnancy is caused by increased fluid retention and pressure from the growing uterus on veins returning blood from your lower limbs. Elevate your legs and stay hydrated." }
    ]
  },
  {
    name: "Labor & Birth Prep",
    icon: "🍼",
    faqs: [
      { q: "What is the difference between Braxton Hicks and real contractions?", a: "Braxton Hicks contractions are irregular, do not get closer together, and disappear when you walk or change positions. Real contractions are regular, get closer together, last longer, grow more intense, and do not stop with activity." },
      { q: "What is the 5-1-1 rule for labor?", a: "The 5-1-1 rule is a guidelines for when to go to the hospital: when contractions are 5 minutes apart (start to start), lasting 1 minute each, for at least 1 hour consistently." },
      { q: "What happens when your water breaks?", a: "Your water breaking is the rupture of the amniotic sac. It can feel like a sudden gush or a slow, constant trickle of clear fluid. If you suspect your water has broken, contact your doctor immediately." },
      { q: "What is the mucus plug and when do you lose it?", a: "The mucus plug is a gelatinous barrier sealing the cervix to prevent infection. Losing it (sometimes called 'bloody show') can happen days or weeks before labor starts as the cervix begins to dilate." },
      { q: "When should I pack my hospital bag?", a: "It is recommended to have your hospital bag packed and resting by the door or in your car by Weeks 36 or 37 of pregnancy, in case labor begins unexpectedly." },
      { q: "What is an epidural and when can I get one?", a: "An epidural is regional anesthesia injected near the spinal cord to block pain during labor. You can generally request one once active labor has started, depending on your birth plan and hospital guidelines." },
      { q: "What is labor induction and why is it done?", a: "Induction is the artificial stimulation of contractions before labor begins on its own. It is recommended for medical reasons (like preeclampsia or going post-term past 41-42 weeks) to protect the health of mother and baby." }
    ]
  }
];

// Flatten FAQs for the schema markup
const allFaqs = categories.flatMap(c => c.faqs);

const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: "FAQ", url: url }
  ]),
  getFAQSchema(allFaqs)
];
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Header Breadcrumb -->
  <div class="bg-canvas border-b border-hairline py-3 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto text-xs md:text-sm text-ink-muted-80 font-medium">
      <a href="/" class="text-primary hover:underline">Home</a>
      <span class="mx-2 text-hairline">/</span>
      <span class="text-ink">Pregnancy FAQs</span>
    </div>
  </div>

  <!-- Hero Tile (Light Canvas) -->
  <section class="bg-canvas py-12 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto text-center mb-8">
      <span class="text-3xl mb-3 block">❓</span>
      <h1 class="font-display font-semibold text-3xl md:text-4xl text-ink tracking-apple-tight mb-4">
        Pregnancy Frequently Asked Questions
      </h1>
      <p class="text-base md:text-lg text-ink-muted-80 leading-relaxed tracking-apple-dense">
        Trusted, medically-reviewed answers to 21 common questions about pregnancy lifestyle safety, body changes, and preparing for active labor.
      </p>
    </div>
  </section>

  <!-- FAQ Sections Tile (Parchment Surface) -->
  <section class="bg-canvas-parchment py-16 px-4 border-t border-b border-hairline transition-colors">
    <div class="max-w-[800px] mx-auto flex flex-col gap-12">
      {categories.map((cat) => (
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-2 border-b border-hairline pb-2">
            <span class="text-xl">{cat.icon}</span>
            <h2 class="font-display font-semibold text-xl md:text-2xl text-ink tracking-apple-tight">{cat.name}</h2>
          </div>
          
          <div class="flex flex-col gap-3">
            {cat.faqs.map((faq) => (
              <details class="group bg-canvas border border-hairline rounded-apple-sm overflow-hidden transition-all duration-300">
                <summary class="flex justify-between items-center p-5 font-semibold text-sm md:text-base text-ink cursor-pointer list-none select-none hover:bg-canvas-parchment/20">
                  <span>{faq.q}</span>
                  <span class="text-primary transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </summary>
                <div class="p-5 border-t border-hairline text-xs md:text-sm text-ink-muted-80 leading-relaxed bg-canvas-parchment/10">
                  {faq.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Medical Review Board Banner (Light Canvas) -->
  <section class="bg-canvas py-16 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto text-center flex flex-col items-center gap-4 bg-canvas-parchment border border-hairline p-8 rounded-apple-lg">
      <span class="text-3xl">🛡️</span>
      <h3 class="font-display font-semibold text-xl text-ink tracking-apple-tight">Clinical Review Commitment</h3>
      <p class="text-xs md:text-sm text-ink-muted-80 leading-relaxed max-w-lg">
        All FAQs and answers are curated and audited by the PregWeeks Medical Review Board to match current guidelines from the American College of Obstetricians and Gynecologists (ACOG). 
      </p>
      <p class="text-[11px] text-ink-muted-48 leading-relaxed max-w-lg mt-2">
        If you are experiencing severe cramping, active bleeding, fever, or vision issues, do not seek online answers. Call your health provider or emergency care services immediately.
      </p>
    </div>
  </section>
</Layout>
