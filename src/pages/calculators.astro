---
import Layout from '../layouts/Layout.astro';

const calculators = [
  {
    name: "Pregnancy Due Date Calculator",
    description: "Calculate your estimated due date (EDD) and current gestational age based on your last menstrual period (LMP) or conception date.",
    url: "/tools/due-date-calculator",
    emoji: "📅"
  },
  {
    name: "IVF Due Date Calculator",
    description: "Calculate your due date based on your IVF transfer date (3-day or 5-day embryo transfer) or egg retrieval date.",
    url: "/tools/ivf-calculator",
    emoji: "🧬"
  },
  {
    name: "Ovulation & Fertility Calculator",
    description: "Identify your estimated fertile window, peak fertility days, and next expected period. Includes an interactive visual calendar.",
    url: "/tools/ovulation-calculator",
    emoji: "🥚"
  },
  {
    name: "Pregnancy Weight Tracker",
    description: "Track your pregnancy weight gain progress. Compare it against clinical IOM recommendations and view it plotted on a custom graph.",
    url: "/tools/weight-tracker",
    emoji: "⚖️"
  },
  {
    name: "Fetal Kick Counter",
    description: "Monitor your baby's movements and track the time it takes to count 10 kicks to ensure fetal well-being.",
    url: "/tools/kick-counter",
    emoji: "👣"
  },
  {
    name: "Contraction Timer",
    description: "Log and track the duration and frequency of your labor contractions. Includes warnings based on the clinical 5-1-1 rule.",
    url: "/tools/contraction-timer",
    emoji: "⏱️"
  },
  {
    name: "Baby Cost Calculator",
    description: "Estimate your first-year baby expenses across nursery, strollers, clothing, feeding, and childcare categories with interactive sliders.",
    url: "/tools/baby-cost-calculator",
    emoji: "💵"
  },
  {
    name: "Chinese Gender Predictor",
    description: "Estimate your baby's gender using traditional Chinese gender calendar calendar charts and heart rate folklore indicators.",
    url: "/tools/gender-prediction",
    emoji: "🔮"
  }
];
---

<Layout 
  title="Pregnancy Calculators Hub | Due Date, IVF, Weight & Ovulation Trackers | PregWeeks"
  description="Access our suite of pregnancy calculators. Calculate your due date, track fetal kicks, log labor contractions, plot weight gain, and identify fertile windows."
>
  <main class="max-w-5xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Calculators</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Interactive Center</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-4 sm:text-4xl">
        Pregnancy Calculators Hub
      </h1>
      <p class="text-base text-neutral-500 leading-relaxed">
        Access our complete suite of interactive pregnancy calculators, tracking journals, timers, and estimators designed to support you through every stage.
      </p>
    </header>

    <!-- Calculators Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mb-12">
      {calculators.map(calc => (
        <a 
          href={calc.url}
          class="bg-white border border-neutral-200 rounded-2xl p-6 hover:border-neutral-300 transition-all active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="w-10 h-10 bg-neutral-50 rounded-xl flex items-center justify-center text-xl border border-neutral-200/50 mb-4">
              {calc.emoji}
            </div>
            <h2 class="text-base font-bold text-neutral-900 mb-2">{calc.name}</h2>
            <p class="text-xs text-neutral-600 leading-relaxed mb-6">
              {calc.description}
            </p>
          </div>
          <span class="text-xs font-semibold text-[#0066cc] hover:underline flex items-center space-x-1">
            <span>Launch Tool</span>
            <span>→</span>
          </span>
        </a>
      ))}
    </div>

    <!-- EEAT Disclaimer -->
    <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-5 text-xs text-neutral-500 leading-relaxed">
      <strong>Important Clinical Note:</strong> The calculators on this platform use standard medical models to deliver projections. They are designed for educational guidance and do not replace formal clinical assessments. Always confirm pregnancy milestones and due dates with your doctor.
    </div>
  </main>
</Layout>
