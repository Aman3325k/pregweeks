---
// src/pages/food/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { foodItems } from '../../data/foodData';
import { getBreadcrumbSchema, getFAQSchema, getMedicalPageSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return foodItems.map((food) => ({
    params: { slug: food.slug },
    props: { food }
  }));
}

const { food } = Astro.props;

const title = `Is ${food.name} Safe During Pregnancy? | PregWeeks`;
const description = `Find out if it is safe to eat ${food.name} during pregnancy. Learn about Listeria and mercury risk, safe alternatives, and clinical doctor tips.`;
const canonicalUrl = `https://pregweeks.com/food/${food.slug}`;

// Custom FAQs for the food page schema
const faqs = [
  {
    q: `Can I eat ${food.name} while pregnant?`,
    a: `Eating ${food.name} during pregnancy is classified as: ${food.status.toUpperCase()}. ${food.explanation}`
  },
  {
    q: `What are safe alternatives to ${food.name} during pregnancy?`,
    a: `Some excellent safe alternatives to ${food.name} include: ${food.alternatives}.`
  },
  {
    q: `What is the doctor's tip for ${food.name} during pregnancy?`,
    a: `${food.tip}`
  }
];

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Food Safety", url: "https://pregweeks.com/food-safety" },
  { name: food.name, url: canonicalUrl }
]);

const medicalSchema = getMedicalPageSchema(title, description, canonicalUrl);
const faqSchema = getFAQSchema(faqs);
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schemas={[breadcrumbs, medicalSchema, faqSchema]}>
  <div class="max-w-[760px] mx-auto px-4 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="text-[12px] text-ink-muted-48 mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/food-safety" class="hover:text-primary transition-colors">Food Safety</a>
      <span>&rsaquo;</span>
      <span class="text-ink font-medium truncate max-w-[200px]">{food.name}</span>
    </nav>

    <!-- Food Detail Card -->
    <article class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors flex flex-col gap-6">
      
      <!-- Title & Category Header -->
      <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-hairline pb-5">
        <div>
          <span class="text-[10px] md:text-xs font-semibold text-ink-muted-48 uppercase tracking-wider">{food.category}</span>
          <h1 class="text-2xl md:text-4xl font-display font-semibold tracking-apple-tight mt-1">{food.name}</h1>
        </div>
        
        <!-- Large Safety Badge -->
        <div class={`self-start sm:self-center text-center font-bold px-4 py-2 rounded-full text-xs md:text-sm uppercase tracking-widest ${
          food.status === 'safe' ? 'bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300' :
          food.status === 'moderate' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-950/40 dark:text-yellow-300' :
          'bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300'
        }`}>
          {food.status === 'safe' ? '🟢 Generally Safe' :
           food.status === 'moderate' ? '🟡 In Moderation' :
           '🔴 Avoid Entirely'}
        </div>
      </div>

      <!-- Main Clinical Verdict -->
      <div class="flex flex-col gap-3">
        <h2 class="text-lg md:text-xl font-display font-semibold text-ink tracking-apple-tight">Pregnancy Safety Verdict</h2>
        <p class="text-ink-muted-80 text-sm md:text-base leading-relaxed">
          {food.explanation}
        </p>
      </div>

      <!-- Quick Data Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
        <div class="bg-canvas-parchment p-5 rounded-apple-sm border border-hairline hover:border-primary/20 transition-all flex flex-col gap-1.5">
          <h3 class="text-xs text-ink-muted-48 uppercase tracking-wider font-semibold">Safe Alternatives</h3>
          <p class="text-sm text-ink-muted-80 leading-relaxed font-medium">
            {food.alternatives}
          </p>
        </div>
        
        <div class="bg-canvas-parchment p-5 rounded-apple-sm border border-hairline hover:border-primary/20 transition-all flex flex-col gap-1.5">
          <h3 class="text-xs text-ink-muted-48 uppercase tracking-wider font-semibold">OB-GYN Clinical Tip</h3>
          <p class="text-sm text-ink-muted-80 leading-relaxed font-medium">
            {food.tip}
          </p>
        </div>
      </div>

      <!-- Clinical Disclaimer Panel -->
      <div class="bg-primary/5 border border-primary/20 rounded-apple-sm p-4 text-[11px] md:text-xs text-ink-muted-80 flex flex-col gap-1 leading-relaxed mt-4">
        <span class="font-bold text-primary">⚠️ Medical Safety Note</span>
        Always wash fresh fruits and vegetables thoroughly, ensure meats and seafood are cooked to recommended internal temperatures, and verify that dairy products are fully pasteurized before consumption.
      </div>
    </article>

    <!-- FAQs section -->
    <section class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 mb-8 transition-colors">
      <h2 class="text-xl md:text-2xl font-display font-semibold mb-6 text-ink tracking-apple-tight">Pregnancy FAQs: {food.name}</h2>
      <div class="flex flex-col gap-5">
        {faqs.map((faq, index) => (
          <div class="flex flex-col gap-1.5 border-b border-hairline/60 pb-4 last:border-0 last:pb-0">
            <h3 class="font-semibold text-sm md:text-base text-ink flex items-start gap-2">
              <span class="text-primary font-bold">Q{index + 1}:</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-ink-muted-80 text-xs md:text-sm pl-7 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer Action -->
    <div class="flex justify-between items-center text-sm md:text-base">
      <a href="/food-safety" class="text-primary font-semibold hover:underline flex items-center gap-1.5">
        <span>&larr;</span> Back to Food Safety Database
      </a>
      <a href="/tools/due-date-calculator" class="text-ink hover:text-primary transition-colors font-medium">
        Track Your Due Date
      </a>
    </div>
  </div>
</Layout>
