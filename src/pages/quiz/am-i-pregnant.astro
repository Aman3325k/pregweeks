---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Am I Pregnant? Early Pregnancy Symptoms Quiz | PregWeeks"
  description="Take our interactive 10-question early pregnancy symptoms quiz. Evaluate your likelihood based on symptoms like missed periods, nausea, and fatigue."
>
  <main class="max-w-3xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <a href="/quiz/can-i-eat-this" class="hover:text-[#0066cc] transition-colors">Quizzes</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Am I Pregnant</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-xl mx-auto mb-8">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Symptom Quiz</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-3 sm:text-4xl">
        Am I Pregnant? Quiz
      </h1>
      <p class="text-sm text-neutral-500 leading-relaxed">
        Assess your early pregnancy symptoms and find out the likelihood of pregnancy with our clinical indicator quiz.
      </p>
    </header>

    <!-- Quiz Wrapper -->
    <div class="bg-white border border-neutral-200 rounded-2xl p-6 sm:p-8 shadow-none">
      
      <!-- Medical Disclaimer Banner -->
      <div class="bg-amber-50/50 border border-amber-200/70 text-[11px] text-amber-800 rounded-xl p-3.5 mb-6 leading-relaxed flex items-start space-x-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.008v.008H12v-.008Z" />
        </svg>
        <span>
          <strong>Important Disclaimer:</strong> This quiz is for informational and educational purposes only. It is not a medical diagnosis, pregnancy test, or substitute for professional medical counsel. Early pregnancy symptoms can overlap significantly with premenstrual syndrome (PMS) or cycle variations.
        </span>
      </div>

      <!-- Start screen -->
      <div id="start-screen" class="text-center py-8 space-y-5">
        <div class="w-12 h-12 rounded-full bg-blue-50 text-[#0066cc] flex items-center justify-center mx-auto">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div class="space-y-2 max-w-md mx-auto">
          <h2 class="text-lg font-semibold text-neutral-900">Assess Your Early Symptoms</h2>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Answer 10 short questions regarding your cycle status, body changes, and symptoms to evaluate your pregnancy likelihood score.
          </p>
        </div>
        <button 
          id="start-btn" 
          class="bg-[#0066cc] hover:bg-[#0055b3] text-white py-3 px-8 rounded-xl text-xs font-semibold tracking-wider uppercase transition-all active:scale-95"
        >
          Begin Quiz
        </button>
      </div>

      <!-- Quiz Questions (Hidden by default) -->
      <div id="quiz-container" class="hidden space-y-6">
        <!-- Progress Indicator -->
        <div class="flex justify-between items-center text-[10px] text-neutral-400 font-bold uppercase tracking-wider">
          <span id="progress-text">Question 1 of 10</span>
          <span id="progress-percent">10% Complete</span>
        </div>
        <!-- Progress Bar -->
        <div class="w-full bg-neutral-100 h-1.5 rounded-full overflow-hidden">
          <div id="progress-bar" class="bg-[#0066cc] h-full transition-all duration-300" style="width: 10%"></div>
        </div>

        <!-- Question Box -->
        <div class="space-y-4">
          <h3 id="question-text" class="text-base font-semibold text-neutral-900">
            <!-- Question will be injected here -->
          </h3>
          <div id="options-container" class="space-y-2">
            <!-- Options will be injected here -->
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex justify-between items-center border-t border-neutral-100 pt-5">
          <button 
            id="back-btn" 
            class="hidden text-xs text-neutral-500 hover:text-neutral-800 font-semibold py-2 transition-colors"
          >
            ← Back
          </button>
          <div class="ml-auto">
            <!-- Empty placeholder to push next button right -->
          </div>
        </div>
      </div>

      <!-- Result Screen (Hidden by default) -->
      <div id="result-screen" class="hidden text-center py-6 space-y-6">
        <div class="max-w-md mx-auto space-y-4">
          <span class="text-[10px] uppercase font-bold tracking-widest text-[#0066cc] bg-blue-50 px-3 py-1 rounded-full">Quiz Result</span>
          
          <h2 id="result-title" class="text-2xl font-bold text-neutral-900 mt-2">—</h2>
          
          <!-- Score Badge -->
          <div class="inline-block bg-neutral-50 border border-neutral-200 rounded-full px-5 py-2 text-xs font-medium text-neutral-600 mt-2">
            Clinical Indicator Score: <span id="result-score" class="font-bold text-neutral-900">—</span> / 32
          </div>

          <p id="result-description" class="text-xs text-neutral-600 leading-relaxed mt-4">
            <!-- Description goes here -->
          </p>
        </div>

        <!-- Next Steps Card -->
        <div class="bg-neutral-50 rounded-xl p-5 border border-neutral-200 text-left max-w-lg mx-auto">
          <h3 class="text-xs font-bold text-neutral-800 uppercase tracking-wider mb-2">Recommended Next Steps</h3>
          <ul id="result-steps" class="space-y-2 text-xs text-neutral-600 list-disc list-inside">
            <!-- Steps go here -->
          </ul>
        </div>

        <!-- Footer actions -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-3 mt-8">
          <button 
            id="restart-btn" 
            class="bg-neutral-100 hover:bg-neutral-200 text-neutral-800 py-3 px-6 rounded-xl text-xs font-semibold tracking-wider uppercase border border-neutral-200 transition-all active:scale-95 w-full sm:w-auto"
          >
            Retake Quiz
          </button>
          <a 
            href="/tools/due-date-calculator" 
            class="inline-block bg-[#0066cc] hover:bg-[#0055b3] text-white py-3 px-6 rounded-xl text-xs font-semibold tracking-wider uppercase text-center transition-all active:scale-95 w-full sm:w-auto"
          >
            Due Date Calculator
          </a>
        </div>
      </div>

    </div>
  </main>

  <script>
    // Quiz state and questions
    interface Option {
      text: string;
      points: number;
    }

    interface Question {
      id: number;
      q: string;
      options: Option[];
    }

    const questions: Question[] = [
      {
        id: 1,
        q: "Has your expected period arrived, or is it late?",
        options: [
          { text: "Yes, it is late (by a few days or more)", points: 5 },
          { text: "No, it's not due yet or I'm unsure/irregular", points: 2 },
          { text: "No, it arrived on time and as expected", points: 0 }
        ]
      },
      {
        id: 2,
        q: "Are you feeling nauseous or experiencing morning sickness?",
        options: [
          { text: "Yes, frequent nausea, vomiting, or strong aversions to foods", points: 4 },
          { text: "Mild, occasional nausea, or an unsettled stomach", points: 2 },
          { text: "No, my appetite is normal", points: 0 }
        ]
      },
      {
        id: 3,
        q: "How are your general energy levels?",
        options: [
          { text: "Extremely fatigued, exhausted even after plenty of sleep", points: 3 },
          { text: "Slightly more tired than normal", points: 1 },
          { text: "Normal energy levels", points: 0 }
        ]
      },
      {
        id: 4,
        q: "Have you noticed any changes in your breasts?",
        options: [
          { text: "Yes, they feel tender, swollen, heavier, or tingly", points: 3 },
          { text: "Very mild sensitivity", points: 1 },
          { text: "No changes at all", points: 0 }
        ]
      },
      {
        id: 5,
        q: "Have you experienced light spotting or mild abdominal cramps?",
        options: [
          { text: "Yes, light pink or brown spotting (implantation spotting)", points: 3 },
          { text: "Mild cramping only, similar to pre-period cramps", points: 1 },
          { text: "No spotting or cramping", points: 0 }
        ]
      },
      {
        id: 6,
        q: "Are you experiencing a heightened sensitivity to smells?",
        options: [
          { text: "Yes, common smells like coffee, food, or perfume suddenly make me nauseous", points: 3 },
          { text: "Mildly, some scents seem slightly stronger", points: 1 },
          { text: "No, smell sensitivity is normal", points: 0 }
        ]
      },
      {
        id: 7,
        q: "Have you noticed an increased urge to urinate?",
        options: [
          { text: "Yes, I am making frequent trips to the bathroom", points: 3 },
          { text: "Slightly more frequent than usual", points: 1 },
          { text: "Normal frequency", points: 0 }
        ]
      },
      {
        id: 8,
        q: "Have you been experiencing sudden mood swings or emotional spikes?",
        options: [
          { text: "Yes, I feel highly emotional, tearful, or easily irritated", points: 2 },
          { text: "A bit more moody than usual", points: 1 },
          { text: "Normal, balanced mood", points: 0 }
        ]
      },
      {
        id: 9,
        q: "If you track your basal body temperature (BBT), has it remained elevated?",
        options: [
          { text: "Yes, it has stayed high for 18 days or more in a row", points: 3 },
          { text: "No, or I don't track my basal temperature", points: 0 }
        ]
      },
      {
        id: 10,
        q: "Have you taken a home pregnancy test?",
        options: [
          { text: "I took one, and it showed a very faint line or inconclusive result", points: 4 },
          { text: "I haven't taken a test yet", points: 1 },
          { text: "I took one, and it was negative", points: 0 }
        ]
      }
    ];

    let currentQuestionIndex = 0;
    let userAnswers: number[] = []; // stores points chosen for each question

    // DOM Elements
    const startScreen = document.getElementById('start-screen');
    const startBtn = document.getElementById('start-btn');
    const quizContainer = document.getElementById('quiz-container');
    const questionText = document.getElementById('question-text');
    const optionsContainer = document.getElementById('options-container');
    const backBtn = document.getElementById('back-btn') as HTMLButtonElement;
    const progressText = document.getElementById('progress-text');
    const progressPercent = document.getElementById('progress-percent');
    const progressBar = document.getElementById('progress-bar');
    const resultScreen = document.getElementById('result-screen');
    const resultTitle = document.getElementById('result-title');
    const resultScore = document.getElementById('result-score');
    const resultDescription = document.getElementById('result-description');
    const resultSteps = document.getElementById('result-steps');
    const restartBtn = document.getElementById('restart-btn');

    // Init
    if (startBtn && startScreen && quizContainer) {
      startBtn.addEventListener('click', () => {
        startScreen.classList.add('hidden');
        quizContainer.classList.remove('hidden');
        currentQuestionIndex = 0;
        userAnswers = [];
        showQuestion();
      });
    }

    function showQuestion() {
      if (!questionText || !optionsContainer || !progressText || !progressPercent || !progressBar) return;

      const q = questions[currentQuestionIndex];
      questionText.textContent = q.q;

      // Update progress indicators
      const currentNumber = currentQuestionIndex + 1;
      const totalCount = questions.length;
      progressText.textContent = `Question ${currentNumber} of ${totalCount}`;
      const percent = Math.round((currentNumber / totalCount) * 100);
      progressPercent.textContent = `${percent}% Complete`;
      progressBar.style.width = `${percent}%`;

      // Back button visibility
      if (backBtn) {
        if (currentQuestionIndex > 0) {
          backBtn.classList.remove('hidden');
        } else {
          backBtn.classList.add('hidden');
        }
      }

      // Generate options
      optionsContainer.innerHTML = '';
      q.options.forEach((opt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = "w-full text-left p-4 rounded-xl border border-neutral-200 text-xs font-medium text-neutral-700 bg-white hover:bg-neutral-50 hover:border-neutral-300 transition-all active:scale-[0.99] flex justify-between items-center";
        
        btn.innerHTML = `
          <span>${opt.text}</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-neutral-300 transition-colors">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        `;

        btn.addEventListener('click', () => {
          selectOption(opt.points);
        });
        optionsContainer.appendChild(btn);
      });
    }

    function selectOption(points: number) {
      userAnswers[currentQuestionIndex] = points;
      if (currentQuestionIndex < questions.length - 1) {
        currentQuestionIndex++;
        showQuestion();
      } else {
        showResults();
      }
    }

    if (backBtn) {
      backBtn.addEventListener('click', () => {
        if (currentQuestionIndex > 0) {
          currentQuestionIndex--;
          showQuestion();
        }
      });
    }

    function showResults() {
      if (!quizContainer || !resultScreen || !resultTitle || !resultScore || !resultDescription || !resultSteps) return;

      quizContainer.classList.add('hidden');
      resultScreen.classList.remove('hidden');

      // Calculate score
      const totalScore = userAnswers.reduce((sum, current) => sum + current, 0);
      resultScore.textContent = totalScore.toString();

      let title = "";
      let desc = "";
      let steps: string[] = [];

      if (totalScore <= 12) {
        title = "Low Likelihood of Pregnancy";
        desc = "Based on your selections, you have a low score of early pregnancy clinical indicators. Many of the symptoms you described are common fluctuations related to the regular menstrual cycle, stress, diet, or minor hormonal changes. However, if your period is late by more than a week, a home pregnancy test is still recommended for peace of mind.";
        steps = [
          "Wait 2-3 days to see if your period starts naturally.",
          "If your period remains late for more than 7 days, take a standard home pregnancy test using your first-morning urine.",
          "Track your symptoms regularly using a calendar or application.",
          "Consult your doctor if you experience severe pain, cramping, or irregular cycles."
        ];
      } else if (totalScore <= 24) {
        title = "Moderate Likelihood of Pregnancy";
        desc = "Your score shows moderate clinical indicators of early pregnancy. You are experiencing several classic symptoms (like breast tenderness, fatigue, or mild nausea) that frequently occur in the first few weeks after conception. Because these symptoms can mimic PMS, the most reliable next step is to take a home pregnancy test.";
        steps = [
          "Purchase a high-sensitivity home pregnancy test.",
          "Take the test tomorrow morning. First-morning urine contains the highest concentration of hCG (human chorionic gonadotropin).",
          "If the test is negative but your period still hasn't started in 3 days, repeat the test.",
          "Limit caffeine, avoid alcohol and smoking, and adopt standard early pregnancy precautions just in case."
        ];
      } else {
        title = "High Likelihood of Pregnancy";
        desc = "Your score indicates a high likelihood of early pregnancy. You have checked several strongly indicative markers, such as a missed period combined with nausea, distinct breast changes, and positive or faint-line test results. We highly recommend proceeding with verification testing and scheduling an prenatal intake call with a medical professional.";
        steps = [
          "Take a home pregnancy test immediately (or repeat it using first-morning urine to confirm).",
          "If positive, contact your OB/GYN or midwife to schedule your first prenatal appointment (usually scheduled between weeks 7 and 9).",
          "Begin taking a daily prenatal vitamin containing at least 400 mcg of Folic Acid.",
          "Review our Nutrition and Medication Safety guidelines, and avoid alcohol, nicotine, and raw/undercooked foods."
        ];
      }

      resultTitle.textContent = title;
      resultDescription.textContent = desc;

      // Render steps
      resultSteps.innerHTML = '';
      steps.forEach(step => {
        const li = document.createElement('li');
        li.textContent = step;
        resultSteps.appendChild(li);
      });
    }

    if (restartBtn && resultScreen && startScreen) {
      restartBtn.addEventListener('click', () => {
        resultScreen.classList.add('hidden');
        startScreen.classList.remove('hidden');
      });
    }
  </script>
</Layout>
