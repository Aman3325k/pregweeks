---
// src/pages/tools/eye-color-calculator.astro
import Layout from '../../layouts/Layout.astro';
import { getMedicalPageSchema, getBreadcrumbSchema, getSoftwareApplicationSchema } from '../../utils/seo';

const title = "Baby Eye Color Calculator & Genetics Predictor | PregWeeks";
const description = "Predict your baby's eye color based on Mendelian genetics. Select parental eye colors for an instant probability chart of brown, blue, or green eyes.";
const url = "https://pregweeks.com/tools/eye-color-calculator";

const schemas = [
  getMedicalPageSchema(title, description, url),
  getSoftwareApplicationSchema("Baby Eye Color Calculator", description, url),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: "Tools", url: "https://pregweeks.com/calculators" },
    { name: "Eye Color Calculator", url: url }
  ])
];
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Header Breadcrumb -->
  <div class="bg-canvas border-b border-hairline py-3 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto text-xs md:text-sm text-ink-muted-80 font-medium">
      <a href="/" class="text-primary hover:underline">Home</a>
      <span class="mx-2 text-hairline">/</span>
      <a href="/calculators" class="text-primary hover:underline">Tools</a>
      <span class="mx-2 text-hairline">/</span>
      <span class="text-ink">Eye Color Calculator</span>
    </div>
  </div>

  <!-- Hero Tile (Light Canvas) -->
  <section class="bg-canvas py-12 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto text-center mb-10">
      <span class="text-3xl mb-3 block">👀</span>
      <h1 class="font-display font-semibold text-3xl md:text-4xl text-ink tracking-apple-tight mb-4">
        Baby Eye Color Calculator
      </h1>
      <p class="text-base md:text-lg text-ink-muted-80 leading-relaxed tracking-apple-dense">
        Predict your baby's potential eye color. Select the eye colors of both biological parents to determine the statistical genetic probabilities.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="bg-canvas border border-hairline rounded-apple-lg p-6 md:p-8 max-w-xl mx-auto transition-all duration-300">
      
      <!-- Parents Inputs -->
      <div class="flex flex-col gap-6">
        
        <!-- Parent 1 Selector -->
        <div>
          <span class="font-semibold text-xs md:text-sm text-ink block mb-3">Parent 1 (Mother) Eye Color:</span>
          <div class="flex gap-3" id="parent1-swatches">
            <button type="button" class="swatch flex-1 py-3 px-4 border-2 border-primary rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="brown">
              <span class="w-4 h-4 rounded-full bg-[#704214] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Brown</span>
            </button>
            <button type="button" class="swatch flex-1 py-3 px-4 border border-hairline rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="blue">
              <span class="w-4 h-4 rounded-full bg-[#4682b4] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Blue</span>
            </button>
            <button type="button" class="swatch flex-1 py-3 px-4 border border-hairline rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="green">
              <span class="w-4 h-4 rounded-full bg-[#3b7a57] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Green</span>
            </button>
          </div>
        </div>

        <!-- Parent 2 Selector -->
        <div>
          <span class="font-semibold text-xs md:text-sm text-ink block mb-3">Parent 2 (Father) Eye Color:</span>
          <div class="flex gap-3" id="parent2-swatches">
            <button type="button" class="swatch flex-1 py-3 px-4 border-2 border-primary rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="brown">
              <span class="w-4 h-4 rounded-full bg-[#704214] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Brown</span>
            </button>
            <button type="button" class="swatch flex-1 py-3 px-4 border border-hairline rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="blue">
              <span class="w-4 h-4 rounded-full bg-[#4682b4] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Blue</span>
            </button>
            <button type="button" class="swatch flex-1 py-3 px-4 border border-hairline rounded-apple-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-95 bg-canvas" data-color="green">
              <span class="w-4 h-4 rounded-full bg-[#3b7a57] inline-block shadow-sm"></span>
              <span class="text-xs md:text-sm font-bold text-ink">Green</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Probability Results Panel -->
      <div id="results-panel" class="mt-8 border-t border-hairline pt-6">
        <h3 class="text-xs uppercase tracking-wider font-semibold text-ink-muted-48 mb-4 text-center">Baby Eye Color Probabilities</h3>
        
        <div class="flex flex-col gap-4">
          <!-- Brown Progress Bar -->
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#704214]"></span> Brown Eyes</span>
              <span id="prob-brown" class="text-primary font-bold">0%</span>
            </div>
            <div class="h-3 bg-canvas-parchment rounded-full overflow-hidden border border-hairline/30">
              <div class="h-full bg-[#704214] rounded-full transition-all duration-500 ease-out" id="fill-brown" style="width: 0%;"></div>
            </div>
          </div>

          <!-- Blue Progress Bar -->
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#4682b4]"></span> Blue Eyes</span>
              <span id="prob-blue" class="text-primary font-bold">0%</span>
            </div>
            <div class="h-3 bg-canvas-parchment rounded-full overflow-hidden border border-hairline/30">
              <div class="h-full bg-[#4682b4] rounded-full transition-all duration-500 ease-out" id="fill-blue" style="width: 0%;"></div>
            </div>
          </div>

          <!-- Green Progress Bar -->
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#3b7a57]"></span> Green Eyes</span>
              <span id="prob-green" class="text-primary font-bold">0%</span>
            </div>
            <div class="h-3 bg-canvas-parchment rounded-full overflow-hidden border border-hairline/30">
              <div class="h-full bg-[#3b7a57] rounded-full transition-all duration-500 ease-out" id="fill-green" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <!-- Share Trigger -->
        <div class="mt-6 pt-4 border-t border-hairline text-center">
          <button 
            type="button" 
            id="btn-copy-eye-prediction" 
            class="w-full bg-primary hover:bg-primary-focus text-white text-xs font-semibold py-2.5 px-4 rounded-apple-pill transition-all active:scale-95 text-center min-h-[44px] flex items-center justify-center gap-1.5 cursor-pointer shadow-none"
          >
            🔗 Copy Shareable Genetic Results
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Informational/Genetics Science explanation -->
  <section class="bg-canvas-parchment py-16 px-4 border-t border-b border-hairline transition-colors">
    <div class="max-w-[720px] mx-auto flex flex-col gap-8">
      <div>
        <h2 class="font-display font-semibold text-2xl text-ink tracking-apple-tight mb-3">Understanding Eye Color Inheritance</h2>
        <p class="text-sm md:text-base text-ink-muted-80 leading-relaxed mb-4">
          Human eye color is a polygenic trait determined by multiple genes, primarily located on chromosome 15 (such as OCA2 and HERC2). These genes control the amount and quality of melanin pigments deposited in the iris stroma.
        </p>
        <p class="text-sm md:text-base text-ink-muted-80 leading-relaxed">
          Brown is typically a dominant trait, while blue is a recessive trait. Green acts as a co-dominant or intermediate trait. That means blue-eyed parents usually have blue-eyed children, but mutations and polygenic interactions can still produce green or even brown eyes in rare circumstances.
        </p>
      </div>

      <div class="bg-canvas border border-hairline p-5 rounded-apple-sm">
        <h3 class="font-semibold text-sm md:text-base text-ink mb-2">Dominant vs Recessive Probabilities</h3>
        <p class="text-xs md:text-sm text-ink-muted-80 leading-relaxed">
          Our calculator uses the classic Mendelian model (Punnett Square approximations) as a primary baseline, which represents over 95% of real-world outcomes. However, eye color is complex; other genes can modify the final hue (resulting in hazel, gray, or multi-colored irises). Obstetricians recommend checking the infant's eyes at 9 to 12 months of age, as eye colors frequently change during early development.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive script -->
  <script>
    // Genetic probabilities lookup table
    // Keys format: 'parent1Color-parent2Color'
    // Values: { brown, green, blue } percentages
    const geneticOdds: Record<string, { brown: number; green: number; blue: number }> = {
      'brown-brown': { brown: 75, green: 19, blue: 6 },
      'brown-blue': { brown: 50, green: 0, blue: 50 },
      'brown-green': { brown: 50, green: 38, blue: 12 },
      'blue-brown': { brown: 50, green: 0, blue: 50 },
      'blue-blue': { brown: 0, green: 1, blue: 99 },
      'blue-green': { brown: 0, green: 50, blue: 50 },
      'green-brown': { brown: 50, green: 38, blue: 12 },
      'green-blue': { brown: 0, green: 50, blue: 50 },
      'green-green': { brown: 0, green: 75, blue: 25 }
    };

    let p1Color = 'brown';
    let p2Color = 'brown';

    const p1Container = document.getElementById('parent1-swatches');
    const p2Container = document.getElementById('parent2-swatches');

    const fillBrown = document.getElementById('fill-brown');
    const fillBlue = document.getElementById('fill-blue');
    const fillGreen = document.getElementById('fill-green');

    const labelBrown = document.getElementById('prob-brown');
    const labelBlue = document.getElementById('prob-blue');
    const labelGreen = document.getElementById('prob-green');

    const copyBtn = document.getElementById('btn-copy-eye-prediction');

    // Handle Parent 1 Swatch Clicking
    p1Container?.querySelectorAll('.swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        p1Container.querySelectorAll('.swatch').forEach(b => {
          b.classList.remove('border-2', 'border-primary');
          b.classList.add('border', 'border-hairline');
        });
        btn.classList.add('border-2', 'border-primary');
        btn.classList.remove('border', 'border-hairline');
        
        p1Color = btn.getAttribute('data-color') || 'brown';
        calculateOdds();
      });
    });

    // Handle Parent 2 Swatch Clicking
    p2Container?.querySelectorAll('.swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        p2Container.querySelectorAll('.swatch').forEach(b => {
          b.classList.remove('border-2', 'border-primary');
          b.classList.add('border', 'border-hairline');
        });
        btn.classList.add('border-2', 'border-primary');
        btn.classList.remove('border', 'border-hairline');
        
        p2Color = btn.getAttribute('data-color') || 'brown';
        calculateOdds();
      });
    });

    function calculateOdds() {
      const lookupKey = `${p1Color}-${p2Color}`;
      const odds = geneticOdds[lookupKey] || { brown: 33, green: 33, blue: 34 };

      // Update progress bar widths
      if (fillBrown) fillBrown.style.width = `${odds.brown}%`;
      if (fillBlue) fillBlue.style.width = `${odds.blue}%`;
      if (fillGreen) fillGreen.style.width = `${odds.green}%`;

      // Update text percentage numbers
      if (labelBrown) labelBrown.textContent = `${odds.brown}%`;
      if (labelBlue) labelBlue.textContent = `${odds.blue}%`;
      if (labelGreen) labelGreen.textContent = `${odds.green}%`;
    }

    copyBtn?.addEventListener('click', async () => {
      const lookupKey = `${p1Color}-${p2Color}`;
      const odds = geneticOdds[lookupKey] || { brown: 0, green: 0, blue: 0 };
      
      const text = `The genetics calculator predicts our baby's eye color odds as: ${odds.brown}% Brown, ${odds.green}% Green, ${odds.blue}% Blue! Calculate yours at: ${window.location.href}`;
      
      try {
        await navigator.clipboard.writeText(text);

        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = '✓ Copied Results!';
        copyBtn.classList.remove('bg-primary');
        copyBtn.classList.add('bg-green-600');

        setTimeout(() => {
          copyBtn.innerHTML = originalText;
          copyBtn.classList.add('bg-primary');
          copyBtn.classList.remove('bg-green-600');
        }, 2000);
      } catch (e) {
        console.error('Failed to copy genetic results text:', e);
      }
    });

    // Run calculation once on load to initialize bars
    calculateOdds();
  </script>
</Layout>
