---
import Layout from '../../layouts/Layout.astro';

const categories = [
  { id: "cost-nursery", name: "Nursery & Furniture", description: "Crib, mattress, glider chair, changing table, and diaper pail.", default: 1000, min: 0, max: 3000, step: 50 },
  { id: "cost-gear", name: "Stroller, Car Seat & Gear", description: "Infant car seat, stroller/travel system, baby carrier, and diaper bag.", default: 600, min: 0, max: 2000, step: 50 },
  { id: "cost-feeding", name: "Feeding Supplies", description: "Bottles, breast pump, breast milk bags, formula, bibs, and high chair.", default: 400, min: 0, max: 1500, step: 25 },
  { id: "cost-diapering", name: "Diapering (First Year)", description: "Disposable/cloth diapers, wipes, rash creams, and disposal bags.", default: 800, min: 0, max: 2000, step: 50 },
  { id: "cost-clothing", name: "Baby Clothing", description: "Onesies, sleep sacks, swaddles, socks, and seasonal outfits.", default: 500, min: 0, max: 1500, step: 25 },
  { id: "cost-childcare", name: "Childcare & Daycare", description: "Full-time daycare, nanny share, or part-time babysitters.", default: 6000, min: 0, max: 25000, step: 250 },
  { id: "cost-medical", name: "Medical & Health", description: "Pediatrician copays, health insurance premiums, medicines, and thermometers.", default: 1200, min: 0, max: 5000, step: 50 },
  { id: "cost-misc", name: "Toys, Books & Monitors", description: "Baby monitor, play gym, sensory toys, books, and pacifiers.", default: 300, min: 0, max: 1500, step: 25 }
];
---

<Layout 
  title="Baby Cost Calculator: Estimate First Year Expenses | PregWeeks"
  description="Use our interactive baby cost calculator to estimate first-year expenses. Adjust categories like nursery, diapers, childcare, and gear."
>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <a href="/calculators" class="hover:text-[#0066cc] transition-colors">Tools</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Baby Cost Calculator</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Budget Planner</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-4 sm:text-4xl">
        Baby Cost Calculator
      </h1>
      <p class="text-base text-neutral-500 leading-relaxed">
        Estimate the financial investment of your baby's first year. Adjust the category sliders below to build a customized budget based on your planned lifestyle.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Sliders Column -->
      <section class="lg:col-span-2 space-y-6">
        <div class="bg-white border border-neutral-200 rounded-xl p-5 space-y-6">
          <h2 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider border-b border-neutral-100 pb-2">Category Adjustments</h2>
          
          <div class="space-y-6">
            {categories.map(cat => (
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <div>
                    <h3 class="text-xs font-bold text-neutral-800">{cat.name}</h3>
                    <p class="text-[10px] text-neutral-400 max-w-sm sm:max-w-md">{cat.description}</p>
                  </div>
                  <span class="text-xs font-bold text-[#0066cc] bg-blue-50 px-2 py-0.5 rounded border border-blue-100/50 min-w-[70px] text-right">
                    $<span class="slider-val-label" data-target={cat.id}>{cat.default}</span>
                  </span>
                </div>
                <input 
                  type="range" 
                  id={cat.id} 
                  min={cat.min} 
                  max={cat.max} 
                  step={cat.step} 
                  value={cat.default}
                  class="cost-slider w-full h-1.5 bg-neutral-100 rounded-lg appearance-none cursor-pointer accent-[#0066cc]"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Summary Column -->
      <section class="lg:col-span-1 space-y-6">
        <!-- Totals Card -->
        <div class="bg-neutral-50 border border-neutral-200 rounded-xl p-5 text-center sticky top-20 space-y-4">
          <span class="text-[9px] uppercase font-bold tracking-widest text-neutral-400">Estimated First Year Total</span>
          
          <div class="text-3xl font-black text-neutral-900">
            $<span id="cost-grand-total">0</span>
          </div>

          <p class="text-[10px] text-neutral-500 leading-relaxed">
            *This sum represents the total estimated cost for basic supplies, healthcare, and selected childcare.
          </p>

          <div class="border-t border-neutral-200/60 pt-4 text-left space-y-3">
            <h4 class="text-xs font-bold text-neutral-800 uppercase tracking-wider">Budgeting Tips:</h4>
            <ul class="list-disc list-inside space-y-1 text-[11px] text-neutral-600 leading-relaxed">
              <li><strong>Buy secondhand:</strong> Bassinets, gliders, and clothing can easily be purchased gently used.</li>
              <li><strong>Prioritize safety:</strong> Always buy car seats and crib mattresses brand new.</li>
              <li><strong>Childcare planning:</strong> Childcare is typically 60-70% of the first-year budget.</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  const sliders = document.querySelectorAll('.cost-slider') as NodeListOf<HTMLInputElement>;
  const valLabels = document.querySelectorAll('.slider-val-label') as NodeListOf<HTMLElement>;
  const grandTotalSpan = document.getElementById('cost-grand-total');

  function calculateTotal() {
    let total = 0;
    
    sliders.forEach(slider => {
      const val = parseInt(slider.value);
      total += val;

      // Update individual labels
      valLabels.forEach(lbl => {
        if (lbl.getAttribute('data-target') === slider.id) {
          lbl.textContent = val.toLocaleString();
        }
      });
    });

    if (grandTotalSpan) grandTotalSpan.textContent = total.toLocaleString();
  }

  // Attach slider input change triggers
  sliders.forEach(slider => {
    slider.addEventListener('input', calculateTotal);
  });

  // Init
  calculateTotal();
</script>
