---
import Layout from '../../layouts/Layout.astro';
import { getMedicalPageSchema, getBreadcrumbSchema, getHowToSchema } from '../../utils/seo';

const title = "Pregnancy Journal & Daily Diary Tracker | PregWeeks";
const description = "Keep a private, secure diary of your pregnancy. Log daily notes, track symptoms, tag entries by week, log moods, and export your journal as text.";
const url = "https://pregweeks.com/tools/journal";

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://pregweeks.com" },
  { name: "Tools", url: "https://pregweeks.com/tools/due-date-calculator" },
  { name: "Pregnancy Journal", url: url }
]);

const medicalSchema = getMedicalPageSchema(title, description, url);

const journalHowTo = getHowToSchema(
  "How to Use the Pregnancy Journal",
  "Use our private, local pregnancy diary to record your milestones, moods, and notes week-by-week.",
  [
    { name: "Select Week", text: "Select your current pregnancy week from the dropdown menu (Weeks 1 to 40)." },
    { name: "Choose Mood Icon", text: "Tap on the emoji button that best represents your mood or physical feelings today." },
    { name: "Write Daily Notes", text: "Type your thoughts, medical updates, or questions in the Daily Notes text area." },
    { name: "Save and Store", text: "Click 'Save Entry' to save the log privately on your device. Use the Export button to download all notes as text." }
  ]
);

const schemas = [breadcrumbs, medicalSchema, journalHowTo];
---

<Layout 
  title={title}
  description={description}
  canonicalUrl={url}
  schemas={schemas}
>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] transition-colors">Home</a>
      <span class="text-neutral-300">/</span>
      <a href="/tools/due-date-calculator" class="hover:text-[#0066cc] transition-colors">Tools</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700 font-medium">Pregnancy Journal</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-semibold text-[#0066cc] uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full">Personal Diary</span>
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 mt-3 mb-4 sm:text-4xl">
        Pregnancy Journal
      </h1>
      <p class="text-base text-neutral-500 leading-relaxed">
        Record your milestones, thoughts, and symptoms during your pregnancy journey. Your entries are 100% private and stored locally on your device.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Entry Form Column -->
      <section class="md:col-span-1 bg-white border border-neutral-200 rounded-xl p-5 h-fit space-y-4">
        <h2 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider border-b border-neutral-100 pb-2">New Entry</h2>
        
        <form id="journal-form" class="space-y-4">
          <!-- Week Selection -->
          <div>
            <label for="journal-week" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Pregnancy Week</label>
            <select 
              id="journal-week" 
              required
              class="w-full px-3 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-800 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white cursor-pointer"
            >
              {Array.from({ length: 40 }, (_, i) => i + 1).map(w => (
                <option value={w}>Week {w}</option>
              ))}
            </select>
          </div>

          <!-- Mood Selector -->
          <div>
            <label class="block text-xs font-semibold text-neutral-600 uppercase mb-2">How are you feeling?</label>
            <div class="grid grid-cols-3 gap-1.5 text-center">
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="😊">😊</button>
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="🥱">🥱</button>
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="🤢">🤢</button>
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="🤩">🤩</button>
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="😟">😟</button>
              <button type="button" class="mood-btn bg-neutral-50 border border-neutral-200 hover:bg-neutral-100 p-2 rounded-lg text-lg transition-all active:scale-95 cursor-pointer" data-mood="😭">😭</button>
            </div>
            <input type="hidden" id="selected-mood" value="😊" />
          </div>

          <!-- Notes Text Area -->
          <div>
            <label for="journal-notes" class="block text-xs font-semibold text-neutral-600 uppercase mb-1.5">Daily Notes</label>
            <textarea 
              id="journal-notes" 
              rows="6"
              required
              placeholder="How are you feeling today? Any new milestones, kicks, or doctor visits?"
              class="w-full px-3 py-2.5 rounded-lg border border-neutral-300 text-xs text-neutral-900 focus:outline-none focus:ring-1 focus:ring-[#0066cc] focus:border-[#0066cc] bg-white transition-all shadow-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full bg-[#0066cc] hover:bg-[#0055b3] text-white py-2.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all active:scale-[0.98]"
          >
            Save Entry
          </button>
        </form>
      </section>

      <!-- Logs / List Column -->
      <section class="md:col-span-2 space-y-6">
        
        <!-- Controls Header -->
        <div class="flex justify-between items-center border-b border-neutral-200 pb-3">
          <h2 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider">Journal History</h2>
          <div class="flex space-x-2">
            <button 
              id="export-btn"
              class="bg-neutral-50 hover:bg-neutral-100 text-neutral-700 py-1.5 px-3 rounded-lg text-xs font-semibold border border-neutral-200 transition-all active:scale-95 flex items-center space-x-1"
            >
              <span>📥</span>
              <span>Export Journal</span>
            </button>
          </div>
        </div>

        <!-- Entries list container -->
        <div id="journal-list" class="space-y-4">
          <!-- Dynamic entries will be injected here -->
        </div>

        <!-- Empty State -->
        <div id="journal-empty" class="hidden text-center py-16 bg-neutral-50 rounded-xl border border-dashed border-neutral-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 mx-auto text-neutral-300 mb-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
          <h3 class="text-sm font-semibold text-neutral-800 mb-1">Your Journal is Empty</h3>
          <p class="text-xs text-neutral-500">Log your first notes using the left panel. Entries are stored locally in your browser.</p>
        </div>
      </section>

    </div>

    <!-- Related Tools Section (Internal Linking Matrix) -->
    <section class="mt-12 pt-8 border-t border-neutral-200 text-center col-span-1 md:col-span-3">
      <h2 class="font-semibold text-lg text-neutral-900 mb-6 tracking-tight">Related Pregnancy Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        <a href="/tools/due-date-calculator" class="bg-white border border-neutral-200 hover:border-[#0066cc] p-4 rounded-xl transition-all text-xs font-semibold text-neutral-800 leading-tight block shadow-sm">Due Date Calculator</a>
        <a href="/tools/kick-counter" class="bg-white border border-neutral-200 hover:border-[#0066cc] p-4 rounded-xl transition-all text-xs font-semibold text-neutral-800 leading-tight block shadow-sm">Baby Kick Counter</a>
        <a href="/tools/contraction-timer" class="bg-white border border-neutral-200 hover:border-[#0066cc] p-4 rounded-xl transition-all text-xs font-semibold text-neutral-800 leading-tight block shadow-sm">Contraction Timer</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  interface JournalEntry {
    id: string;
    date: string;
    week: number;
    mood: string;
    notes: string;
  }

  const form = document.getElementById('journal-form') as HTMLFormElement;
  const moodBtns = document.querySelectorAll('.mood-btn') as NodeListOf<HTMLButtonElement>;
  const selectedMoodInput = document.getElementById('selected-mood') as HTMLInputElement;
  const notesTextarea = document.getElementById('journal-notes') as HTMLTextAreaElement;
  const weekSelect = document.getElementById('journal-week') as HTMLSelectElement;
  
  const journalList = document.getElementById('journal-list');
  const journalEmpty = document.getElementById('journal-empty');
  const exportBtn = document.getElementById('export-btn');

  const LOCAL_STORAGE_KEY = 'pregweeks_journal_entries';

  // Highlight default selected mood
  setActiveMood("😊");

  // Mood selector click handlers
  moodBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const mood = btn.getAttribute('data-mood') || '😊';
      setActiveMood(mood);
    });
  });

  function setActiveMood(mood: string) {
    if (selectedMoodInput) selectedMoodInput.value = mood;
    moodBtns.forEach(b => {
      b.classList.remove('bg-blue-50', 'border-[#0066cc]');
      if (b.getAttribute('data-mood') === mood) {
        b.classList.add('bg-blue-50', 'border-[#0066cc]');
      }
    });
  }

  // Handle Save Submission
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const week = parseInt(weekSelect.value);
      const mood = selectedMoodInput.value;
      const notes = notesTextarea.value.trim();

      const newEntry: JournalEntry = {
        id: Date.now().toString(),
        date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
        week,
        mood,
        notes
      };

      const entries = getEntries();
      entries.unshift(newEntry); // newest first
      saveEntries(entries);
      
      notesTextarea.value = '';
      setActiveMood("😊");
      renderEntries();
    });
  }

  function getEntries(): JournalEntry[] {
    const raw = localStorage.getItem(LOCAL_STORAGE_KEY);
    if (!raw) return [];
    try {
      return JSON.parse(raw);
    } catch {
      return [];
    }
  }

  function saveEntries(entries: JournalEntry[]) {
    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(entries));
  }

  function renderEntries() {
    if (!journalList || !journalEmpty) return;

    const entries = getEntries();

    if (entries.length === 0) {
      journalList.innerHTML = '';
      journalEmpty.classList.remove('hidden');
      return;
    }

    journalEmpty.classList.add('hidden');
    journalList.innerHTML = '';

    entries.forEach(entry => {
      const card = document.createElement('div');
      card.className = "bg-white border border-neutral-200 rounded-xl p-5 relative space-y-3";
      
      card.innerHTML = `
        <div class="flex justify-between items-start">
          <div class="space-y-1">
            <div class="flex items-center space-x-2">
              <span class="text-xs font-bold text-neutral-800 bg-neutral-100 px-2 py-0.5 rounded border border-neutral-200">
                Week ${entry.week}
              </span>
              <span class="text-base">${entry.mood}</span>
            </div>
            <p class="text-[10px] text-neutral-400 font-medium">${entry.date}</p>
          </div>
          <button class="delete-btn text-xs text-rose-500 hover:underline cursor-pointer" data-id="${entry.id}">Delete</button>
        </div>
        <p class="text-xs text-neutral-600 leading-relaxed whitespace-pre-wrap">${entry.notes}</p>
      `;

      // Attach delete handler
      const delBtn = card.querySelector('.delete-btn');
      delBtn?.addEventListener('click', () => {
        if (confirm("Are you sure you want to delete this journal entry?")) {
          const id = delBtn.getAttribute('data-id');
          const filtered = getEntries().filter(e => e.id !== id);
          saveEntries(filtered);
          renderEntries();
        }
      });

      journalList.appendChild(card);
    });
  }

  // Export Journal
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const entries = getEntries();
      if (entries.length === 0) {
        alert("Your journal is empty. Write an entry before exporting.");
        return;
      }

      let txt = "PregWeeks Pregnancy Journal Export\n";
      txt += "===================================\n\n";

      entries.forEach(e => {
        txt += `Date: ${e.date}\n`;
        txt += `Pregnancy Status: Week ${e.week}\n`;
        txt += `Mood: ${e.mood}\n`;
        txt += "-----------------------------------\n";
        txt += `${e.notes}\n\n\n`;
      });

      const blob = new Blob([txt], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `pregweeks-pregnancy-journal-${Date.now()}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // Init render
  document.addEventListener('DOMContentLoaded', renderEntries);
  renderEntries();
</script>
