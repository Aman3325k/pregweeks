---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, getMedicalPageSchema } from '../../utils/seo';

const title = "Pregnancy & Fetal Development Blog | PregWeeks";
const description = "Read expert, evidence-based articles on pregnancy developmental milestones, due date accuracy, morning sickness timelines, and symptom guidelines.";
const url = "https://pregweeks.com/blog/";

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: "Blog", url: url }
  ])
];

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC'
  });
};
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Header Breadcrumb -->
  <div class="bg-canvas border-b border-hairline py-3.5 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto text-xs md:text-sm text-ink-muted-80 font-medium">
      <nav class="flex items-center space-x-1.5 text-xs text-ink-muted-80 print:hidden" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="text-ink-muted-48">&gt;</span>
        <span class="text-ink font-semibold">Blog</span>
      </nav>
    </div>
  </div>

  <!-- Hero Title (Light Canvas) -->
  <section class="bg-canvas py-16 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto text-center flex flex-col items-center">
      <span class="text-3xl mb-4 block">🌸</span>
      <h1 class="font-display font-semibold text-4xl md:text-5xl text-ink leading-tight tracking-apple-tight mb-4">
        Pregnancy Insights & Science
      </h1>
      <p class="text-base md:text-lg text-ink-muted-80 leading-relaxed max-w-xl">
        Evidence-based guidance, trimester overviews, and developmental research sourced directly from established clinical guidelines.
      </p>
    </div>
  </section>

  <!-- Blog Grid (Parchment Surface) -->
  <section class="bg-canvas-parchment py-16 px-4 border-t border-b border-hairline transition-colors">
    <div class="max-w-[960px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-canvas border border-hairline rounded-apple-lg p-6 hover:border-primary/20 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3 text-[11px] font-semibold uppercase tracking-wider text-ink-muted-48">
                <span>Article</span>
                <span class="w-1 h-1 rounded-full bg-neutral-300"></span>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </div>
              <h2 class="font-display font-semibold text-xl text-ink mb-3 tracking-apple-tight hover:text-primary transition-colors">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="text-xs text-ink-muted-80 leading-relaxed mb-6">
                {post.data.description}
              </p>
            </div>
            <a 
              href={`/blog/${post.id}/`} 
              class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1 min-h-[44px]"
            >
              Read Full Article &rarr;
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
