---
// src/pages/symptoms.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { symptomItems } from '../data/symptomData';
import { getMedicalPageSchema, getBreadcrumbSchema } from '../utils/seo';

const mdxSymptoms = await getCollection('symptoms');

// Helper to extract first paragraph as fallback description
function getFirstParagraph(body: string): string {
  const lines = body.split('\n');
  for (const line of lines) {
    const clean = line.trim();
    if (clean && !clean.startsWith('#') && !clean.startsWith('-') && !clean.startsWith('*')) {
      return clean.replace(/[\*\_]/g, '');
    }
  }
  return "";
}

const allSymptoms = [
  ...mdxSymptoms.map(entry => ({
    slug: entry.id,
    name: entry.data.name,
    weeks: entry.data.weeks,
    normalcy: entry.data.normalcy,
    description: getFirstParagraph(entry.body)
  })),
  ...symptomItems
].sort((a, b) => a.name.localeCompare(b.name));

const title = "Common Pregnancy Symptoms Directory: Causes & Safe Relief | PregWeeks";
const description = "Search our directory of 30+ pregnancy symptoms from early cramping and morning sickness to third trimester Braxton Hicks. Learn safe relief options.";
const url = "https://pregweeks.com/symptoms";

const schemas = [
  getMedicalPageSchema(title, description, url),
  getBreadcrumbSchema([
    { name: "Home", url: "https://pregweeks.com" },
    { name: "Symptoms Guide", url: url }
  ])
];
---

<Layout title={title} description={description} canonicalUrl={url} schemas={schemas}>
  <!-- Breadcrumbs -->
  <div class="bg-canvas border-b border-hairline py-3 px-4 transition-colors">
    <div class="max-w-[960px] mx-auto text-xs md:text-sm text-ink-muted-80 font-medium">
      <a href="/" class="text-primary hover:underline">Home</a>
      <span class="mx-2 text-hairline">/</span>
      <span class="text-ink">Symptoms Guide</span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-canvas py-12 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto text-center flex flex-col gap-3">
      <span class="text-3xl">🩺</span>
      <h1 class="font-display font-semibold text-3xl md:text-5xl text-ink tracking-apple-tight">
        Pregnancy Symptoms Directory
      </h1>
      <p class="text-sm md:text-base text-ink-muted-80 leading-relaxed max-w-xl mx-auto">
        Your body undergoes incredible changes during pregnancy. Explore clinical causes, relief strategies, and doctor advice for over 30 symptoms.
      </p>
    </div>
  </section>

  <!-- Interactive Search -->
  <section class="max-w-[960px] mx-auto px-4 mb-8">
    <div class="bg-canvas border border-hairline rounded-apple-lg p-5 transition-colors">
      <div class="relative w-full">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-ink-muted-48 pointer-events-none text-sm">
          🔍
        </span>
        <input 
          type="text" 
          id="symptom-search" 
          placeholder="Search symptoms (e.g. cramping, spotting, heartburn, sciatica)..." 
          class="w-full pl-10 pr-4 py-3 bg-canvas-parchment border border-hairline rounded-apple-sm text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm md:text-base"
        />
      </div>
    </div>
  </section>

  <!-- Symptoms Grid Directory (Parchment Surface) -->
  <section class="bg-canvas-parchment py-12 px-4 border-t border-b border-hairline transition-colors">
    <div class="max-w-[960px] mx-auto">
      <div id="symptoms-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {allSymptoms.map((symptom) => (
          <div 
            class="symptom-card bg-canvas border border-hairline p-5 md:p-6 rounded-apple-lg hover:border-primary/20 transition-all flex flex-col gap-4"
            data-name={symptom.name.toLowerCase()}
            data-desc={symptom.description.toLowerCase()}
          >
            <div class="flex justify-between items-baseline border-b border-hairline pb-2.5">
              <h2 class="font-display font-semibold text-[17px] md:text-lg text-ink tracking-apple-tight">{symptom.name}</h2>
              <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-primary/10 text-primary">
                {symptom.weeks}
              </span>
            </div>
            
            <p class="text-ink-muted-80 text-xs md:text-sm leading-relaxed line-clamp-3">
              {symptom.description}
            </p>

            <div class="mt-auto pt-3 border-t border-hairline/40 flex justify-between items-center text-xs">
              <span class={`font-bold uppercase tracking-wider text-[10px] ${
                symptom.normalcy === 'normal' ? 'text-green-600 dark:text-green-400' :
                symptom.normalcy === 'common' ? 'text-blue-600 dark:text-blue-400' :
                'text-orange-600 dark:text-orange-400'
              }`}>
                {symptom.normalcy}
              </span>
              <a href={`/symptoms/${symptom.slug}`} class="text-primary font-semibold hover:underline flex items-center gap-0.5">
                Causes & Relief Guidelines <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- No Results -->
      <div id="no-symptoms" class="text-center py-16 bg-canvas border border-hairline rounded-apple-lg transition-colors flex flex-col gap-2 items-center" style="display: none;">
        <span class="text-3xl">🩺</span>
        <h3 class="font-semibold text-lg text-ink">No symptoms found</h3>
        <p class="text-ink-muted-48 text-sm max-w-xs">Try searching for cramping, nausea, back pain, or fatigue.</p>
      </div>
    </div>
  </section>

  <!-- Medical Alert and Warnings (Light Canvas) -->
  <section class="bg-canvas py-16 px-4 transition-colors">
    <div class="max-w-[720px] mx-auto bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-900/50 p-6 rounded-apple-lg flex flex-col gap-3">
      <h3 class="font-display font-semibold text-lg text-red-800 dark:text-red-300 tracking-apple-tight flex items-center gap-2">
        <span>⚠️</span>
        <span>When to Call Your Doctor</span>
      </h3>
      <p class="text-xs md:text-sm text-ink-muted-80 leading-relaxed">
        While most symptoms are standard markers of a healthy pregnancy, certain signs require clinical evaluation immediately. Contact your obstetrician or midwife if you experience:
      </p>
      <ul class="list-disc list-inside space-y-1.5 text-xs text-ink-muted-80 pl-2">
        <li>Severe, persistent abdominal pain or sharp uterine cramping.</li>
        <li>Vaginal bleeding or a sudden gush/trickle of fluid (water breaking).</li>
        <li>Sudden, severe swelling in your hands, face, or ankles.</li>
        <li>Severe headaches, blurred vision, or seeing spots.</li>
        <li>Persistent fever of 100.4&deg;F (38&deg;C) or higher.</li>
        <li>A noticeable, sudden decrease in baby's movements after Week 28.</li>
      </ul>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('symptom-search') as HTMLInputElement;
  const cards = document.querySelectorAll('.symptom-card');
  const noSymptoms = document.getElementById('no-symptoms');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const desc = card.getAttribute('data-desc') || '';

      if (name.includes(query) || desc.includes(query)) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      noSymptoms!.style.display = 'flex';
    } else {
      noSymptoms!.style.display = 'none';
    }
  });
</script>
